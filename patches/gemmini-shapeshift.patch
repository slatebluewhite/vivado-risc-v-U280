+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * Functional test: run a REAL matmul through `ShapeshiftSkew` in every shape and
+  * compare against a golden computed at elaboration time.
+  *
+  * E427's equivalence test only showed the segmented mesh matches a reference
+  * `Mesh`; it never showed either of them computes A*B. This does.
+  *
+  * Schedule (derived in ShapeshiftSkew's header, timing checked against the PE):
+  *   cycles [T0, T0+h)      preload, prop=1, feed B rows in REVERSE (row t = B[h-1-t])
+  *   cycles [T0+h, T0+h+M)  compute, prop=0, feed A row i (all j at once; the skew staggers)
+  *   output row i appears at  T0 + h + i + h + cols   (independent of column)
+  *
+  * Rather than trusting that latency, the harness checks every candidate L in a
+  * window and reports which ones matched — a wrong derivation shows up as a
+  * different L, not as a bare failure.
+  */
+class ShapeshiftFuncSeg(shapeIdx: Int, rows: Int = 4, cols: Int = 4, M: Int = 6,
+                        sabotage: Boolean = false) extends Module {
+
+  val inputType  = SInt(8.W)
+  val outputType = SInt(20.W)
+  val accType    = SInt(32.W)
+
+  val segsSupported: Seq[Int] = (1 to rows).filter(rows % _ == 0)
+  val S = segsSupported(shapeIdx)
+  val h = rows / S
+  val T0 = 8                       // let reset settle
+  val Lmin = 0; val Lmax = 3 * rows + 3 * cols + 8
+
+  // ---- golden, computed in Scala ----
+  def aVal(s: Int, i: Int, j: Int): Int = (i + 2 * j + 3 * s) % 7 - 3
+  def bVal(s: Int, k: Int, c: Int): Int = (3 * k + c + s) % 5 - 2
+  def gold(s: Int, i: Int, c: Int): Int = (0 until h).map(j => aVal(s, i, j) * bVal(s, j, c)).sum
+
+  val io = IO(new Bundle {
+    val matched = Output(UInt((Lmax - Lmin + 1).W))  // bit L set => all rows matched at latency L
+    val done    = Output(Bool())
+  })
+
+  val dut = Module(new ShapeshiftSkew(inputType, outputType, accType, rows, cols,
+    maxSegments = rows))
+  dut.io.shape := (if (sabotage) 0 else shapeIdx).U   // sabotage: cut mask/skew for S=1
+
+  val cycle = RegInit(0.U(16.W)); cycle := cycle + 1.U
+  val preload = cycle >= T0.U && cycle < (T0 + h).U
+  val compute = cycle >= (T0 + h).U && cycle < (T0 + h + M).U
+
+  dut.io.in_prop  := preload
+  dut.io.in_valid := cycle >= T0.U
+
+  // ---- drive ----
+  for (r <- 0 until rows) {
+    val s = r / h; val j = r % h
+    // A row i is fed at cycle T0+h+i, all j simultaneously
+    val ai = (cycle - (T0 + h).U)(log2Up(M + 1) - 1, 0)
+    dut.io.in_a(r) := Mux(compute,
+      MuxLookup(ai, 0.S(8.W))((0 until M).map(i => i.U -> aVal(s, i, j).S(8.W))),
+      0.S(8.W))
+    for (c <- 0 until cols) {
+      dut.io.in_b(r)(c) := 0.S(20.W)
+      // B rows are fed in reverse at the segment TOP only
+      val dt = (cycle - T0.U)(log2Up(rows + 1) - 1, 0)
+      dut.io.in_d(r)(c) := (if (j == 0)
+        Mux(preload, MuxLookup(dt, 0.S(8.W))((0 until h).map(t => t.U -> bVal(s, h - 1 - t, c).S(8.W))), 0.S(8.W))
+      else 0.S(8.W))
+    }
+  }
+
+  // ---- check every candidate latency ----
+  val okPerL = (Lmin to Lmax).map { L =>
+    val ok = RegInit(true.B)
+    for (s <- 0 until S; i <- 0 until M) {
+      val r = s * h + h - 1                       // segment bottom row
+      when(cycle === (T0 + h + i + L).U) {
+        val bad = (0 until cols).map(c => dut.io.out(r)(c) =/= gold(s, i, c).S(20.W)).reduce(_ || _)
+        when(bad) { ok := false.B }
+      }
+    }
+    ok
+  }
+  io.matched := Cat(okPerL.reverse)
+  io.done    := cycle > (T0 + h + M + Lmax + 4).U
+}
+
+/** All three shapes at once. */
+class ShapeshiftFuncTop(sabotage: Boolean = false) extends Module {
+  val io = IO(new Bundle {
+    val m0 = Output(UInt(32.W))   // S=1
+    val m1 = Output(UInt(32.W))   // S=2
+    val m2 = Output(UInt(32.W))   // S=4
+    val done = Output(Bool())
+  })
+  val duts = (0 to 2).map(i => Module(new ShapeshiftFuncSeg(i, 4, 4, 6, sabotage)))
+  io.m0 := duts(0).io.matched
+  io.m1 := duts(1).io.matched
+  io.m2 := duts(2).io.matched
+  io.done := duts.map(_.io.done).reduce(_ && _)
+}
+
+object ShapeshiftFuncMain extends App {
+  val dir = if (args.nonEmpty) args(0) else "workspace/ss-func"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftFuncTop, Array("--target-dir", dir))
+  println(s"emitted ShapeshiftFuncTop.v into $dir")
+}
+
+/** Negative control: wrong shape programmed into the skew + cut. */
+object ShapeshiftFuncNegMain extends App {
+  val dir = if (args.nonEmpty) args(0) else "workspace/ss-func-neg"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftFuncTop(sabotage = true), Array("--target-dir", dir))
+  println(s"emitted sabotaged ShapeshiftFuncTop.v into $dir")
+}
+
+/** Standalone emission of the skew wrapper, for pricing the shape muxes. */
+object ShapeshiftSkewMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-skew"
+  val rows = if (args.length > 1) args(1).toInt else 16
+  val cols = if (args.length > 2) args(2).toInt else 16
+  val ms   = if (args.length > 3) args(3).toInt else rows
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftSkew(SInt(8.W), SInt(20.W), SInt(32.W), rows, cols, ms),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftSkew($rows x $cols, maxSeg=$ms) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftGather.scala b/src/main/scala/gemmini/ShapeshiftGather.scala
new file mode 100644
index 0000000..9f99021
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftGather.scala
@@ -0,0 +1,53 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * Accumulator-side gather: turn the per-physical-row mesh outputs into the
+  * contiguous `C*S`-wide logical row that an accumulator can write.
+  *
+  * In shape `S` the logical array is `h x (C*S)` with `h = rows/S`, and logical
+  * column `n` lives at physical `(segment s = n/C, column c = n%C)`. Segment `s`
+  * emits from physical row `s*h + h - 1` — and `h` moves with the shape, so each
+  * lane must select among the segment-bottom rows of every supported shape:
+  *
+  *     16x16, maxSeg=4:   S=1 -> row [15]      (lanes 0..15  valid)
+  *                        S=2 -> rows [7,15]   (lanes 0..31  valid)
+  *                        S=4 -> rows [3,7,11,15] (lanes 0..63 valid)
+  *
+  * THIS IS THE PRICE, NOT THE PRIZE. E428 showed the output rate rises exactly in
+  * proportion to the speedup a folded shape buys (`C*S` per cycle for an `R/h`
+  * speedup), so the accumulator has to widen by `S_max` for the folding to be
+  * realizable at all. Throttling instead would give the width back and the
+  * speedup with it. This module is the gate cost of that width; the SRAM port
+  * itself is the larger, separate cost.
+  */
+class ShapeshiftGather[T <: Data](outputType: T, val rows: Int, val cols: Int,
+                                  val maxSegments: Int) extends Module {
+
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  val maxLanes: Int = cols * segsSupported.max
+  private val shapeW = math.max(1, log2Up(segsSupported.size))
+
+  val io = IO(new Bundle {
+    val shape   = Input(UInt(shapeW.W))
+    val in      = Input(Vec(rows, Vec(cols, outputType)))
+    val out     = Output(Vec(maxLanes, outputType))     // logical columns, 0-padded
+    val n_valid = Output(UInt(log2Up(maxLanes + 1).W))  // = cols * S
+  })
+
+  for (n <- 0 until maxLanes) {
+    val s = n / cols
+    val c = n % cols
+    io.out(n) := MuxLookup(io.shape, 0.U.asTypeOf(outputType))(
+      segsSupported.zipWithIndex.map { case (segs, i) =>
+        val h = rows / segs
+        i.U -> (if (s < segs) io.in(s * h + h - 1)(c) else 0.U.asTypeOf(outputType))
+      })
+  }
+
+  io.n_valid := MuxLookup(io.shape, 0.U)(
+    segsSupported.zipWithIndex.map { case (segs, i) => i.U -> (cols * segs).U })
+}
diff --git a/src/main/scala/gemmini/ShapeshiftGemvLoop.scala b/src/main/scala/gemmini/ShapeshiftGemvLoop.scala
new file mode 100644
index 0000000..bf56976
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftGemvLoop.scala
@@ -0,0 +1,229 @@
+package gemmini
+
+import chisel3._
+import chisel3.util._
+import chisel3.experimental._
+import org.chipsalliance.cde.config.Parameters
+import GemminiISA._
+
+/** SSGemm GEMV 언롤러 (E548).
+  *
+  * E547 이 보인 것: tile-by-tile 발행에서는 GEMV 가 명령 발행에 갇혀 (tile 당
+  * preload+compute ~27 사이클 > pass 길이 4~16) 접기 이득이 1.0x 로 붕괴한다.
+  * stock 의 해법인 `loop_ws` 는 접힌 shape 의 per-segment 뱅크 배치를 모르므로,
+  * LoopMatmul 과 같은 자리(명령 사슬, reservation station 앞)에 서서 **표준
+  * PRELOAD/COMPUTE/MVOUT 을 방출하는** 전용 언롤러를 둔다 — ExecuteController 는
+  * 한 줄도 바뀌지 않는다.
+  *
+  * 소프트웨어 계약 (v1, INT8):
+  *   - `config_ex` 로 shape 를 먼저 설정한다 (rs1[12:10]). 이 언롤러의 shape 필드는
+  *     기하 계산에만 쓰이므로 둘이 일치해야 한다.
+  *   - W 는 세그먼트 배치로 scratchpad 에 미리 넣는다: tile (pp,tt) 의 세그먼트 s 는
+  *     뱅크 (1+s), 행 bBase + (pp*ch + tt)*max(h,4). (harness SSExecSeqShapes 와
+  *     동일한 규약 — E446~E480 에서 검증된 그 배치다.)
+  *   - x 는 뱅크 0 의 행 aBase + tt (tile 당 한 행, M 행씩) 에 넣는다.
+  *   - K % h == 0, N 은 임의 (마지막 tile 은 w 미만이어도 세그먼트 단위로 잘린다 —
+  *     v1 은 N % (DIM) == 0 만 요구), M <= DIM.
+  *
+  * SS_GEMV_CONFIG (funct 23):
+  *   rs1 = K[47:32] | N[31:16] | shape[10:8] | M[7:0]
+  *   rs2 = accBase[47:32] | bBase[31:16] | aBase[15:0]      (전부 행 인덱스)
+  * SS_GEMV (funct 24):
+  *   rs1 = y 의 DRAM 주소 (mvout 목적지; config_st 의 stride 사용)
+  *   rs2 = 0
+  *
+  * 방출 순서는 harness 와 동일: pp 바깥, tt 안쪽, tt > 0 이면 accumulate 비트.
+  * 그 뒤 (pp, s) 순서로 MVOUT — 세그먼트 s 의 출력은 acc 뱅크 s 에 있다 (E446).
+  */
+class ShapeshiftGemvLoop(block_size: Int, maxSeg: Int, rob_entries: Int,
+                         sp_bank_entries: Int, acc_bank_entries: Int)
+                        (implicit p: Parameters) extends Module {
+  require(isPow2(block_size) && isPow2(maxSeg),
+    "ShapeshiftGemvLoop 의 shape->S 변환(1<<shape)은 2의 거듭제곱 사다리를 전제한다")
+
+  val io = IO(new Bundle {
+    val in = Flipped(Decoupled(new GemminiCmd(rob_entries)))
+    val out = Decoupled(new GemminiCmd(rob_entries))
+    val busy = Output(Bool())
+  })
+
+  object State extends ChiselEnum { val idle, pre, comp, mvout = Value }
+  import State._
+  val state = RegInit(idle)
+
+  // SS_GEMV_CONFIG 로 래치되는 기하
+  val cfgK = Reg(UInt(16.W)); val cfgN = Reg(UInt(16.W))
+  val cfgM = Reg(UInt(8.W));  val cfgSh = Reg(UInt(3.W))
+  val aBase = Reg(UInt(16.W)); val bBase = Reg(UInt(16.W)); val accBase = Reg(UInt(16.W))
+  val yDram = Reg(UInt(64.W))
+  /** E564: 방출 중 status 를 io.in.bits 에서 조합으로 읽으면 in.valid=0 인 사이클의
+    * 쓰레기가 실린다 — STORE 의 DMA/TLB 가 잘못된 권한으로 나가는 실버그. run 시점에
+    * 래치한다. (RS 통합 하네스가 아니라 코드 감사로 발견 — mode f 전용.) */
+  val statusR = Reg(chiselTypeOf(io.in.bits.cmd.status))
+
+  private val DIM = block_size
+  val S  = (1.U(8.W) << cfgSh).asUInt                 // 세그먼트 수
+  val h  = (DIM.U >> cfgSh).asUInt                    // 접힌 높이
+  val ks = Mux(h < 4.U, 4.U, h)                       // B tile 의 행 할당 (max(h,4))
+  // nt = ceil(N / (DIM*S)), ch = K / h  (K % h == 0 전제)
+  val wCols = (DIM.U << cfgSh).asUInt
+  val nt = (cfgN + wCols - 1.U) / wCols
+  val ch = cfgK >> (log2Ceil(DIM).U - cfgSh)          // K / h = K >> log2(h)
+
+  val pp = Reg(UInt(16.W)); val tt = Reg(UInt(16.W)); val sg = Reg(UInt(8.W))
+
+  val isCfg = io.in.bits.cmd.inst.funct === SS_GEMV_CONFIG_CMD
+  val isRun = io.in.bits.cmd.inst.funct === SS_GEMV_CMD
+
+  // 기본: 통과
+  io.out.valid := io.in.valid && !isCfg && !isRun && state === idle
+  io.out.bits := io.in.bits
+  io.in.ready := (io.out.ready || isCfg || isRun) && state === idle
+  io.busy := state =/= idle
+
+  when (io.in.fire && isCfg) {
+    cfgK := io.in.bits.cmd.rs1(47, 32); cfgN := io.in.bits.cmd.rs1(31, 16)
+    cfgSh := io.in.bits.cmd.rs1(10, 8); cfgM := io.in.bits.cmd.rs1(7, 0)
+    accBase := io.in.bits.cmd.rs2(47, 32); bBase := io.in.bits.cmd.rs2(31, 16)
+    aBase := io.in.bits.cmd.rs2(15, 0)
+  }
+  /** E610: **부분 실행** — `SS_GEMV` 의 rs2 로 pp 범위를 준다 (지금까지 rs2 는 0 이었으므로
+    * 하위 호환: 0 이면 전체). 이것이 필요한 이유는 E608/E609 다: 적재와 계산은 **섞어
+    * 발행해야만** 겹치는데(4 타일 입도에서 계산의 81 % 회수), FSM 이 GEMV 전체를 한 번에
+    * 돌면 그 사이에 적재를 끼워 넣을 자리가 없다. 소프트웨어가 블록마다 부르면 된다.
+    *   rs2 = ppCount[31:16] | ppStart[15:0]   (ppCount = 0 -> 끝까지) */
+  val ppEnd = Reg(UInt(16.W)); val ppStartR = Reg(UInt(16.W))
+  when (io.in.fire && isRun) {
+    yDram := io.in.bits.cmd.rs1
+    statusR := io.in.bits.cmd.status
+    val ppStart = io.in.bits.cmd.rs2(15, 0)
+    val ppCount = io.in.bits.cmd.rs2(31, 16)
+    pp := ppStart; ppStartR := ppStart
+    ppEnd := Mux(ppCount === 0.U, nt, Mux(ppStart +& ppCount > nt, nt, ppStart + ppCount))
+    tt := 0.U; sg := 0.U
+    state := pre
+  }
+
+  // 방출 (state != idle 일 때 io.out 을 우리가 몬다)
+  val blk = pp * ch + tt
+  val bRow = (1 * sp_bank_entries).U + bBase + blk * ks
+  val aRow = aBase + tt * cfgM
+  val accRow = accBase + pp * cfgM
+  // rows/cols 필드 인코딩은 grt_preload/grt_compute (ADDR_LEN=32, +16) 와 동일
+  private def rc(rows: UInt, cols: UInt, addr: UInt): UInt =
+    (rows << 48).asUInt | (cols << 32).asUInt | addr
+
+  when (state =/= idle) {
+    io.out.valid := true.B
+    io.out.bits := DontCare
+    io.out.bits.rob_id.valid := false.B
+    io.out.bits.rob_id.bits := 0.U
+    io.out.bits.from_matmul_fsm := true.B
+    io.out.bits.from_conv_fsm := false.B
+    io.out.bits.cmd := DontCare
+    io.out.bits.cmd.status := statusR
+    io.out.bits.cmd.inst.xd := 0.U; io.out.bits.cmd.inst.xs1 := 0.U; io.out.bits.cmd.inst.xs2 := 0.U
+
+    switch (state) {
+      is (pre) {
+        io.out.bits.cmd.inst.funct := PRELOAD_CMD
+        io.out.bits.cmd.rs1 := rc(h, DIM.U, bRow)
+        val acc = Mux(tt === 0.U, (1.U(2.W) << 1).asUInt, 3.U(2.W)) // [31]=is_acc, [30]=accumulate
+        io.out.bits.cmd.rs2 := rc(cfgM, DIM.U, (acc << 30).asUInt | accRow)
+        when (io.out.fire) { state := comp }
+      }
+      is (comp) {
+        io.out.bits.cmd.inst.funct := COMPUTE_AND_FLIP_CMD
+        io.out.bits.cmd.rs1 := rc(cfgM, h, aRow)
+        io.out.bits.cmd.rs2 := "hffffffff".U(64.W)
+        when (io.out.fire) {
+          when (tt === ch - 1.U) {
+            tt := 0.U
+            /* E610: 이 호출이 맡은 범위의 끝이면 mvout 으로. pp 는 mvout 에서 다시
+             * 범위 시작부터 돌아야 하므로 되감는다. */
+            when (pp === ppEnd - 1.U) { pp := ppStartR; state := mvout }
+              .otherwise { pp := pp + 1.U; state := pre }
+          } .otherwise { tt := tt + 1.U; state := pre }
+        }
+      }
+      is (mvout) {
+        io.out.bits.cmd.inst.funct := STORE_CMD
+        // 세그먼트 s 의 출력: acc 뱅크 s, 행 accBase + pp*M. DRAM: y + (pp*w + s*DIM) (int8)
+        io.out.bits.cmd.rs1 := yDram + pp * wCols + sg * DIM.U
+        io.out.bits.cmd.rs2 := rc(cfgM, DIM.U,
+          (1.U << 31).asUInt | (sg * acc_bank_entries.U) + accRow)
+        when (io.out.fire) {
+          when (sg === S - 1.U) {
+            sg := 0.U
+            when (pp === ppEnd - 1.U) { pp := ppStartR; state := idle }
+              .otherwise { pp := pp + 1.U }
+          } .otherwise { sg := sg + 1.U }
+        }
+      }
+    }
+  }
+}
+
+object ShapeshiftGemvLoop {
+  def apply(in: DecoupledIO[GemminiCmd], block_size: Int, maxSeg: Int, rob_entries: Int,
+            sp_bank_entries: Int, acc_bank_entries: Int)
+           (implicit p: Parameters): (DecoupledIO[GemminiCmd], Bool) = {
+    val mod = Module(new ShapeshiftGemvLoop(block_size, maxSeg, rob_entries, sp_bank_entries, acc_bank_entries))
+    mod.io.in <> in
+    (mod.io.out, mod.io.busy)
+  }
+}
+
+/** E548 단위 검증: 언롤러 하나를 세워 (config, run) 두 명령을 먹이고, 방출되는
+  * 명령 스트림(funct, rs1, rs2)을 포트로 그대로 노출한다. 골든은 Python 이 같은
+  * 규약을 **독립 구현**해 만든다 — RTL 과 골든이 같이 틀리는 오류만 못 잡는다. */
+class SSGemvLoopTB(rows: Int, maxSeg: Int, spEnt: Int, accEnt: Int,
+                   kk: Int, nn: Int, mm: Int, sh: Int,
+                   aB: Int, bB: Int, accB: Int, yAddr: BigInt) extends Module {
+  import ShapeshiftExecParams.p
+  val io = IO(new Bundle {
+    val ev    = Output(Bool())
+    val funct = Output(UInt(7.W))
+    val rs1   = Output(UInt(64.W))
+    val rs2   = Output(UInt(64.W))
+    val busy  = Output(Bool())
+  })
+  val u = Module(new ShapeshiftGemvLoop(rows, maxSeg, 16, spEnt, accEnt))
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  u.io.in.valid := cyc === 2.U || cyc === 3.U
+  u.io.in.bits := DontCare
+  u.io.in.bits.cmd.inst.funct := Mux(cyc === 2.U, SS_GEMV_CONFIG_CMD, SS_GEMV_CMD)
+  u.io.in.bits.cmd.rs1 := Mux(cyc === 2.U,
+    ((BigInt(kk) << 32) | (BigInt(nn) << 16) | (BigInt(sh) << 8) | BigInt(mm)).U(64.W),
+    yAddr.U(64.W))
+  u.io.in.bits.cmd.rs2 := Mux(cyc === 2.U,
+    ((BigInt(accB) << 32) | (BigInt(bB) << 16) | BigInt(aB)).U(64.W), 0.U)
+  u.io.out.ready := true.B
+  io.ev := u.io.out.valid
+  io.funct := u.io.out.bits.cmd.inst.funct
+  io.rs1 := u.io.out.bits.cmd.rs1
+  io.rs2 := u.io.out.bits.cmd.rs2
+  io.busy := u.io.busy
+}
+
+/** E832: FSM 만의 면적을 재기 위한 단독 emit. TB 로 합성하면 K·N 이 상수라
+  * 전파로 줄어들어 실제 면적을 못 잰다 — 파라미터만 고정하고 IO 는 살린다. */
+object SSGemvLoopAreaMain extends App {
+  val dir = args(0)
+  val Seq(rows, ms, rob, spE, accE) =
+    (if (args.length > 5) args.slice(1, 6).toSeq else Seq("16","4","16","2048","1024")).map(_.toInt)
+  import ShapeshiftExecParams.p
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftGemvLoop(rows, ms, rob, spE, accE), Array("--target-dir", dir))
+  println(s"emitted ShapeshiftGemvLoop(rows=$rows maxSeg=$ms) into $dir")
+}
+
+object SSGemvLoopTBMain extends App {
+  val dir = args(0)
+  val Seq(rows, ms, spE, accE, k, n, m, sh, aB, bB, accB) = args.slice(1, 12).toSeq.map(_.toInt)
+  val y = BigInt(args(12), 16)
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new SSGemvLoopTB(rows, ms, spE, accE, k, n, m, sh, aB, bB, accB, y),
+    Array("--target-dir", dir))
+  println(s"emitted SSGemvLoopTB($rows, ms=$ms, K=$k N=$n M=$m sh=$sh) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftIsa.scala b/src/main/scala/gemmini/ShapeshiftIsa.scala
new file mode 100644
index 0000000..76c4747
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftIsa.scala
@@ -0,0 +1,247 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * ISA support for the shapeshift array.
+  *
+  * ENCODING — no new instruction is needed. `config_ex`'s `rs1` has a 6-bit hole
+  * at [15:10] (`CONFIG_EX_RS1_SPACER1_WIDTH`, between `b_transpose` at [9] and
+  * `a_stride` at [31:16]). The shape index goes in the low 3 bits of that hole:
+  *
+  *     rs1[12:10]  = shape index into `segsSupported` (0 = unsegmented)
+  *
+  * Two properties fall out of choosing a spacer rather than a new funct:
+  *   - **existing binaries keep working unchanged** — they write 0 into the
+  *     spacer, which decodes to shape 0, which is the original square array;
+  *   - it costs no opcode and no decode table entry.
+  *
+  * An out-of-range index is REJECTED (the shape register keeps its old value)
+  * and raises a sticky `bad_shape`, rather than silently aliasing — an illegal
+  * shape would mis-cut the array and corrupt results, which is exactly the kind
+  * of failure this project has learned to make loud.
+  */
+object ShapeshiftISA {
+  val SHAPE_LO = 10
+  val SHAPE_HI = 12
+  val SHAPE_WIDTH = SHAPE_HI - SHAPE_LO + 1
+  require(SHAPE_LO >= 10 && SHAPE_HI <= 15, "must stay inside CONFIG_EX_RS1_SPACER1")
+
+  /** E624: **세그먼트 뱅크 간격**. 기본(0)은 간격 1 — 세그먼트 s 가 뱅크 base+s 에 놓여
+    * 지금까지와 동일하다. 값 k 는 간격 `1<<k` 를 뜻하며, 세그먼트가 띄엄띄엄 놓여
+    * **각자 넘칠 여지**를 갖는다. E622/E623 이 찾은 용량 페널티(접힌 shape 만 분할이
+    * 필요해 큰 레이어에서 3.7 배 손해)를 없애기 위한 것이다. spacer 의 남은 비트를 쓴다. */
+  val STRIDE_LO = 13
+  val STRIDE_HI = 15
+  require(STRIDE_LO > SHAPE_HI && STRIDE_HI <= 15, "spacer 안이어야 한다")
+
+  /** rs1 value for `config_ex` that selects `shapeIdx` and leaves the rest zero */
+  def rs1(shapeIdx: Int): BigInt =
+    (BigInt(shapeIdx) << SHAPE_LO) | GemminiISA.CONFIG_EX.litValue
+  def rs1(shapeIdx: Int, strideLog: Int): BigInt =
+    (BigInt(strideLog) << STRIDE_LO) | (BigInt(shapeIdx) << SHAPE_LO) | GemminiISA.CONFIG_EX.litValue
+}
+
+/**
+  * `ShapeshiftSkew` plus the `config_ex` decoder — the smallest thing that can be
+  * called "an accelerator whose shape is program-visible".
+  */
+class ShapeshiftUnit[T <: Data : Arithmetic](inputType: T, outputType: T, accType: T,
+                                             rows: Int, cols: Int, maxSegments: Int)
+  extends Module {
+
+  val skew = Module(new ShapeshiftSkew(inputType, outputType, accType, rows, cols, maxSegments))
+  val nShapes = skew.segsSupported.size
+
+  val io = IO(new Bundle {
+    // --- RoCC-ish command port (only config_ex is decoded here) ---
+    val cmd_valid = Input(Bool())
+    val cmd_funct = Input(UInt(7.W))
+    val cmd_rs1   = Input(UInt(64.W))
+
+    // --- data path, same as ShapeshiftSkew ---
+    val in_a     = Input(Vec(rows, inputType))
+    val in_d     = Input(Vec(rows, Vec(cols, inputType)))
+    val in_b     = Input(Vec(rows, Vec(cols, outputType)))
+    val in_prop  = Input(Bool())
+    val in_valid = Input(Bool())
+    val out       = Output(Vec(rows, Vec(cols, outputType)))
+    val out_valid = Output(Vec(rows, Bool()))
+
+    // --- accumulator-side view: one contiguous logical row of C*S lanes ---
+    val wide    = Output(Vec(cols * (1 to maxSegments).filter(rows % _ == 0).max, outputType))
+    val n_valid = Output(UInt(log2Up(cols * (1 to maxSegments).filter(rows % _ == 0).max + 1).W))
+
+    // --- observability ---
+    val shape     = Output(UInt(log2Up(math.max(2, nShapes)).W))
+    val bad_shape = Output(Bool())
+  })
+
+  val is_config_ex = io.cmd_valid &&
+    io.cmd_funct === GemminiISA.CONFIG_CMD &&
+    io.cmd_rs1(1, 0) === GemminiISA.CONFIG_EX
+
+  val field = io.cmd_rs1(ShapeshiftISA.SHAPE_HI, ShapeshiftISA.SHAPE_LO)
+
+  val shape_reg = RegInit(0.U(log2Up(math.max(2, nShapes)).W))
+  val bad       = RegInit(false.B)
+  when (is_config_ex) {
+    when (field < nShapes.U) { shape_reg := field }
+      .otherwise             { bad := true.B }     // reject, keep old shape
+  }
+
+  skew.io.shape := shape_reg
+  io.shape     := shape_reg
+  io.bad_shape := bad
+
+  skew.io.in_a     := io.in_a
+  skew.io.in_d     := io.in_d
+  skew.io.in_b     := io.in_b
+  skew.io.in_prop  := io.in_prop
+  skew.io.in_valid := io.in_valid
+  io.out       := skew.io.out
+  io.out_valid := skew.io.out_valid
+
+  val gather = Module(new ShapeshiftGather(outputType, rows, cols, maxSegments))
+  gather.io.shape := shape_reg
+  gather.io.in    := skew.io.out
+  io.wide    := gather.io.out
+  io.n_valid := gather.io.n_valid
+}
+
+/**
+  * Functional test driven THROUGH THE ISA: issue `config_ex` to select a shape,
+  * then run a real matmul and compare against the Scala golden (as in E429).
+  *
+  * mode 0 = normal, 1 = never issue the config (negative control: shape stays 0),
+  * mode 2 = issue an out-of-range shape (must be rejected and flagged).
+  */
+class ShapeshiftIsaSeg(shapeIdx: Int, rows: Int = 4, cols: Int = 4, M: Int = 6, mode: Int = 0)
+  extends Module {
+
+  val inputType  = SInt(8.W); val outputType = SInt(20.W); val accType = SInt(32.W)
+  val segsSupported: Seq[Int] = (1 to rows).filter(rows % _ == 0)
+  val S = segsSupported(shapeIdx); val h = rows / S
+  val TC = 2                       // cycle at which config_ex is issued
+  val T0 = 12                      // matmul starts (well after the config)
+  val Lmax = 3 * rows + 3 * cols + 8
+
+  def aVal(s: Int, i: Int, j: Int): Int = (i + 2 * j + 3 * s) % 7 - 3
+  def bVal(s: Int, k: Int, c: Int): Int = (3 * k + c + s) % 5 - 2
+  def gold(s: Int, i: Int, c: Int): Int = (0 until h).map(j => aVal(s, i, j) * bVal(s, j, c)).sum
+
+  val maxLanes = cols * segsSupported.max
+  val io = IO(new Bundle {
+    val matched   = Output(UInt((Lmax + 1).W))
+    val matched_w = Output(UInt((Lmax + 1).W))   // same, but on the gathered wide row
+    val shape     = Output(UInt(8.W))
+    val bad_shape = Output(Bool())
+  })
+
+  val dut = Module(new ShapeshiftUnit(inputType, outputType, accType, rows, cols, rows))
+  val cycle = RegInit(0.U(16.W)); cycle := cycle + 1.U
+
+  // ---- the ISA command ----
+  val sent = if (mode == 1) 99 else if (mode == 2) segsSupported.size + 1 else shapeIdx
+  dut.io.cmd_valid := (mode != 1).B && cycle === TC.U
+  dut.io.cmd_funct := GemminiISA.CONFIG_CMD
+  dut.io.cmd_rs1   := (if (mode == 1) BigInt(0) else ShapeshiftISA.rs1(sent)).U(64.W)
+
+  // ---- the matmul (same schedule as E429) ----
+  val preload = cycle >= T0.U && cycle < (T0 + h).U
+  val compute = cycle >= (T0 + h).U && cycle < (T0 + h + M).U
+  dut.io.in_prop  := preload
+  dut.io.in_valid := cycle >= T0.U
+
+  for (r <- 0 until rows) {
+    val s = r / h; val j = r % h
+    val ai = (cycle - (T0 + h).U)(log2Up(M + 1) - 1, 0)
+    dut.io.in_a(r) := Mux(compute,
+      MuxLookup(ai, 0.S(8.W))((0 until M).map(i => i.U -> aVal(s, i, j).S(8.W))), 0.S(8.W))
+    for (c <- 0 until cols) {
+      dut.io.in_b(r)(c) := 0.S(20.W)
+      val dt = (cycle - T0.U)(log2Up(rows + 1) - 1, 0)
+      dut.io.in_d(r)(c) := (if (j == 0)
+        Mux(preload, MuxLookup(dt, 0.S(8.W))((0 until h).map(t => t.U -> bVal(s, h - 1 - t, c).S(8.W))), 0.S(8.W))
+      else 0.S(8.W))
+    }
+  }
+
+  val okPerL = (0 to Lmax).map { L =>
+    val ok = RegInit(true.B)
+    for (s <- 0 until S; i <- 0 until M) {
+      val r = s * h + h - 1
+      when(cycle === (T0 + h + i + L).U) {
+        when((0 until cols).map(c => dut.io.out(r)(c) =/= gold(s, i, c).S(20.W)).reduce(_ || _)) { ok := false.B }
+      }
+    }
+    ok
+  }
+  io.matched   := Cat(okPerL.reverse)
+
+  // E432: the same check on the gathered `C*S`-wide logical row. Lane n must hold
+  // gold(s = n/cols, i, c = n%cols) for n < cols*S, and 0 beyond that.
+  val okWide = (0 to Lmax).map { L =>
+    val ok = RegInit(true.B)
+    for (i <- 0 until M) {
+      when(cycle === (T0 + h + i + L).U) {
+        val bad = (0 until maxLanes).map { n =>
+          val s = n / cols; val c = n % cols
+          val exp = if (s < S) gold(s, i, c) else 0
+          dut.io.wide(n) =/= exp.S(20.W)
+        }.reduce(_ || _) || (dut.io.n_valid =/= (cols * S).U)
+        when(bad) { ok := false.B }
+      }
+    }
+    ok
+  }
+  io.matched_w := Cat(okWide.reverse)
+  io.shape     := dut.io.shape
+  io.bad_shape := dut.io.bad_shape
+}
+
+class ShapeshiftIsaTop(mode: Int = 0) extends Module {
+  val io = IO(new Bundle {
+    val m0 = Output(UInt(32.W)); val m1 = Output(UInt(32.W)); val m2 = Output(UInt(32.W))
+    val w0 = Output(UInt(32.W)); val w1 = Output(UInt(32.W)); val w2 = Output(UInt(32.W))
+    val shapes = Output(UInt(24.W))
+    val bad    = Output(UInt(3.W))
+  })
+  val duts = (0 to 2).map(i => Module(new ShapeshiftIsaSeg(i, 4, 4, 6, mode)))
+  io.m0 := duts(0).io.matched; io.m1 := duts(1).io.matched; io.m2 := duts(2).io.matched
+  io.w0 := duts(0).io.matched_w; io.w1 := duts(1).io.matched_w; io.w2 := duts(2).io.matched_w
+  io.shapes := Cat(duts.map(_.io.shape).reverse)
+  io.bad    := Cat(duts.map(_.io.bad_shape).reverse)
+}
+
+object ShapeshiftIsaMain extends App {
+  val dir = if (args.nonEmpty) args(0) else "workspace/ss-isa"
+  val mode = if (args.length > 1) args(1).toInt else 0
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftIsaTop(mode), Array("--target-dir", dir))
+  println(s"emitted ShapeshiftIsaTop(mode=$mode) into $dir")
+}
+
+/** Standalone emission of the ISA-visible unit, for pricing the decoder. */
+object ShapeshiftUnitMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-unit"
+  val rows = if (args.length > 1) args(1).toInt else 16
+  val cols = if (args.length > 2) args(2).toInt else 16
+  val ms   = if (args.length > 3) args(3).toInt else rows
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftUnit(SInt(8.W), SInt(20.W), SInt(32.W), rows, cols, ms),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftUnit($rows x $cols, maxSeg=$ms) into $dir")
+}
+
+/** Standalone emission of the gather, for pricing it on its own. */
+object ShapeshiftGatherMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-gather"
+  val rows = if (args.length > 1) args(1).toInt else 16
+  val cols = if (args.length > 2) args(2).toInt else 16
+  val ms   = if (args.length > 3) args(3).toInt else 4
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftGather(SInt(20.W), rows, cols, ms), Array("--target-dir", dir))
+  println(s"emitted ShapeshiftGather($rows x $cols, maxSeg=$ms) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftMWDEquiv.scala b/src/main/scala/gemmini/ShapeshiftMWDEquiv.scala
new file mode 100644
index 0000000..9c74fe7
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftMWDEquiv.scala
@@ -0,0 +1,334 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+import chisel3.util.random.LFSR
+
+/** A minimal tag so the harness does not depend on `ExecuteController`'s. */
+class SSTag extends Bundle with TagQueueTag {
+  val x = UInt(8.W)
+  override def make_this_garbage(dummy: Int = 0): Unit = { x := 255.U }
+}
+
+/**
+  * THE SAFETY GATE for touching `ExecuteController`.
+  *
+  * Drives the unmodified `MeshWithDelays` and `ShapeshiftMeshWithDelays(shape=0)`
+  * with bit-identical stimulus through the FULL protocol — `req` with tags and
+  * flushes, `a`/`b`/`d` handshakes, `resp` with tag and `total_rows` — and asserts
+  * they agree on every output, every cycle, including the `ready` back-pressure.
+  *
+  * E429 compared the bare mesh. That is not enough to justify a swap: the skew
+  * network, the tag queue, the fire counter and the output de-skew all live in
+  * this module, and any of them could be perturbed by the mesh's changed port
+  * shape without the mesh itself being wrong.
+  *
+  * `sabotage` drives shape = 1 instead, which must make it FAIL — otherwise the
+  * comparison proves nothing.
+  */
+class ShapeshiftMWDEquiv(rows: Int = 4, cols: Int = 4, maxSeg: Int = 4,
+                         sabotage: Boolean = false) extends Module {
+  val io = IO(new Bundle {
+    val mismatch = Output(Bool())
+    val cmp      = Output(UInt(16.W))   // cycles compared while a response was valid
+    val nonzero  = Output(Bool())       // proof the comparison was not vacuous
+    val fires    = Output(UInt(16.W))   // req handshakes observed
+    val which    = Output(UInt(4.W))    // 진단: 어느 항이 어긋났나 (ready/valid/bits/tags)
+  })
+
+  val inputType = SInt(8.W); val outputType = SInt(20.W); val accType = SInt(32.W)
+  val TL = 1; val OD = 0
+
+  val ref = Module(new MeshWithDelays(inputType, outputType, accType, new SSTag,
+    Dataflow.WS, false, TL, OD, 1, 1, rows, cols, 1, 1, 1))
+  val dut = Module(new ShapeshiftMeshWithDelays(inputType, outputType, accType, new SSTag,
+    Dataflow.WS, false, TL, OD, 1, 1, rows, cols, 1, 1, 1, -1, maxSeg))
+
+  dut.io.shape := (if (sabotage) 1 else 0).U
+
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val go  = cyc > 4.U
+
+  def rnd(n: Int, k: Int): UInt = LFSR(64, go, Some(BigInt(k * 7919 + 13)))(n - 1, 0)
+
+  // ---- identical stimulus into both, lane by lane ----
+  // The two modules no longer have the same IO type (the drop-in's b/d/resp are
+  // `cols*S_max` wide), so they are driven field by field rather than through a
+  // shared reference. Lanes at or beyond `cols` get DIFFERENT random data on the
+  // wide side: at shape 0 they must be ignored, so this doubles as a check that
+  // the scatter/gather really do ignore them.
+  val aV = go && rnd(3, 101) =/= 0.U      // occasionally stall, to exercise back-pressure
+  val bV = go && rnd(3, 202) =/= 0.U
+  val dV = go && rnd(3, 303) =/= 0.U
+  val rV = go && rnd(4, 700) === 0.U
+  val prop = rnd(1, 800)
+  val tg   = rnd(8, 900)
+
+  ref.io.a.valid := aV; dut.io.a.valid := aV
+  ref.io.b.valid := bV; dut.io.b.valid := bV
+  ref.io.d.valid := dV; dut.io.d.valid := dV
+  for (r <- 0 until rows) {
+    val v = rnd(8, 400 + r).asSInt
+    ref.io.a.bits(r)(0) := v; dut.io.a.bits(r)(0) := v
+  }
+  for (c <- 0 until cols) {
+    val vb = rnd(8, 500 + c).asSInt; val vd = rnd(8, 600 + c).asSInt
+    ref.io.b.bits(c)(0) := vb; dut.io.b.bits(c)(0) := vb
+    ref.io.d.bits(c)(0) := vd; dut.io.d.bits(c)(0) := vd
+  }
+  for (n <- cols until dut.maxLanes) {          // wide lanes: deliberately different
+    dut.io.b.bits(n)(0) := rnd(8, 1500 + n).asSInt
+    dut.io.d.bits(n)(0) := rnd(8, 1600 + n).asSInt
+  }
+
+  for (q <- Seq(ref.io.req, dut.io.req)) {
+    q.valid := rV
+    q.bits.pe_control.dataflow  := Dataflow.WS.id.U
+    q.bits.pe_control.propagate := prop
+    q.bits.pe_control.shift     := 0.U
+    q.bits.a_transpose  := false.B
+    q.bits.bd_transpose := false.B
+    q.bits.total_rows   := rows.U
+    q.bits.tag.x        := tg
+    q.bits.flush        := 0.U
+  }
+
+  // ---- compare EVERYTHING the module exposes ----
+  val sameReady = ref.io.a.ready === dut.io.a.ready && ref.io.b.ready === dut.io.b.ready &&
+                  ref.io.d.ready === dut.io.d.ready && ref.io.req.ready === dut.io.req.ready
+  val sameValid = ref.io.resp.valid === dut.io.resp.valid
+  val sameBits  = (0 until cols).map(c => ref.io.resp.bits.data(c)(0) === dut.io.resp.bits.data(c)(0)).reduce(_ && _) &&
+                  ref.io.resp.bits.last === dut.io.resp.bits.last &&
+                  ref.io.resp.bits.total_rows === dut.io.resp.bits.total_rows &&
+                  ref.io.resp.bits.tag.x === dut.io.resp.bits.tag.x
+  val sameTags  = (0 until ref.io.tags_in_progress.length)
+                    .map(i => ref.io.tags_in_progress(i).x === dut.io.tags_in_progress(i).x).reduce(_ && _)
+
+  // Compare only after the pipelines have filled: `Shifter`/`ShiftRegister` and the
+  // PE weight registers carry no reset (that is what infers SRLs), so they read as
+  // X in simulation until real data has flowed through. Xilinx FFs actually power
+  // up to 0, so this is a simulation artifact, not a design one — but xsim has no
+  // -initvalue, so the harness warms up instead.
+  val warm = cyc > 200.U
+  val b0 = RegInit(false.B); val b1 = RegInit(false.B)
+  val b2 = RegInit(false.B); val b3 = RegInit(false.B)
+  when (warm && !sameReady) { b0 := true.B }
+  when (warm && !sameValid) { b1 := true.B }
+  when (warm && ref.io.resp.valid && !sameBits) { b2 := true.B }
+  when (warm && !sameTags)  { b3 := true.B }
+  val bad = b0 || b1 || b2 || b3
+
+  val cmp = RegInit(0.U(16.W))
+  when (cyc > 200.U && ref.io.resp.valid) { cmp := cmp + 1.U }
+  val nz = RegInit(false.B)
+  when (cyc > 200.U && ref.io.resp.valid &&
+        (0 until cols).map(c => ref.io.resp.bits.data(c)(0) =/= 0.S).reduce(_ || _)) { nz := true.B }
+  val fires = RegInit(0.U(16.W))
+  when (ref.io.req.fire) { fires := fires + 1.U }
+
+  io.mismatch := bad; io.cmp := cmp; io.nonzero := nz; io.fires := fires
+  io.which := Cat(b3, b2, b1, b0)
+}
+
+class ShapeshiftMWDEquivTop(rows: Int = 4, cols: Int = 4, maxSeg: Int = 4,
+                            sabotage: Boolean = false) extends Module {
+  val io = IO(new Bundle {
+    val mismatch = Output(Bool()); val cmp = Output(UInt(16.W))
+    val nonzero  = Output(Bool()); val fires = Output(UInt(16.W))
+    val which    = Output(UInt(4.W))
+  })
+  val d = Module(new ShapeshiftMWDEquiv(rows, cols, maxSeg, sabotage))
+  io.mismatch := d.io.mismatch; io.cmp := d.io.cmp
+  io.nonzero := d.io.nonzero;   io.fires := d.io.fires; io.which := d.io.which
+}
+
+object ShapeshiftMWDEquivMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-mwd"
+  val r   = if (args.length > 1) args(1).toInt else 4
+  val c   = if (args.length > 2) args(2).toInt else 4
+  val ms  = if (args.length > 3) args(3).toInt else 4
+  val sab = args.length > 4 && args(4) == "sabotage"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftMWDEquivTop(r, c, ms, sab),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftMWDEquivTop($r x $c, maxSeg=$ms, sabotage=$sab) into $dir")
+}
+
+/** Area harness: emits the stock module or the drop-in, so the swap can be priced.
+  * The question that decides whether the swap can be UNCONDITIONAL is whether
+  * `maxSegments = 1` costs anything — by construction `ShapeshiftMesh` reduces to
+  * `Mesh` plus dead ports there, but "should optimize away" is a claim, not a
+  * measurement (E431 learned this the hard way). */
+class MWDArea(rows: Int, cols: Int, maxSeg: Int, stock: Boolean) extends Module {
+  val inputType = SInt(8.W); val outputType = SInt(20.W); val accType = SInt(32.W)
+  // lanes = cols for stock and for maxSeg = 1, so the stock wrapper's port count
+  // is unchanged and the three numbers stay comparable.
+  val lanes = if (stock) cols else cols * (1 to maxSeg).filter(rows % _ == 0).max
+  val io = IO(new Bundle {
+    val a = Flipped(Decoupled(Vec(rows, Vec(1, inputType))))
+    val b = Flipped(Decoupled(Vec(lanes, Vec(1, inputType))))
+    val d = Flipped(Decoupled(Vec(lanes, Vec(1, inputType))))
+    val req = Flipped(Decoupled(new MeshWithDelaysReq(accType, new SSTag, rows)))
+    val resp = Valid(new ShapeshiftMWDResp(outputType, lanes, 1, rows, new SSTag))
+    val tags_in_progress = Output(Vec(11, new SSTag))
+    val shape = Input(UInt(4.W))
+  })
+  if (stock) {
+    val m = Module(new MeshWithDelays(inputType, outputType, accType, new SSTag,
+      Dataflow.WS, false, 1, 0, 1, 1, rows, cols, 1, 1, 1))
+    m.io.a <> io.a; m.io.req <> io.req
+    m.io.b.valid := io.b.valid; m.io.d.valid := io.d.valid
+    io.b.ready := m.io.b.ready; io.d.ready := m.io.d.ready
+    for (c <- 0 until cols) { m.io.b.bits(c) := io.b.bits(c); m.io.d.bits(c) := io.d.bits(c) }
+    io.resp.valid := m.io.resp.valid
+    io.resp.bits.last := m.io.resp.bits.last
+    io.resp.bits.tag := m.io.resp.bits.tag
+    io.resp.bits.total_rows := m.io.resp.bits.total_rows
+    for (c <- 0 until cols) io.resp.bits.data(c) := m.io.resp.bits.data(c)
+    io.tags_in_progress := m.io.tags_in_progress.take(11)
+  } else {
+    val m = Module(new ShapeshiftMeshWithDelays(inputType, outputType, accType, new SSTag,
+      Dataflow.WS, false, 1, 0, 1, 1, rows, cols, 1, 1, 1, -1, maxSeg))
+    m.io.a <> io.a; m.io.b <> io.b; m.io.d <> io.d; m.io.req <> io.req
+    m.io.shape := io.shape
+    io.resp := m.io.resp
+    io.tags_in_progress := m.io.tags_in_progress.take(11)
+  }
+}
+
+object ShapeshiftMWDAreaMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/mwd-area"
+  val r   = if (args.length > 1) args(1).toInt else 16
+  val c   = if (args.length > 2) args(2).toInt else 16
+  val ms  = if (args.length > 3) args(3).toInt else 4
+  val st  = args.length > 4 && args(4) == "stock"
+  (new chisel3.stage.ChiselStage).emitVerilog(new MWDArea(r, c, ms, st), Array("--target-dir", dir))
+  println(s"emitted MWDArea($r x $c, maxSeg=$ms, stock=$st) into $dir")
+}
+
+/**
+  * THE FOLDED-PATH CHECK: one `ShapeshiftMeshWithDelays(rows, cols)` cut into `S`
+  * against `S` unmodified `MeshWithDelays(rows/S, cols)`, through the full
+  * protocol, with the wide response compared segment by segment.
+  *
+  * E442 only proved the folded module leaves the UNFOLDED path alone. This is the
+  * other half: at shape `S` it must behave like `S` independent stock accelerators
+  * of `h = rows/S` rows each. Comparing against the stock module rather than a
+  * hand-computed golden means no knowledge of the correct skew, latency or tag
+  * timing is needed — both sides see the same arbitrary stimulus and must agree.
+  *
+  * Physical row `r` is LOGICAL row `r % h`, so every segment sees the same
+  * activation rows; the harness replicates them, which is what a real driver does.
+  *
+  * `sabotage` leaves the DUT at shape 0 while the references are cut into `S`,
+  * which must FAIL for S > 1 (and legitimately passes at S = 1).
+  */
+class ShapeshiftMWDSeg(shapeIdx: Int, rows: Int = 8, cols: Int = 4, maxSeg: Int = 4,
+                       sabotage: Boolean = false) extends Module {
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val S = segs(shapeIdx); val h = rows / S
+
+  val io = IO(new Bundle {
+    val mismatch = Output(Bool()); val cmp = Output(UInt(16.W))
+    val nonzero  = Output(Bool()); val which = Output(UInt(4.W))
+  })
+
+  val inputType = SInt(8.W); val outputType = SInt(20.W); val accType = SInt(32.W)
+  val TL = 1; val OD = 0
+
+  val dut = Module(new ShapeshiftMeshWithDelays(inputType, outputType, accType, new SSTag,
+    Dataflow.WS, false, TL, OD, 1, 1, rows, cols, 1, 1, 1, -1, maxSeg))
+  dut.io.shape := (if (sabotage) 0 else shapeIdx).U
+
+  val refs = Seq.fill(S)(Module(new MeshWithDelays(inputType, outputType, accType, new SSTag,
+    Dataflow.WS, false, TL, OD, 1, 1, h, cols, 1, 1, 1)))
+
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val go  = cyc > 4.U
+  def rnd(n: Int, k: Int): UInt = LFSR(64, go, Some(BigInt(k * 7919 + 13)))(n - 1, 0)
+
+  val aV = go && rnd(3, 101) =/= 0.U
+  val bV = go && rnd(3, 202) =/= 0.U
+  val dV = go && rnd(3, 303) =/= 0.U
+  val rV = go && rnd(4, 700) === 0.U
+  val prop = rnd(1, 800); val tg = rnd(8, 900)
+
+  // logical activation row j, replicated to every physical row of every segment
+  val aLog = (0 until h).map(j => rnd(8, 400 + j).asSInt)
+  dut.io.a.valid := aV; dut.io.b.valid := bV; dut.io.d.valid := dV
+  for (r <- 0 until rows) dut.io.a.bits(r)(0) := aLog(r % h)
+  for (s <- 0 until S; c <- 0 until cols) {
+    dut.io.b.bits(s * cols + c)(0) := rnd(8, 500 + s * cols + c).asSInt
+    dut.io.d.bits(s * cols + c)(0) := rnd(8, 600 + s * cols + c).asSInt
+  }
+  for (n <- S * cols until dut.maxLanes) {     // lanes past this shape: must be ignored
+    dut.io.b.bits(n)(0) := rnd(8, 1500 + n).asSInt
+    dut.io.d.bits(n)(0) := rnd(8, 1600 + n).asSInt
+  }
+
+  refs.zipWithIndex.foreach { case (rf, s) =>
+    rf.io.a.valid := aV; rf.io.b.valid := bV; rf.io.d.valid := dV
+    for (j <- 0 until h) rf.io.a.bits(j)(0) := aLog(j)
+    for (c <- 0 until cols) {
+      rf.io.b.bits(c)(0) := rnd(8, 500 + s * cols + c).asSInt
+      rf.io.d.bits(c)(0) := rnd(8, 600 + s * cols + c).asSInt
+    }
+  }
+
+  (Seq(dut.io.req) ++ refs.map(_.io.req)).foreach { q =>
+    q.valid := rV
+    q.bits.pe_control.dataflow  := Dataflow.WS.id.U
+    q.bits.pe_control.propagate := prop
+    q.bits.pe_control.shift     := 0.U
+    q.bits.a_transpose := false.B; q.bits.bd_transpose := false.B
+    q.bits.total_rows  := h.U
+    q.bits.tag.x := tg; q.bits.flush := 0.U
+  }
+
+  val warm = cyc > 200.U
+  val b0 = RegInit(false.B); val b1 = RegInit(false.B)
+  val b2 = RegInit(false.B); val b3 = RegInit(false.B)
+  refs.zipWithIndex.foreach { case (rf, s) =>
+    when (warm && rf.io.a.ready =/= dut.io.a.ready) { b0 := true.B }
+    when (warm && rf.io.resp.valid =/= dut.io.resp.valid) { b1 := true.B }
+    when (warm && rf.io.resp.valid &&
+      (0 until cols).map(c => rf.io.resp.bits.data(c)(0) =/= dut.io.resp.bits.data(s * cols + c)(0))
+        .reduce(_ || _)) { b2 := true.B }
+    when (warm && rf.io.resp.valid &&
+      (rf.io.resp.bits.last =/= dut.io.resp.bits.last ||
+       rf.io.resp.bits.tag.x =/= dut.io.resp.bits.tag.x)) { b3 := true.B }
+  }
+
+  val cmp = RegInit(0.U(16.W)); when (warm && refs.head.io.resp.valid) { cmp := cmp + 1.U }
+  val nz = RegInit(false.B)
+  when (warm && refs.head.io.resp.valid &&
+    refs.flatMap(rf => (0 until cols).map(c => rf.io.resp.bits.data(c)(0) =/= 0.S)).reduce(_ || _)) { nz := true.B }
+
+  io.mismatch := b0 || b1 || b2 || b3
+  io.which := Cat(b3, b2, b1, b0); io.cmp := cmp; io.nonzero := nz
+}
+
+class ShapeshiftMWDSegTop(rows: Int = 8, cols: Int = 4, maxSeg: Int = 4,
+                          sabotage: Boolean = false) extends Module {
+  val nShapes = (1 to maxSeg).filter(rows % _ == 0).size
+  val io = IO(new Bundle {
+    val mismatch = Output(UInt(nShapes.W)); val cmp = Output(UInt(48.W))
+    val nonzero  = Output(UInt(nShapes.W)); val which = Output(UInt(16.W))
+  })
+  val d = (0 until nShapes).map(i => Module(new ShapeshiftMWDSeg(i, rows, cols, maxSeg, sabotage)))
+  io.mismatch := Cat(d.map(_.io.mismatch).reverse)
+  io.nonzero  := Cat(d.map(_.io.nonzero).reverse)
+  io.cmp      := Cat(d.map(_.io.cmp).reverse)
+  io.which    := Cat(d.map(_.io.which).reverse)
+}
+
+object ShapeshiftMWDSegMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-mwdseg"
+  val r   = if (args.length > 1) args(1).toInt else 8
+  val c   = if (args.length > 2) args(2).toInt else 4
+  val ms  = if (args.length > 3) args(3).toInt else 4
+  val sab = args.length > 4 && args(4) == "sabotage"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftMWDSegTop(r, c, ms, sab),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftMWDSegTop($r x $c, maxSeg=$ms, sabotage=$sab) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftMesh.scala b/src/main/scala/gemmini/ShapeshiftMesh.scala
new file mode 100644
index 0000000..b50e89a
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftMesh.scala
@@ -0,0 +1,183 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * ShapeshiftMesh — a Mesh whose *vertical* (reduction) chains can be cut at
+  * runtime, so that one physical `meshRows x meshColumns` array behaves as `S`
+  * independent `(meshRows/S) x meshColumns` arrays — i.e. logically
+  * `(meshRows/S) x (meshColumns*S)`.
+  *
+  * Why the vertical direction: in Gemmini's weight-stationary dataflow `a`
+  * travels west->east (one stream per row, so **rows are the K / reduction
+  * axis**) while `b` accumulates north->south and `d`/`c` carry the weight
+  * preload chain (so **columns are the N / output axis**). Cutting a vertical
+  * chain therefore splits the reduction depth and multiplies the number of
+  * independent output columns, at constant PE count:
+  *
+  *     4x4  -> K-depth 4, 4 outputs      (S=1, cut = T F F F)
+  *     2x8  -> K-depth 2, 8 outputs      (S=2, cut = T F T F)
+  *     1x16 -> K-depth 1, 16 outputs     (S=4, cut = T T T T)
+  *
+  * The structural change over `Mesh` is small and entirely local:
+  *
+  *   1. every vertical-chain input (`in_b`, `in_d`, `in_control`, `in_id`,
+  *      `in_last`, `in_valid`) becomes **per physical row**, because any row
+  *      may now be the top of a segment;
+  *   2. at each row a 2:1 mux selects between the chained value from the row
+  *      above and that row's fresh external input, under `io.cut(r)`;
+  *   3. every row exposes its outputs, because any row may now be the bottom
+  *      of a segment.
+  *
+  * The mux sits *in front of* the existing inter-row pipeline register, so it
+  * costs one mux level of combinational delay on the PE->register path and
+  * nothing on the register->PE path.
+  *
+  * With `io.cut = T F F F` this module is cycle-for-cycle identical to
+  * `Mesh` (see `ShapeshiftEquiv`); the extra per-row ports are then simply
+  * unused.
+  *
+  * NOT handled here, by design: `io.cut` must only change while the array is
+  * drained, and the *skew* network that feeds a segmented array differs from
+  * the unsegmented one (segment `s`'s row `j` needs the delay of row `j`, not
+  * of row `s*h+j`). That lives in `MeshWithDelays`, not in the mesh.
+  */
+class ShapeshiftMesh[T <: Data : Arithmetic](inputType: T, outputType: T, accType: T,
+                                   df: Dataflow.Value, tree_reduction: Boolean, tile_latency: Int,
+                                   max_simultaneous_matmuls: Int, output_delay: Int,
+                                   val tileRows: Int, val tileColumns: Int,
+                                   val meshRows: Int, val meshColumns: Int,
+                                   val maxSegments: Int = 0) extends Module {
+
+  private val idW = log2Up(max_simultaneous_matmuls)
+
+  /** Which segmentations this instance must support: all S <= maxSegments that
+    * divide meshRows. maxSegments = 0 means "all divisors" (fully general). */
+  private val segsSupported: Seq[Int] =
+    (1 to (if (maxSegments <= 0) meshRows else maxSegments)).filter(meshRows % _ == 0)
+
+  /** A row needs its own external vertical inputs only if some supported S makes
+    * it a segment TOP, and its own outputs only if some S makes it a segment
+    * BOTTOM. For maxSegments = 1 this reduces to {row 0} / {last row}, i.e. to
+    * plain `Mesh` plus dead ports. */
+  private val topRows: Set[Int] =
+    segsSupported.flatMap(s => (0 until meshRows).filter(_ % (meshRows / s) == 0)).toSet
+  private val botRows: Set[Int] =
+    segsSupported.flatMap(s => (0 until meshRows).filter(r => (r + 1) % (meshRows / s) == 0)).toSet
+
+  val io = IO(new Bundle {
+    /** cut(r) = "row r starts a new segment". cut(0) is forced true. */
+    val cut = Input(Vec(meshRows, Bool()))
+
+    val in_a = Input(Vec(meshRows, Vec(tileRows, inputType)))
+
+    // Vertical-chain inputs: one set per physical row (was: one set total).
+    // NOTE: `Mesh` declares these as `inputType` and relies on `:=` sign-extending
+    // into the Tile's `outputType` port. A `Mux` needs equivalent types, so here
+    // they are declared at their true width. Sign-extending before vs. after the
+    // inter-row register is equivalent, so this does not change behaviour.
+    val in_b       = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, outputType))))
+    val in_d       = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, outputType))))
+    val in_control = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, new PEControl(accType)))))
+    val in_id      = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, UInt(idW.W)))))
+    val in_last    = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, Bool()))))
+    val in_valid   = Input(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, Bool()))))
+
+    // Vertical outputs: one set per physical row (was: bottom row only).
+    val out_b       = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, outputType))))
+    val out_c       = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, outputType))))
+    val out_control = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, new PEControl(accType)))))
+    val out_id      = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, UInt(idW.W)))))
+    val out_last    = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, Bool()))))
+    val out_valid   = Output(Vec(meshRows, Vec(meshColumns, Vec(tileColumns, Bool()))))
+  })
+
+  val mesh: Seq[Seq[Tile[T]]] = Seq.fill(meshRows, meshColumns)(
+    Module(new Tile(inputType, outputType, accType, df, tree_reduction, max_simultaneous_matmuls, tileRows, tileColumns)))
+
+  def pipe[TT <: Data](valid: Bool, t: TT, latency: Int): TT = {
+    // Same helper as Mesh: avoid the global reset that the default Pipe applies.
+    chisel3.withReset(false.B) { Pipe(valid, t, latency).bits }
+  }
+
+  // Row 0 is always the top of a segment.
+  val cut = VecInit(Seq.tabulate(meshRows)(r => if (r == 0) true.B else io.cut(r)))
+
+  // ---- horizontal chain (activations) : unchanged from Mesh ----
+  for (r <- 0 until meshRows) {
+    mesh(r).foldLeft(io.in_a(r)) {
+      case (in_a, tile) =>
+        tile.io.in_a := ShiftRegister(in_a, tile_latency + 1)
+        tile.io.out_a
+    }
+  }
+
+  // ---- vertical chains : cuttable ----
+  assert(!(mesh.map(_.map(_.io.bad_dataflow).reduce(_ || _)).reduce(_ || _)))
+
+  for (c <- 0 until meshColumns) {
+    for (r <- 0 until meshRows) {
+      val tile = mesh(r)(c)
+
+      // Source for this row: external input if this row starts a segment,
+      // otherwise the value chained down from the row above.
+      def sel[TT <: Data](ext: TT, up: => TT): TT =
+        if (r == 0) ext
+        else if (!topRows.contains(r)) up      // this row can never start a segment
+        else Mux(cut(r), ext, up)
+
+      val src_valid = sel(io.in_valid(r)(c), mesh(r - 1)(c).io.out_valid)
+      val src_b     = sel(io.in_b(r)(c),     mesh(r - 1)(c).io.out_b)
+      val src_d     = sel(io.in_d(r)(c),     mesh(r - 1)(c).io.out_c)
+      val src_id    = sel(io.in_id(r)(c),    mesh(r - 1)(c).io.out_id)
+      val src_last  = sel(io.in_last(r)(c),  mesh(r - 1)(c).io.out_last)
+      val src_ctrl  = sel(io.in_control(r)(c), mesh(r - 1)(c).io.out_control)
+
+      // The pipeline registers are kept exactly where Mesh had them, so that
+      // an uncut chain is cycle-identical to Mesh.
+      tile.io.in_valid := ShiftRegister(src_valid, tile_latency + 1)
+      tile.io.in_b     := pipe(src_valid.head, src_b, tile_latency + 1)
+      tile.io.in_d     := pipe(src_valid.head, src_d, tile_latency + 1)
+      tile.io.in_id    := ShiftRegister(src_id, tile_latency + 1)
+      tile.io.in_last  := ShiftRegister(src_last, tile_latency + 1)
+      (tile.io.in_control, src_ctrl, src_valid).zipped.foreach {
+        case (tile_ctrl, ctrl, v) =>
+          tile_ctrl.shift     := pipe(v, ctrl.shift, tile_latency + 1)
+          tile_ctrl.dataflow  := pipe(v, ctrl.dataflow, tile_latency + 1)
+          tile_ctrl.propagate := pipe(v, ctrl.propagate, tile_latency + 1)
+      }
+    }
+  }
+
+  // ---- outputs : every row that can be a segment bottom ----
+  // This is where the real area goes: each exposed row costs a full set of
+  // output registers, i.e. the accumulator write bandwidth the shape demands.
+  for (r <- 0 until meshRows; c <- 0 until meshColumns) {
+    if (botRows.contains(r)) {
+      io.out_b(r)(c)       := ShiftRegister(mesh(r)(c).io.out_b, output_delay)
+      io.out_c(r)(c)       := ShiftRegister(mesh(r)(c).io.out_c, output_delay)
+      io.out_valid(r)(c)   := ShiftRegister(mesh(r)(c).io.out_valid, output_delay)
+      io.out_control(r)(c) := ShiftRegister(mesh(r)(c).io.out_control, output_delay)
+      io.out_id(r)(c)      := ShiftRegister(mesh(r)(c).io.out_id, output_delay)
+      io.out_last(r)(c)    := ShiftRegister(mesh(r)(c).io.out_last, output_delay)
+    } else {
+      io.out_b(r)(c)       := 0.U.asTypeOf(chiselTypeOf(io.out_b(r)(c)))
+      io.out_c(r)(c)       := 0.U.asTypeOf(chiselTypeOf(io.out_c(r)(c)))
+      io.out_valid(r)(c)   := 0.U.asTypeOf(chiselTypeOf(io.out_valid(r)(c)))
+      io.out_control(r)(c) := 0.U.asTypeOf(chiselTypeOf(io.out_control(r)(c)))
+      io.out_id(r)(c)      := 0.U.asTypeOf(chiselTypeOf(io.out_id(r)(c)))
+      io.out_last(r)(c)    := 0.U.asTypeOf(chiselTypeOf(io.out_last(r)(c)))
+    }
+  }
+}
+
+object ShapeshiftMesh {
+  /** cut mask for `S` equal segments of a `meshRows`-row array. */
+  def cutMask(meshRows: Int, segments: Int): Seq[Boolean] = {
+    require(meshRows % segments == 0, s"$meshRows rows do not split into $segments segments")
+    val h = meshRows / segments
+    Seq.tabulate(meshRows)(r => r % h == 0)
+  }
+}
diff --git a/src/main/scala/gemmini/ShapeshiftMeshWithDelays.scala b/src/main/scala/gemmini/ShapeshiftMeshWithDelays.scala
new file mode 100644
index 0000000..d7314c7
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftMeshWithDelays.scala
@@ -0,0 +1,405 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+import gemmini.Util._
+
+/**
+  * Drop-in replacement for `MeshWithDelays` whose inner array is a
+  * `ShapeshiftMesh`, plus a `shape` input.
+  *
+  * WHY THIS EXISTS. Everything through E441 is a standalone datapath with its own
+  * sequencer. To run from the stock Gemmini command stream, `ExecuteController`'s
+  * `MeshWithDelays` has to become shape-aware — and that is the first edit in this
+  * whole track that touches existing RTL. The gate before making it is:
+  *
+  *   **at shape 0, is this bit-identical to the stock module?**
+  *
+  * If yes, swapping it in cannot perturb any existing workload, and the folded
+  * shapes are purely additive. That is what `ShapeshiftMWDEquiv` checks, cycle by
+  * cycle, against the unmodified `MeshWithDelays` under the full req/a/b/d/flush
+  * protocol — not just the mesh in isolation, which is all E429 checked.
+  *
+  * SCOPE OF THIS STEP. The IO is still `meshColumns` wide. A folded shape needs
+  * `meshColumns * S` columns (E432's gather, E441's +10.9% wide port), and
+  * widening it changes `ExecuteController`, the scratchpad and the accumulator
+  * too. That is the NEXT step and is deliberately not mixed into this one: here
+  * the only claim is that the mesh swap and the segment-aware `a` skew leave the
+  * existing path alone. At shape != 0 this module currently returns segment 0's
+  * columns only, which is correct but buys nothing — the width is the prize.
+  */
+/** Like `MeshWithDelaysResp` but `lanes` wide instead of `meshColumns` wide.
+  * A folded shape emits `meshColumns * S` logical columns per cycle — that width
+  * IS the speedup (E428), so throttling it back to `meshColumns` would hand the
+  * whole thing away. Defined here rather than by editing the stock bundle. */
+class ShapeshiftMWDResp[T <: Data, TagT <: TagQueueTag with Data](outType: T, lanes: Int,
+    tileCols: Int, block_size: Int, tagType: TagT) extends Bundle {
+  val data = Vec(lanes, Vec(tileCols, outType))
+  val total_rows = UInt(log2Up(block_size + 1).W)
+  val tag = tagType
+  val last = Bool()
+}
+
+class ShapeshiftMeshWithDelays[T <: Data: Arithmetic, U <: TagQueueTag with Data]
+  (inputType: T, val outputType: T, accType: T,
+   tagType: U, df: Dataflow.Value, tree_reduction: Boolean, tile_latency: Int, output_delay: Int,
+   tileRows: Int, tileColumns: Int, meshRows: Int, meshColumns: Int,
+   leftBanks: Int, upBanks: Int, outBanks: Int = 1, n_simultaneous_matmuls: Int = -1,
+   val maxSegments: Int = 0, val debug: Boolean = false)
+  extends Module {
+
+  /** Supported segmentations, same derivation as `ShapeshiftMesh`. */
+  val segsSupported: Seq[Int] =
+    (1 to (if (maxSegments <= 0) meshRows else maxSegments)).filter(meshRows % _ == 0)
+  private val shapeW = math.max(1, log2Up(segsSupported.size))
+  require(leftBanks == 1, "the segment-aware a-skew assumes leftBanks == 1")
+
+  val A_TYPE = Vec(meshRows, Vec(tileRows, inputType))
+  /** Widest logical row this instance can carry. At maxSegments = 1 this is
+    * `meshColumns` and every type below is byte-identical to stock. */
+  val maxLanes: Int = meshColumns * segsSupported.max
+  /** Physical rows that can be a segment TOP / BOTTOM under some supported shape. */
+  val topRows: Seq[Int] =
+    segsSupported.flatMap(sg => (0 until meshRows).filter(_ % (meshRows / sg) == 0)).distinct.sorted
+
+  val B_TYPE = Vec(maxLanes, Vec(tileColumns, inputType))
+  val C_TYPE = Vec(maxLanes, Vec(tileColumns, outputType))
+  val D_TYPE = Vec(maxLanes, Vec(tileColumns, inputType))
+  val NARROW = Vec(meshColumns, Vec(tileColumns, inputType))
+  val S_TYPE = Vec(meshColumns, Vec(tileColumns, new PEControl(accType)))
+
+  // 비정방형 실험(E153): 정방형 assert 제거. block_size는 행 방향(A가 들어가는 쪽)을 쓴다.
+  // 열 방향과 다르면 이 값이 무엇을 뜻하는지가 모호해지므로, 어디가 깨지는지 확인이 목적이다.
+  val block_size = meshRows*tileRows
+
+  val latency_per_pe = ((tile_latency + 1).toFloat / (tileRows min tileColumns)) max 1.0f
+  val max_simultaneous_matmuls = if (n_simultaneous_matmuls == -1) {
+    (5 * latency_per_pe).ceil.toInt
+  } else {
+    n_simultaneous_matmuls
+  }
+  assert(max_simultaneous_matmuls >= 5 * latency_per_pe)
+
+  val tagqlen = max_simultaneous_matmuls+1
+
+  val io = IO(new Bundle {
+    val a = Flipped(Decoupled(A_TYPE))
+    val b = Flipped(Decoupled(B_TYPE))
+    val d = Flipped(Decoupled(D_TYPE))
+
+    val req = Flipped(Decoupled(new MeshWithDelaysReq(accType, tagType.cloneType, block_size)))
+
+    val resp = Valid(new ShapeshiftMWDResp(outputType, maxLanes, tileColumns, block_size, tagType.cloneType))
+
+    val tags_in_progress = Output(Vec(tagqlen, tagType))
+
+    /** Index into `segsSupported`. Latched at `req.fire`, like `pe_control`. */
+    val shape = Input(UInt(shapeW.W))
+
+    /** Diagnostics (E454): the LATCHED shape and how many requests have been
+      * accepted. If the latch never sees a request after `config_ex`, the mesh runs
+      * unfolded no matter what the execute controller decoded. */
+    val dbg_shape = if (debug) Some(Output(UInt(8.W))) else None
+    val dbg_reqs  = if (debug) Some(Output(UInt(8.W))) else None
+    /** sticky "row r's out_b was ever nonzero", one bit per PHYSICAL row. Splits
+      * "the mesh never computed that segment" from "the gather dropped it".
+      * Accumulated through ONE assignment — a per-row `when` would leave only the
+      * last row set (E453). */
+    val dbg_rows  = if (debug) Some(Output(UInt(16.W))) else None
+  })
+
+  def shifted[T <: Data](x: Vec[Vec[T]], banks: Int, reverse: Boolean = false) = {
+    assert(x.size % banks == 0, "cannot bank without clean divisors")
+
+    val banked_len = x.size / banks
+    val banked_x = x.grouped(banked_len).toSeq
+
+    val indexes = if (reverse) banked_x.indices.reverse else banked_x.indices
+
+    (banked_x zip indexes).flatMap { case (bx, i) =>
+      val bxVec = VecInit(bx)
+      val sram_shift = i * banked_len * (tile_latency+1)
+
+      val SRAMShifted = Shifter(bxVec, sram_shift, true.B, true)
+
+      val indexes = if (reverse) SRAMShifted.indices.reverse else SRAMShifted.indices
+      val RegShifted = (SRAMShifted zip indexes).map { case (srs, j) =>
+        ShiftRegister(srs, j*(tile_latency+1))
+      }
+
+      RegShifted
+    }
+  }
+
+  val req = Reg(UDValid(new MeshWithDelaysReq(accType, tagType, block_size)))
+
+  val matmul_id = RegInit(0.U(log2Up(max_simultaneous_matmuls).W))
+
+  // The shape must not move under a matmul in flight, so latch it with the request.
+  val shapeReg = RegInit(0.U(shapeW.W))
+
+  val total_fires = req.bits.total_rows
+  val fire_counter = RegInit(0.U(log2Up(block_size).W))
+
+  val a_buf = RegEnable(io.a.bits, io.a.fire)
+  val b_buf = RegEnable(io.b.bits, io.b.fire)
+  val d_buf = RegEnable(io.d.bits, io.d.fire)
+
+  val a_written = RegInit(false.B)
+  val b_written = RegInit(false.B)
+  val d_written = RegInit(false.B)
+
+  val in_prop = Reg(UInt(1.W)) // TODO inelegant
+
+  val input_next_row_into_spatial_array = req.valid && ((a_written && b_written && d_written) || req.bits.flush > 0.U)
+
+  val last_fire = fire_counter === total_fires - 1.U && input_next_row_into_spatial_array
+
+  when (io.req.fire) {
+    req.push(io.req.bits)
+    in_prop := io.req.bits.pe_control.propagate ^ in_prop
+    shapeReg := io.shape
+    matmul_id := wrappingAdd(matmul_id, 1.U, max_simultaneous_matmuls)
+  }.elsewhen (last_fire) {
+    req.valid := req.bits.flush > 1.U
+    req.bits.flush := req.bits.flush - 1.U
+  }
+
+  when (input_next_row_into_spatial_array) {
+    a_written := false.B
+    b_written := false.B
+    d_written := false.B
+
+    fire_counter := wrappingAdd(fire_counter, 1.U, total_fires)
+  }
+
+  when (io.a.fire) {
+    a_written := true.B
+  }
+
+  when (io.b.fire) {
+    b_written := true.B
+  }
+
+  when (io.d.fire) {
+    d_written := true.B
+  }
+
+  io.a.ready := !a_written || input_next_row_into_spatial_array || io.req.ready
+  io.b.ready := !b_written || input_next_row_into_spatial_array || io.req.ready
+  io.d.ready := !d_written || input_next_row_into_spatial_array || io.req.ready
+
+  assert(req.valid || !input_next_row_into_spatial_array)
+
+  val pause = !req.valid || !input_next_row_into_spatial_array
+
+  // Transposer
+  // 비정방형 실험(E153): 전치기는 정방 전용이다(AlwaysOutTransposer(block_size)).
+  // A 경로(행 방향, 크기 meshRows*tileRows)와 B/D 경로(열 방향, meshColumns*tileColumns)가
+  // **하나의 전치기를 공유**하므로, 두 크기가 다르면 아래 MuxCase가 타입 충돌을 낸다.
+  // 기본 WS matmul은 전치를 쓰지 않으므로 비정방형에서는 전치 경로를 끈다.
+  // (대가: 전치 matmul과 OS 데이터플로가 불가능해진다 — OS는 전치기를 항상 쓴다.)
+  val nonsquare = (meshRows*tileRows) != (meshColumns*tileColumns)
+  // The transposer is square-only and sized to `block_size`; a folded shape's
+  // operand row is `meshColumns * S` wide, so the two cannot share it. Transpose
+  // and OS are already unused in this whole track (WS, no transpose), and at
+  // maxSegments = 1 this reduces to `nonsquare`, keeping stock behaviour exactly.
+  val noTranspose = nonsquare || maxSegments > 1
+  val a_is_from_transposer = if (noTranspose) false.B else
+    Mux(req.bits.pe_control.dataflow === Dataflow.OS.id.U, !req.bits.a_transpose, req.bits.a_transpose)
+  val b_is_from_transposer = if (noTranspose) false.B else
+    (req.bits.pe_control.dataflow === Dataflow.OS.id.U && req.bits.bd_transpose)
+  val d_is_from_transposer = if (noTranspose) false.B else
+    (req.bits.pe_control.dataflow === Dataflow.WS.id.U && req.bits.bd_transpose)
+  val transposer = Module(new AlwaysOutTransposer(block_size, inputType))
+
+  transposer.io.inRow.valid := !pause && (a_is_from_transposer || b_is_from_transposer || d_is_from_transposer)
+  transposer.io.inRow.bits := (if (noTranspose) VecInit(a_buf.flatten) else MuxCase(VecInit(a_buf.flatten), Seq(
+    b_is_from_transposer -> VecInit(b_buf.flatten),
+    d_is_from_transposer -> VecInit(d_buf.flatten.reverse),
+  )))
+
+  transposer.io.outCol.ready := true.B
+  val transposer_out = VecInit(transposer.io.outCol.bits.grouped(tileRows).map(t => VecInit(t)).toSeq)
+
+  // Wire up mesh's IO to this module's IO
+  val mesh = Module(new ShapeshiftMesh(inputType, outputType, accType, df, tree_reduction,
+    tile_latency, max_simultaneous_matmuls, output_delay, tileRows, tileColumns,
+    meshRows, meshColumns, maxSegments))
+
+  // cut(r) = "row r starts a segment", derived from the latched shape.
+  for (r <- 0 until meshRows)
+    mesh.io.cut(r) := (if (r == 0) true.B else
+      MuxLookup(shapeReg, false.B)(segsSupported.zipWithIndex.map { case (sg, i) =>
+        i.U -> (r % (meshRows / sg) == 0).B }))
+
+  /** The `a` skew is the ONLY shape-dependent delay (E430). Physical row r is
+    * LOGICAL row `r % h`, so it must take row `r % h`'s delay, not row r's.
+    * At shape 0, h = meshRows and this is exactly what `shifted` does. */
+  def aShifted(x: Vec[Vec[T]]): Vec[Vec[T]] = VecInit(x.zipWithIndex.map { case (row, r) =>
+    val cands = segsSupported.map { sg => ShiftRegister(row, (r % (meshRows / sg)) * (tile_latency + 1)) }
+    MuxLookup(shapeReg, cands.head)(cands.zipWithIndex.map { case (v, i) => i.U -> v })
+  })
+
+  /** Vertical-chain inputs are per-row now. Every segment top gets the same
+    * column-skewed value; rows that can never be a top are ignored inside
+    * `ShapeshiftMesh`. For `b`/`d` this replicates the SAME weights into every
+    * segment, which is only correct at shape 0 — per-segment weights need the
+    * `C*S`-wide port, i.e. the next step. */
+  def bcast[TT <: Data](v: Seq[Vec[TT]]): Vec[Vec[Vec[TT]]] =
+    VecInit(Seq.fill(meshRows)(VecInit(v)))
+
+  /** Take segment 0's bottom row, which at shape 0 is the last row = stock. */
+  def gatherSeg0[TT <: Data](v: Vec[Vec[Vec[TT]]]): Vec[Vec[TT]] =
+    MuxLookup(shapeReg, v(meshRows - 1))(segsSupported.zipWithIndex.map { case (sg, i) =>
+      i.U -> v(meshRows / sg - 1) })
+
+  // TODO wire only to *_buf here, instead of io.*.bits
+  // 비정방형(E153): 전치기 출력은 행 방향 크기(meshRows*tileRows)이므로
+  // 열 방향인 B/D 경로에 그대로 넣을 수 없다. 전치를 끈 상태이므로 버퍼를 직결한다.
+  val a_shifter_in = WireInit(if (noTranspose) a_buf else Mux(a_is_from_transposer, transposer_out.asTypeOf(A_TYPE), a_buf))
+  val b_shifter_in = WireInit(if (noTranspose) b_buf else Mux(b_is_from_transposer, transposer_out.asTypeOf(B_TYPE), b_buf))
+  val d_shifter_in = WireInit(if (noTranspose) d_buf else Mux(d_is_from_transposer,
+    VecInit(transposer_out.flatten.reverse.grouped(tileRows).map(VecInit(_)).toSeq).asTypeOf(D_TYPE), d_buf))
+
+  mesh.io.in_a := aShifted(a_shifter_in)
+  // SCATTER, then the stock column skew — one chain per row that can be a segment
+  // top (at maxSegments = 1 that is row 0 only, i.e. exactly one chain, as in stock).
+  // Row r under shape S is segment `r/h`, so it takes logical lanes
+  // [ (r/h)*C , (r/h)*C + C ). Each segment is an independent h x C array with the
+  // same column structure, so the SAME `shifted` applies inside each one.
+  def sliceFor(r: Int, wide: Vec[Vec[T]]): Vec[Vec[T]] = {
+    val out = Wire(NARROW)
+    for (c <- 0 until meshColumns)
+      out(c) := MuxLookup(shapeReg, wide(c))(segsSupported.zipWithIndex.map { case (sg, i) =>
+        val hh = meshRows / sg
+        i.U -> (if (r % hh == 0 && r / hh < sg) wide((r / hh) * meshColumns + c) else wide(c))
+      })
+    out
+  }
+  for (r <- 0 until meshRows) {
+    if (topRows.contains(r)) {
+      mesh.io.in_b(r) := VecInit(shifted(sliceFor(r, b_shifter_in), upBanks))
+      mesh.io.in_d(r) := VecInit(shifted(sliceFor(r, d_shifter_in), upBanks))
+    } else {
+      mesh.io.in_b(r) := 0.U.asTypeOf(mesh.io.in_b(r))
+      mesh.io.in_d(r) := 0.U.asTypeOf(mesh.io.in_d(r))
+    }
+  }
+
+  val result_shift = RegNext(req.bits.pe_control.shift) // TODO will this arrive at the right time if memory isn't pipelined?
+  mesh.io.in_control.foreach { rowCtrl =>
+    rowCtrl.zipWithIndex.foreach { case (ss, i) =>
+      ss.foreach(_.dataflow := ShiftRegister(req.bits.pe_control.dataflow, i * (tile_latency + 1)))
+      ss.foreach(_.propagate := ShiftRegister(in_prop, i * (tile_latency + 1)))
+      ss.foreach(_.shift := ShiftRegister(result_shift, i * (tile_latency + 1)))
+    }
+  }
+
+  val not_paused_vec = VecInit(Seq.fill(meshColumns)(VecInit(Seq.fill(tileColumns)(!pause))))
+  mesh.io.in_valid := bcast(shifted(not_paused_vec, upBanks))
+
+  val matmul_id_vec = VecInit(Seq.fill(meshColumns)(VecInit(Seq.fill(tileColumns)(matmul_id))))
+  mesh.io.in_id := bcast(shifted(matmul_id_vec, upBanks))
+
+  val matmul_last_vec = VecInit(Seq.fill(meshColumns)(VecInit(Seq.fill(tileColumns)(last_fire))))
+  mesh.io.in_last := bcast(shifted(matmul_last_vec, upBanks))
+
+  // We want to output C when we're output-stationary, but B when we're weight-stationary
+  // TODO these would actually overlap when we switch from output-stationary to weight-stationary
+  // GATHER: segment slot `sl` emits from physical row `sl*h + h - 1`, and its C
+  // columns get the stock reverse de-skew. Slots beyond the current S emit 0.
+  // At maxSegments = 1 this is one slot reading the last row = stock exactly.
+  val osSel = gatherSeg0(mesh.io.out_control)(0)(0).dataflow === Dataflow.OS.id.U
+  val outRows = VecInit((0 until meshRows).map(r =>
+    Mux(osSel, mesh.io.out_c(r), mesh.io.out_b(r))))
+  for (sl <- 0 until segsSupported.max) {
+    val rowVals = MuxLookup(shapeReg, outRows(meshRows - 1))(
+      segsSupported.zipWithIndex.map { case (sg, i) =>
+        val hh = meshRows / sg
+        i.U -> (if (sl < sg) outRows(sl * hh + hh - 1) else 0.U.asTypeOf(outRows(0)))
+      })
+    val de = shifted(rowVals, outBanks, true)
+    for (c <- 0 until meshColumns) io.resp.bits.data(sl * meshColumns + c) := de(c)
+  }
+
+  io.resp.valid := shifted(gatherSeg0(mesh.io.out_valid), outBanks, reverse = true)(0)(0)
+
+  val out_last = shifted(gatherSeg0(mesh.io.out_last), outBanks, reverse = true)(0)(0)
+  io.resp.bits.last := out_last
+
+  // Tags
+  class TagWithIdAndTotalRows extends Bundle with TagQueueTag {
+    val tag = tagType.cloneType
+    val id = UInt(log2Up(max_simultaneous_matmuls).W)
+    val total_rows = UInt(log2Up(block_size+1).W)
+
+    override def make_this_garbage(dummy: Int=0): Unit = {
+      total_rows := block_size.U
+      tag.make_this_garbage()
+    }
+
+  }
+
+  val matmul_id_of_output = wrappingAdd(matmul_id, Mux(io.req.bits.pe_control.dataflow === Dataflow.OS.id.U, 3.U, 2.U), max_simultaneous_matmuls)
+  val matmul_id_of_current = wrappingAdd(matmul_id, 1.U, max_simultaneous_matmuls)
+
+  val tagq = Module(new TagQueue(new TagWithIdAndTotalRows, tagqlen))
+  tagq.io.enq.valid := io.req.fire && io.req.bits.flush === 0.U
+  tagq.io.enq.bits.tag := io.req.bits.tag
+  tagq.io.enq.bits.total_rows := DontCare
+  tagq.io.enq.bits.id := matmul_id_of_output
+
+  val tag_garbage = Wire(tagType.cloneType)
+  tag_garbage := DontCare
+  tag_garbage.make_this_garbage()
+
+  val out_matmul_id = WireInit(shifted(gatherSeg0(mesh.io.out_id), outBanks, reverse = true)(0)(0))
+  io.resp.bits.tag := Mux(tagq.io.deq.valid && out_matmul_id === tagq.io.deq.bits.id, tagq.io.deq.bits.tag, tag_garbage)
+
+  tagq.io.deq.ready := io.resp.valid && io.resp.bits.last && out_matmul_id === tagq.io.deq.bits.id
+
+  val total_rows_q = Module(new Queue(new TagWithIdAndTotalRows, tagqlen))
+  total_rows_q.io.enq.valid := io.req.fire && io.req.bits.flush === 0.U
+  total_rows_q.io.enq.bits.tag := DontCare
+  total_rows_q.io.enq.bits.total_rows := io.req.bits.total_rows
+  total_rows_q.io.enq.bits.id := matmul_id_of_current
+
+  io.resp.bits.total_rows := Mux(total_rows_q.io.deq.valid && out_matmul_id === total_rows_q.io.deq.bits.id,
+    total_rows_q.io.deq.bits.total_rows, block_size.U)
+
+  total_rows_q.io.deq.ready := io.resp.valid && io.resp.bits.last && out_matmul_id === total_rows_q.io.deq.bits.id
+
+  // Only SEGMENT-BOTTOM rows are driven inside `ShapeshiftMesh`; every other row's
+  // `out_b` is left unconnected and reads as X in simulation. A first version of
+  // this trace read all rows and returned `xxxxxx00`, which is the diagnostic
+  // failing its own sanity check rather than a DUT symptom (E453's rule).
+  val botRowsL: Seq[Int] =
+    segsSupported.flatMap(sg => (0 until meshRows).filter(r => (r + 1) % (meshRows / sg) == 0)).distinct.sorted
+  if (debug) {
+    val dbg_rows = RegInit(0.U(16.W))
+    dbg_rows := dbg_rows | VecInit((0 until 16).map(r =>
+      if (r < meshRows && botRowsL.contains(r))
+        (0 until meshColumns).map(c => mesh.io.out_b(r)(c)(0).asUInt =/= 0.U).reduce(_ || _)
+      else false.B)).asUInt
+    io.dbg_rows.get := dbg_rows
+  }
+
+  if (debug) {
+    val dbg_reqs = RegInit(0.U(8.W))
+    when (io.req.fire) { dbg_reqs := dbg_reqs + 1.U }
+    io.dbg_shape.get := shapeReg
+    io.dbg_reqs.get  := dbg_reqs
+  }
+
+  io.req.ready := (!req.valid || last_fire) && tagq.io.enq.ready && total_rows_q.io.enq.ready
+  io.tags_in_progress := tagq.io.all.map(_.tag)
+
+  when (reset.asBool) {
+    req.valid := false.B
+  }
+
+  assert(!(io.req.fire && !tagq.io.enq.ready && io.req.bits.flush === 0.U))
+}
diff --git a/src/main/scala/gemmini/ShapeshiftScatter.scala b/src/main/scala/gemmini/ShapeshiftScatter.scala
new file mode 100644
index 0000000..89f5f3d
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftScatter.scala
@@ -0,0 +1,44 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * Scratchpad-side scatter: the mirror image of `ShapeshiftGather`.
+  *
+  * A weight row for shape `S` is `C*S` wide in memory (logical columns). Logical
+  * column `n` belongs to segment `s = n/C`, column `c = n%C`, and enters the mesh
+  * at that segment's TOP row `s*h` — and `h` moves with the shape, so each
+  * segment-top row must select which slice of the wide memory row it takes.
+  *
+  *     16x16, maxSeg=4:  S=1 -> top rows [0]        take lanes 0..15
+  *                       S=2 -> [0,8]               lanes 0..15 / 16..31
+  *                       S=4 -> [0,4,8,12]          lanes 0..15 / 16..31 / 32..47 / 48..63
+  *
+  * Rows that can never be a segment top get 0 — the mesh ignores their `in_d`
+  * anyway (`ShapeshiftMesh` only muxes in the external input at `topRows`).
+  */
+class ShapeshiftScatter[T <: Data](inputType: T, val rows: Int, val cols: Int,
+                                   val maxSegments: Int) extends Module {
+
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  val maxLanes: Int = cols * segsSupported.max
+  private val shapeW = math.max(1, log2Up(segsSupported.size))
+
+  val io = IO(new Bundle {
+    val shape = Input(UInt(shapeW.W))
+    val in    = Input(Vec(maxLanes, inputType))          // one wide logical row
+    val out   = Output(Vec(rows, Vec(cols, inputType)))  // per physical row
+  })
+
+  for (r <- 0 until rows; c <- 0 until cols) {
+    io.out(r)(c) := MuxLookup(io.shape, 0.U.asTypeOf(inputType))(
+      segsSupported.zipWithIndex.map { case (segs, i) =>
+        val h = rows / segs
+        val isTop = (r % h) == 0
+        val s = r / h
+        i.U -> (if (isTop && s < segs) io.in(s * cols + c) else 0.U.asTypeOf(inputType))
+      })
+  }
+}
diff --git a/src/main/scala/gemmini/ShapeshiftSeq.scala b/src/main/scala/gemmini/ShapeshiftSeq.scala
new file mode 100644
index 0000000..66fb7c2
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftSeq.scala
@@ -0,0 +1,439 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * Sequencer for a folded matmul — the piece `ExecuteController` would provide.
+  *
+  * It is a separate module rather than a patch to `ExecuteController` so the
+  * whole shapeshift design stays in new files. What it owns is TIMING and
+  * ADDRESSES; the activation data still comes from outside (it names the row and
+  * K-chunk it wants), exactly as A would come from the scratchpad in Gemmini.
+  *
+  * Per K-chunk `t`, with `h = rows/S` and `L = h + cols` (the output latency
+  * measured in E429), the local timeline is:
+  *
+  *     c in [0, h)          weight read, address t*h + (h-1-c)   (reverse order)
+  *     c in [1, h+1)        prop = 1  (preload; PE latches c1)
+  *     c in [h+1, h+1+M)    compute, activation row c-(h+1)
+  *     c in [h+1+L, ...+M)  accumulator write, row c-(h+1+L),
+  *                          acc = (t != 0)   <- this is what makes K > h work
+  *     chunk length         2h + cols + M + 1
+  *
+  * The chunks are SERIALISED: chunk t+1's preload waits for chunk t's last
+  * accumulator write. Gemmini overlaps them using the PE's c1/c2 double buffer,
+  * which would remove the `2h + cols + 1` per chunk. That is a real difference
+  * and the cycle counts below carry it — they measure THIS sequencer, not the
+  * architecture's ceiling.
+  */
+class ShapeshiftSequencer(val rows: Int, val cols: Int, val maxSegments: Int,
+                          val maxM: Int, val maxChunks: Int, val wEntries: Int,
+                          val accEntries: Int) extends Module {
+
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  private val shapeW = math.max(1, log2Up(segsSupported.size))
+  private val cW = log2Up(2 * rows + cols + maxM + 4)
+
+  val io = IO(new Bundle {
+    val shape   = Input(UInt(shapeW.W))
+    val start   = Input(Bool())
+    val m       = Input(UInt(log2Up(maxM + 1).W))
+    val chunks  = Input(UInt(log2Up(maxChunks + 1).W))
+    val n_tiles  = Input(UInt(8.W))     // E438: N tiles
+    val k_stride = Input(UInt(16.W))    // weight rows per N tile (= K, padded to >= rows)
+
+    val busy = Output(Bool())
+    val done = Output(Bool())
+
+    val wmem_ren   = Output(Bool())
+    val wmem_raddr = Output(UInt(log2Up(wEntries).W))
+    val in_prop    = Output(Bool())
+    val in_valid   = Output(Bool())
+    val acc_wen    = Output(Bool())
+    val acc_waddr  = Output(UInt(log2Up(accEntries).W))
+    val acc_acc    = Output(Bool())
+
+    val a_en    = Output(Bool())
+    val a_idx   = Output(UInt(log2Up(maxM + 1).W))
+    val a_chunk = Output(UInt(log2Up(maxChunks + 1).W))
+    val a_tile  = Output(UInt(8.W))
+  })
+
+  // h and L follow the shape.
+  // WIDTHS MATTER HERE. Chisel's `+` on UInt returns max(w1,w2) bits and TRUNCATES
+  // the carry (`+&` is the widening add). A first version had `h` inferred at 3
+  // bits from the MuxLookup entries, so `h + cols.U` computed 4+4 = 8 -> 0, and
+  // the accumulator wrote at the same cycles as the compute instead of L later.
+  // The symptom was X in the accumulator, not a wrong number — see E435.
+  val h = Wire(UInt(8.W))
+  h := MuxLookup(io.shape, rows.U)(
+    segsSupported.zipWithIndex.map { case (s, i) => i.U -> (rows / s).U })
+  val L = Wire(UInt(8.W)); L := h + cols.U
+
+  val running = RegInit(false.B)
+  val c = RegInit(0.U(cW.W))          // cycle within the chunk
+  val t = RegInit(0.U(log2Up(maxChunks + 1).W))
+  val p = RegInit(0.U(8.W))           // N-tile index (E440)
+
+  val chunkLen = Wire(UInt(12.W)); chunkLen := 2.U * h + cols.U + io.m + 1.U
+  val lastChunk = t === io.chunks - 1.U
+
+  val lastPass = lastChunk && p === io.n_tiles - 1.U
+  when (!running && io.start) { running := true.B; c := 0.U; t := 0.U; p := 0.U }
+    .elsewhen (running) {
+      when (c === chunkLen - 1.U) {
+        c := 0.U
+        when (lastChunk) {
+          t := 0.U
+          when (p === io.n_tiles - 1.U) { running := false.B } .otherwise { p := p + 1.U }
+        } .otherwise { t := t + 1.U }
+      } .otherwise { c := c + 1.U }
+    }
+
+  io.busy := running
+  io.done := running && lastPass && c === chunkLen - 1.U
+
+  val preRd  = running && c < h
+  val preOn  = running && c >= 1.U && c < h + 1.U
+  val comp   = running && c >= h + 1.U && c < h + 1.U + io.m
+  val accOn  = running && c >= h + 1.U + L && c < h + 1.U + L + io.m
+
+  io.wmem_ren   := preRd
+  io.wmem_raddr := p * io.k_stride + t * h + (h - 1.U - c)
+  io.in_prop    := preOn
+  io.in_valid   := running && c >= 1.U
+
+  io.acc_wen   := accOn
+  io.acc_waddr := p * io.m + (c - (h + 1.U + L))
+  io.acc_acc   := t =/= 0.U          // first chunk overwrites, the rest accumulate
+
+  io.a_en    := comp
+  io.a_idx   := c - (h + 1.U)
+  io.a_chunk := t
+  io.a_tile  := p
+}
+
+/**
+  * Self-sequenced end-to-end test with a REAL K LOOP.
+  *
+  * Reduction depth is `K = rows` for every shape, so all three do the same
+  * reduction with a different number of chunks (`K/h` = 1, 2, 4). That is what
+  * exercises the accumulator's accumulate mode, which nothing before this did.
+  */
+class ShapeshiftSeqSeg(shapeIdx: Int, rows: Int = 4, cols: Int = 4, M: Int = 6, mode: Int = 0,
+                       pipelined: Boolean = false, maxSeg: Int = 0, Kin: Int = 0,
+                       Ntot: Int = 0)
+  extends Module {
+
+  val ms = if (maxSeg <= 0) rows else maxSeg
+  val segsSupported: Seq[Int] = (1 to ms).filter(rows % _ == 0)
+  val S = segsSupported(shapeIdx); val h = rows / S
+  val K = if (Kin <= 0) rows else Kin       // reduction depth (may be < rows: shallow-K case)
+  val chunks = math.max(1, K / h)           // K < h -> one chunk, array is padded with zeros
+  val Kp = math.max(K, rows)                          // weight rows per N tile
+  val Nt = if (Ntot <= 0) cols * S else Ntot          // total output width
+  val tiles = math.max(1, Nt / (cols * S))            // N tiles this shape needs
+  val passes = tiles * chunks
+  val maxLanes = cols * segsSupported.max
+
+  val TW = 2
+  val TC = TW + tiles * Kp + 2
+  val TS = TC + 4                   // start
+
+  def aVal(i: Int, k: Int): Int = (i + 2 * k) % 7 - 3
+  def bVal(k: Int, n: Int): Int = (3 * k + n) % 5 - 2
+  def gold(i: Int, n: Int): Int = (0 until K).map(k => aVal(i, k) * bVal(k, n)).sum
+
+  val io = IO(new Bundle {
+    val ok = Output(Bool()); val checked = Output(UInt(16.W))
+    val cycles = Output(UInt(16.W)); val shape = Output(UInt(8.W))
+    val dbg0 = Output(SInt(32.W)); val dbgN = Output(SInt(32.W))   // 진단용
+    val w0 = Output(SInt(20.W)); val ph = Output(UInt(8.W))
+  })
+
+  val WE = 1 << log2Up(tiles * Kp + 1); val AE = 1 << log2Up(tiles * M + 2)
+  val dp  = Module(new ShapeshiftDatapath(rows, cols, ms, wEntries = WE, accEntries = AE))
+  val seqS = if (pipelined) None else Some(Module(new ShapeshiftSequencer(
+    rows, cols, ms, maxM = M + 2, maxChunks = math.max(rows, K), wEntries = WE, accEntries = AE)))
+  val seqP = if (pipelined) Some(Module(new ShapeshiftSequencerP(
+    rows, cols, ms, maxM = M + 2, maxChunks = math.max(rows, K), wEntries = WE, accEntries = AE))) else None
+  val seq = new {   // 두 시퀀서의 공통 인터페이스
+    val io = new {
+      val shape = if (pipelined) seqP.get.io.shape else seqS.get.io.shape
+      val start = if (pipelined) seqP.get.io.start else seqS.get.io.start
+      val m = if (pipelined) seqP.get.io.m else seqS.get.io.m
+      val chunks = if (pipelined) seqP.get.io.chunks else seqS.get.io.chunks
+      val busy = if (pipelined) seqP.get.io.busy else seqS.get.io.busy
+      val done = if (pipelined) seqP.get.io.done else seqS.get.io.done
+      val wmem_ren = if (pipelined) seqP.get.io.wmem_ren else seqS.get.io.wmem_ren
+      val wmem_raddr = if (pipelined) seqP.get.io.wmem_raddr else seqS.get.io.wmem_raddr
+      val in_prop = if (pipelined) seqP.get.io.in_prop else seqS.get.io.in_prop
+      val in_valid = if (pipelined) seqP.get.io.in_valid else seqS.get.io.in_valid
+      val acc_wen = if (pipelined) seqP.get.io.acc_wen else seqS.get.io.acc_wen
+      val acc_waddr = if (pipelined) seqP.get.io.acc_waddr else seqS.get.io.acc_waddr
+      val acc_acc = if (pipelined) seqP.get.io.acc_acc else seqS.get.io.acc_acc
+      val a_en = if (pipelined) seqP.get.io.a_en else seqS.get.io.a_en
+      val a_idx = if (pipelined) seqP.get.io.a_idx else seqS.get.io.a_idx
+      val a_chunk = if (pipelined) seqP.get.io.a_chunk else seqS.get.io.a_chunk
+      val a_tile = if (pipelined) seqP.get.io.a_tile else seqS.get.io.a_tile
+      val n_tiles = if (pipelined) seqP.get.io.n_tiles else seqS.get.io.n_tiles
+      val k_stride = if (pipelined) seqP.get.io.k_stride else seqS.get.io.k_stride
+    }
+  }
+  val cycle = RegInit(0.U(16.W)); cycle := cycle + 1.U
+
+  // ---- weight SRAM: address k holds logical row k of B, C*S wide ----
+  val wt = (cycle - TW.U)(log2Up(tiles * Kp + 1) - 1, 0)
+  // fill ALL `rows` addresses: rows >= K must hold 0, not X, because a padded
+  // shape still reads them (that is exactly what "the array is underfilled" means)
+  dp.io.wmem_wen   := cycle >= TW.U && cycle < (TW + tiles * Kp).U
+  dp.io.wmem_waddr := wt
+  for (n <- 0 until maxLanes)
+    dp.io.wmem_wdata(n) := (if (n < cols * S)
+      MuxLookup(wt, 0.S(8.W))((0 until tiles * Kp).map { a =>
+        val pp = a / Kp; val k = a % Kp
+        a.U -> (if (k < K) bVal(k, pp * cols * S + n) else 0).S(8.W)
+      }) else 0.S(8.W))
+
+  // ---- shape ----
+  val sent = if (mode == 2) segsSupported.size + 1 else shapeIdx
+  dp.io.cmd_valid := (mode != 1).B && cycle === TC.U
+  dp.io.cmd_funct := GemminiISA.CONFIG_CMD
+  dp.io.cmd_rs1   := (if (mode == 1) BigInt(0) else ShapeshiftISA.rs1(sent)).U(64.W)
+
+  // ---- sequencer drives the datapath ----
+  seq.io.shape  := dp.io.shape
+  seq.io.start  := cycle === TS.U
+  seq.io.m      := M.U
+  seq.io.chunks := chunks.U
+  seq.io.n_tiles := tiles.U
+  seq.io.k_stride := Kp.U
+
+  when (seq.io.busy || seq.io.wmem_ren) {
+    dp.io.wmem_ren   := seq.io.wmem_ren
+    dp.io.wmem_raddr := seq.io.wmem_raddr
+  } .otherwise {
+    dp.io.wmem_ren   := false.B
+    dp.io.wmem_raddr := 0.U
+  }
+  dp.io.in_prop  := seq.io.in_prop
+  dp.io.in_valid := seq.io.in_valid
+  dp.io.acc_wen  := seq.io.acc_wen
+  dp.io.acc_waddr:= seq.io.acc_waddr
+  dp.io.acc_acc  := seq.io.acc_acc
+
+  // ---- activations: the sequencer names (row, chunk); we supply A[i][chunk*h + j] ----
+  for (r <- 0 until rows) {
+    val j = r % h
+    dp.io.in_a(r) := Mux(seq.io.a_en,
+      MuxLookup(Cat(seq.io.a_chunk(log2Up(rows) - 1, 0), seq.io.a_idx(log2Up(M + 1) - 1, 0)), 0.S(8.W))(
+        (for (tt <- 0 until chunks; i <- 0 until M) yield
+          ((tt << log2Up(M + 1)) | i).U -> aVal(i, tt * h + j).S(8.W))),
+      0.S(8.W))
+  }
+
+  // ---- read back after done ----
+  val fin = RegInit(false.B)
+  val finAt = Reg(UInt(16.W))
+  when (seq.io.done) { fin := true.B; finAt := cycle }
+  val TR = finAt + 6.U
+  val NR = tiles * M
+  val ri = (cycle - TR)(log2Up(NR + 1) - 1, 0)
+  dp.io.acc_ren   := fin && cycle >= TR && cycle < TR + NR.U
+  dp.io.acc_raddr := ri
+
+  val ok = RegInit(true.B); val cnt = RegInit(0.U(16.W))
+  for (a <- 0 until NR) {
+    val pp = a / M; val i = a % M
+    when (fin && cycle === TR + (a + 1).U) {
+      cnt := cnt + 1.U
+      val bad = (0 until maxLanes).map { n =>
+        dp.io.acc_rdata(n) =/= (if (n < cols * S) gold(i, pp * cols * S + n) else 0).S(32.W)
+      }.reduce(_ || _)
+      when (bad) { ok := false.B }
+    }
+  }
+  val d0 = Reg(SInt(32.W)); val dN = Reg(SInt(32.W))
+  when (fin && cycle === TR + 1.U) { d0 := dp.io.acc_rdata(0); dN := dp.io.acc_rdata(maxLanes - 1) }
+  io.dbg0 := d0; io.dbgN := dN
+  io.w0 := dp.io.dbg_wide0
+  io.ph := Cat(seq.io.acc_wen, seq.io.a_en, seq.io.in_prop, seq.io.wmem_ren, seq.io.busy)
+  io.ok      := ok
+  io.checked := cnt
+  io.cycles  := Mux(fin, finAt - TS.U + 1.U, 0.U)
+  io.shape   := dp.io.shape
+}
+
+class ShapeshiftSeqTop(mode: Int = 0, pipelined: Boolean = false,
+                       rows: Int = 4, cols: Int = 4, M: Int = 6, maxSeg: Int = 0,
+                       Kin: Int = 0, Ntot: Int = 0) extends Module {
+  val io = IO(new Bundle {
+    val ok = Output(UInt(3.W)); val checked = Output(UInt(48.W))
+    val cyc0 = Output(UInt(16.W)); val cyc1 = Output(UInt(16.W)); val cyc2 = Output(UInt(16.W))
+    val shapes = Output(UInt(24.W))
+    val dbg = Output(Vec(6, SInt(32.W)))
+    val w0 = Output(SInt(20.W)); val ph = Output(UInt(8.W))
+  })
+  val duts = (0 to 2).map(i => Module(new ShapeshiftSeqSeg(i, rows, cols, M, mode, pipelined, maxSeg, Kin, Ntot)))
+  io.ok      := Cat(duts.map(_.io.ok).reverse)
+  io.checked := Cat(duts.map(_.io.checked).reverse)
+  io.cyc0 := duts(0).io.cycles; io.cyc1 := duts(1).io.cycles; io.cyc2 := duts(2).io.cycles
+  io.shapes  := Cat(duts.map(_.io.shape).reverse)
+  for (i <- 0 to 2) { io.dbg(2*i) := duts(i).io.dbg0; io.dbg(2*i+1) := duts(i).io.dbgN }
+  io.w0 := duts(0).io.w0; io.ph := duts(0).io.ph
+}
+
+object ShapeshiftSeqMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-seq"
+  val mode = if (args.length > 1) args(1).toInt else 0
+  val pipe = args.length > 2 && args(2) == "pipe"
+  val rows = if (args.length > 3) args(3).toInt else 4
+  val cols = if (args.length > 4) args(4).toInt else 4
+  val mm   = if (args.length > 5) args(5).toInt else 6
+  val msg  = if (args.length > 6) args(6).toInt else 0
+  val kk   = if (args.length > 7) args(7).toInt else 0
+  val nn   = if (args.length > 8) args(8).toInt else 0
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftSeqTop(mode, pipe, rows, cols, mm, msg, kk, nn),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftSeqTop(mode=$mode) into $dir")
+}
+
+/**
+  * Pipelined sequencer: the preload of chunk `t+1` overlaps the compute of chunk
+  * `t`, using the PE's `c1`/`c2` double buffer. This is what Gemmini does, and it
+  * removes the `2h + cols + 1` per-chunk overhead that E435 measured.
+  *
+  * Two things had to be re-derived from the PE, and both are counter-intuitive:
+  *
+  * 1. WEIGHTS GO AT THE END OF THE WINDOW, NOT THE START. A PE latches `d` into
+  *    the non-computing register on EVERY cycle that `prop` selects it, so what
+  *    survives is the LAST thing fed before the flip. From E429's timing,
+  *    `PE(j)` keeps the `d` fed at `flip_time - j - 1`; feeding chunk `t+1` in the
+  *    last `h` cycles of chunk `t`'s window (still in reverse row order) lands
+  *    `B[j]` in `PE(j)`. Feeding at the START of the window would be overwritten.
+  *
+  * 2. `prop` ALTERNATES PER CHUNK. `prop = 0` computes with `c1` and loads `c2`;
+  *    `prop = 1` computes with `c2` and loads `c1`. So chunk `t` computes with
+  *    whatever chunk `t-1` loaded, which means the prologue must run with the
+  *    OPPOSITE polarity to chunk 0.
+  *
+  * The accumulator side needs no counters at all: an accumulator write for
+  * (chunk t, row i) happens exactly `L` cycles after that activation row was fed,
+  * so the acc controls are the compute controls delayed by `L` — a tapped delay
+  * chain, the same trick the `a` skew uses.
+  */
+class ShapeshiftSequencerP(val rows: Int, val cols: Int, val maxSegments: Int,
+                           val maxM: Int, val maxChunks: Int, val wEntries: Int,
+                           val accEntries: Int) extends Module {
+
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  private val shapeW = math.max(1, log2Up(segsSupported.size))
+  private val maxL = rows + cols + 2
+
+  val io = IO(new Bundle {
+    val shape  = Input(UInt(shapeW.W))
+    val start  = Input(Bool())
+    val m       = Input(UInt(8.W))
+    val chunks  = Input(UInt(8.W))
+    val n_tiles  = Input(UInt(8.W))     // E438: passes are (N-tile p, K-chunk t)
+    val k_stride = Input(UInt(16.W))    // weight rows per N tile (= K, padded to >= rows)
+
+    val busy = Output(Bool()); val done = Output(Bool())
+
+    val wmem_ren   = Output(Bool())
+    val wmem_raddr = Output(UInt(log2Up(wEntries).W))
+    val in_prop    = Output(Bool())
+    val in_valid   = Output(Bool())
+    val acc_wen    = Output(Bool())
+    val acc_waddr  = Output(UInt(log2Up(accEntries).W))
+    val acc_acc    = Output(Bool())
+
+    val a_en    = Output(Bool())
+    val a_idx   = Output(UInt(8.W))
+    val a_chunk = Output(UInt(8.W))
+    val a_tile  = Output(UInt(8.W))
+  })
+
+  // widths are explicit everywhere: E435 lost a day to `+` truncating a carry
+  val h = Wire(UInt(8.W))
+  h := MuxLookup(io.shape, rows.U)(
+    segsSupported.zipWithIndex.map { case (s, i) => i.U -> (rows / s).U })
+  val L = Wire(UInt(8.W)); L := h + cols.U
+
+  val sIdle :: sPro :: sMain :: sDrain :: Nil = Enum(4)
+  val st = RegInit(sIdle)
+  val ci = RegInit(0.U(8.W))     // cycle within the current phase / pass
+  val t  = RegInit(0.U(8.W))     // K-chunk index within the current N-tile
+  val p  = RegInit(0.U(8.W))     // N-tile index
+  val pol = RegInit(false.B)     // prop polarity, flips every PASS (not every chunk)
+
+  // PASS WINDOW. The next chunk's weights need `h` cycles inside this pass plus
+  // one for the SyncReadMem latency, so a pass cannot be shorter than h+1 even if
+  // there are fewer than that many activation rows to compute. GEMV is exactly
+  // that case (M = 1), and it is where folding pays most: the stall is `h+1-M`,
+  // and `h` is what the shape shrinks. See E440.
+  val W = Wire(UInt(8.W)); W := Mux(io.m > h, io.m, h + 1.U)
+
+  switch (st) {
+    is (sIdle)  { when (io.start) { st := sPro; ci := 0.U; t := 0.U; p := 0.U; pol := false.B } }
+    is (sPro)   { when (ci === h) { st := sMain; ci := 0.U } .otherwise { ci := ci + 1.U } }
+    is (sMain)  {
+      when (ci === W - 1.U) {
+        ci := 0.U; pol := !pol
+        when (t === io.chunks - 1.U) {
+          t := 0.U
+          when (p === io.n_tiles - 1.U) { st := sDrain } .otherwise { p := p + 1.U }
+        } .otherwise { t := t + 1.U }
+      } .otherwise { ci := ci + 1.U }
+    }
+    is (sDrain) { when (ci === L + 2.U) { st := sIdle; ci := 0.U } .otherwise { ci := ci + 1.U } }
+  }
+
+  io.busy := st =/= sIdle
+  io.done := st === sDrain && ci === L + 2.U
+
+  // ---- weights ----------------------------------------------------------
+  // prologue: read chunk 0 at ci in [0,h); main: read chunk t+1 in the LAST h
+  // cycles of the chunk, issued one cycle early for the SyncReadMem latency.
+  // CONSTRAINT: the preload of the next chunk needs h cycles inside this chunk's
+  // M-cycle window, plus one for the SyncReadMem latency, so **M >= h + 1**.
+  // At h = rows (unsegmented) that means M >= rows + 1 — the folded shapes, which
+  // have smaller h, are the *easier* case here.
+  val mainRdLo = W - h - 1.U                          // first read cycle in a pass
+  // the NEXT pass may be (p, t+1) or (p+1, 0)
+  val lastChunk = t === io.chunks - 1.U
+  val morePass  = !(lastChunk && p === io.n_tiles - 1.U)
+  val nxtT = Mux(lastChunk, 0.U, t + 1.U)
+  val nxtP = Mux(lastChunk, p + 1.U, p)
+  val mainRd   = st === sMain && ci >= mainRdLo && ci < W - 1.U && morePass
+  val proRd    = st === sPro && ci < h
+  val rdIdx    = Mux(st === sPro, ci, ci - mainRdLo)  // 0..h-1 within the feed
+  val rdChunk  = Mux(st === sPro, 0.U, nxtT)
+  val rdTile   = Mux(st === sPro, 0.U, nxtP)
+  io.wmem_ren   := proRd || mainRd
+  io.wmem_raddr := rdTile * io.k_stride + rdChunk * h + (h - 1.U - rdIdx)
+
+  // ---- prop: prologue is the opposite polarity to chunk 0 ----------------
+  // pro=1 loads c1; chunk 0 must then COMPUTE with c1, which is prop=0.
+  // (A first version wrote `!t(0)`, which gives chunk 0 prop=1 — the same polarity
+  //  as the prologue, so the buffer never flips and every result is garbage.)
+  io.in_prop  := Mux(st === sPro, true.B, pol)        // flips every PASS, not every chunk
+  io.in_valid := st =/= sIdle
+
+  // ---- compute ----------------------------------------------------------
+  io.a_en    := st === sMain && ci < io.m      // stall cycles feed nothing
+  io.a_idx   := ci
+  io.a_chunk := t
+  io.a_tile  := p
+
+  // ---- accumulator = compute, delayed by L ------------------------------
+  def tapL[T <: Data](x: T): T = {
+    val chain = Seq.iterate(x, maxL + 1)(p => RegNext(p, 0.U.asTypeOf(chiselTypeOf(x))))
+    VecInit(chain)(L)
+  }
+  io.acc_wen   := tapL(io.a_en)
+  io.acc_waddr := tapL(io.a_tile) * io.m + tapL(io.a_idx)   // tile-major accumulator layout
+  io.acc_acc   := tapL(io.a_chunk =/= 0.U)
+}
diff --git a/src/main/scala/gemmini/ShapeshiftSkew.scala b/src/main/scala/gemmini/ShapeshiftSkew.scala
new file mode 100644
index 0000000..60d7642
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftSkew.scala
@@ -0,0 +1,112 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * `ShapeshiftMesh` + the systolic skew network, i.e. the piece `MeshWithDelays`
+  * provides for a fixed-shape mesh.
+  *
+  * WHAT ACTUALLY CHANGES WHEN THE MESH IS SEGMENTED — only the `a` skew.
+  *
+  * The systolic invariant for output C[i][c] = sum_k A[i][k]*B[k][c] is that the
+  * activation and the partial sum must meet at PE(k, c):
+  *
+  *     T_a(i,k) + c  ==  T_b(i,c) + k
+  *
+  * (`a` takes one cycle per column hop, the partial sum one cycle per row hop.)
+  * With the standard `T_b(i,c) = i + c` this forces `T_a(i,k) = i + k`, which is
+  * why `MeshWithDelays` delays mesh row `r` by `r`.
+  *
+  * For a segment of depth `h` starting at physical row `s*h`, the LOCAL row index
+  * is `j = r mod h`, and `T_b` is unchanged (it is a per-COLUMN quantity, and
+  * columns are not segmented). So the requirement becomes `T_a(i,j) = i + j`:
+  *
+  *     physical row r must be delayed by  (r mod h),  not by r.
+  *
+  * Everything else — the per-column skew of `b`/`d`/control/valid and the
+  * per-column output de-skew — is untouched, because segmenting cuts rows, not
+  * columns. That is the whole delta.
+  *
+  * `h` is runtime-selected, so each row taps a shared delay chain at one of
+  * `|segsSupported|` positions. The chain is the same one a fixed mesh needs, so
+  * the cost is muxes, not registers.
+  */
+class ShapeshiftSkew[T <: Data : Arithmetic](inputType: T, outputType: T, accType: T,
+                                             val rows: Int, val cols: Int,
+                                             val maxSegments: Int,
+                                             tile_latency: Int = 0, output_delay: Int = 1)
+  extends Module {
+
+  /** supported segment counts, e.g. rows=4, maxSegments=4 -> Seq(1,2,4) */
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  private val nShapes = segsSupported.size
+  private val shapeW  = math.max(1, log2Up(nShapes))
+
+  val io = IO(new Bundle {
+    /** index into `segsSupported`; must only change while the array is drained */
+    val shape    = Input(UInt(shapeW.W))
+
+    val in_a     = Input(Vec(rows, inputType))                  // UNSKEWED, per physical row
+    val in_d     = Input(Vec(rows, Vec(cols, inputType)))       // UNSKEWED, per segment-top row
+    val in_b     = Input(Vec(rows, Vec(cols, outputType)))      // UNSKEWED (bias / 0)
+    val in_prop  = Input(Bool())
+    val in_valid = Input(Bool())
+
+    val out       = Output(Vec(rows, Vec(cols, outputType)))    // DE-SKEWED, per segment-bottom row
+    val out_valid = Output(Vec(rows, Bool()))
+  })
+
+  private val step = tile_latency + 1
+
+  /** shared delay chain; `dly(x, n)(d)` is `x` delayed by `d*step`, d <= n.
+    * NO reset — that is what lets Vivado map these to SRL16E/SRL32E (32 bits per
+    * LUT) instead of flip-flops. `Mesh.scala` does the same thing, and goes as far
+    * as `chisel3.withReset(false.B)` around its pipes. E431 measures what it buys. */
+  private def dly[TT <: Data](x: TT, n: Int): Seq[TT] =
+    Seq.iterate(x, n + 1)(p => ShiftRegister(p, step))
+
+  /** tap the chain at `taps(shape)` */
+  private def tapped[TT <: Data](x: TT, taps: Seq[Int]): TT = {
+    val chain = dly(x, taps.max)
+    if (taps.distinct.size == 1) chain(taps.head)
+    else MuxLookup(io.shape, chain(taps.head))(taps.zipWithIndex.map { case (d, i) => i.U -> chain(d) })
+  }
+
+  val mesh = Module(new ShapeshiftMesh(inputType, outputType, accType, Dataflow.WS,
+    tree_reduction = false, tile_latency = tile_latency,
+    max_simultaneous_matmuls = 4, output_delay = output_delay,
+    tileRows = 1, tileColumns = 1, meshRows = rows, meshColumns = cols,
+    maxSegments = maxSegments))
+
+  // cut mask: row r starts a segment iff r % (rows/S) == 0, for the selected S
+  mesh.io.cut := VecInit(Seq.tabulate(rows) { r =>
+    if (r == 0) true.B
+    else MuxLookup(io.shape, false.B)(
+      segsSupported.zipWithIndex.map { case (s, i) => i.U -> (r % (rows / s) == 0).B })
+  })
+
+  // ---- a : the ONE skew that depends on the shape ----
+  for (r <- 0 until rows)
+    mesh.io.in_a(r)(0) := tapped(io.in_a(r), segsSupported.map(s => r % (rows / s)))
+
+  // ---- b / d / control / valid : per-column skew, shape-independent ----
+  for (r <- 0 until rows; c <- 0 until cols) {
+    mesh.io.in_d(r)(c)(0)               := ShiftRegister(io.in_d(r)(c), c * step)
+    mesh.io.in_b(r)(c)(0)               := ShiftRegister(io.in_b(r)(c), c * step)
+    mesh.io.in_valid(r)(c)(0)           := ShiftRegister(io.in_valid, c * step, false.B, true.B)
+    mesh.io.in_id(r)(c)(0)              := 0.U
+    mesh.io.in_last(r)(c)(0)            := false.B
+    mesh.io.in_control(r)(c)(0).dataflow  := Dataflow.WS.id.U(1.W)
+    mesh.io.in_control(r)(c)(0).propagate := ShiftRegister(io.in_prop, c * step, false.B, true.B)
+    mesh.io.in_control(r)(c)(0).shift     := 0.U
+  }
+
+  // ---- outputs : per-column de-skew, shape-independent ----
+  for (r <- 0 until rows; c <- 0 until cols) {
+    io.out(r)(c) := ShiftRegister(mesh.io.out_b(r)(c)(0), (cols - 1 - c) * step)
+  }
+  for (r <- 0 until rows)
+    io.out_valid(r) := ShiftRegister(mesh.io.out_valid(r)(cols - 1)(0), 0, false.B, true.B)
+}
