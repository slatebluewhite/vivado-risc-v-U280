+/**
+  * Area/timing wrapper for the whole `ExecuteController`.
+  *
+  * E445 priced `MeshWithDelays` alone. Everything E446/E447/E452/E456 added — the
+  * config_ex shape decode, the per-segment scratchpad bank fetch, the per-segment
+  * accumulator bank write, the `d_rev_base` reverse index — lives in
+  * `ExecuteController`, so that is the module to synthesise.
+  *
+  * `sp_banks`/`acc_banks` are held FIXED across both builds so the only difference
+  * is `shapeshift_max_segments`. The banking is a config choice a deployment makes
+  * anyway; mixing it in would fold two decisions into one number.
+  */
+class SSExecArea(rows: Int, cols: Int, maxSeg: Int, accBanks: Int = 4, accKBArg: Int = 16, spKBArg: Int = 8, rowFloorArg: Int = 4, spBanksArg: Int = 8) extends Module {
+  import ShapeshiftExecParams.p
+  // `accBanks` 는 기본 4 로 고정 — E481 은 뱅킹을 고정해 maxSeg 만 비교했다. E493 은
+  // maxSeg=8 을 열기 위해(require: acc_banks >= maxSeg) 이것을 인자로 뺐다. 뱅킹을 바꾸면
+  // 기준선도 같은 뱅킹으로 다시 재야 비교가 성립한다.
+  //
+  // 누산기 뱅크당 행 수는 DIM 의 배수여야 한다. 뱅크를 늘리면 뱅크당 행이 줄므로
+  // 32x32/banks=8 은 16 행이 되어 실패한다. **기존 측정을 안 건드리기 위해** 16 KB 를
+  // 유지하되 그것이 불법일 때만 최소 합법값으로 올린다 (E495).
+  // 기본 16 KB 는 16x16 의 모든 뱅크 수와 32x32/banks=4 에서 합법이다. 32x32/banks=8 은
+  // 뱅크당 16 행(DIM=32 의 배수 아님)이 되고 `SP_TILES+2 < ACC_TILES` 도 깨져서 64 를 줘야
+  // 한다. 그 어서션은 실제로는 `USABLE_SP_TILES >= ACC_TILES` 이고 메시지가 조건을
+  // 거꾸로 적어 놨다 — scratchpad 쪽을 키워야 한다 (16 KB). 그래서 둘 다 인자로 뺐다. **같은 값을 쓴 쌍끼리만 비교할 것**: 용량을 키우면 기준선이
+  // 커져서 % 가 희석된다. 비교에 쓸 양은 ΔLUT 쪽이다 (E495).
+  private val accKB = accKBArg
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = false,   // 면적은 계측 없이 잰다 (E481)
+    shapeshift_row_floor = rowFloorArg,   // E529: 바닥 2 의 면적(skid queue + id 공간)을 잰다
+    acc_banks = accBanks, sp_banks = spBanksArg,   // E531: maxSeg=16 은 sp_banks >= 16 필요
+    sp_capacity = CapacityInKilobytes(spKBArg), acc_capacity = CapacityInKilobytes(accKB))
+
+  val ex = Module(new ExecuteController(64, 32, cfg)(p, implicitly[Arithmetic[chisel3.SInt]]))
+  val io = IO(chiselTypeOf(ex.io))
+  io <> ex.io
+}
