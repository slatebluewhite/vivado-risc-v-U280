+/**
+  * CROSS-SHAPE correctness: the same (M, K, N) solved by every shape, compared
+  * against each other.
+  *
+  * E461 found that the differential check (a folded run against a same-shape
+  * reference) is blind to any error that hits both sides identically — truncating
+  * K is exactly that, so `mismatch = 0` there said nothing about whether the
+  * folded shape solves the problem. Comparing ACROSS shapes catches it, because a
+  * shape with `h >= K` and one with `h < K` do not truncate the same way.
+  *
+  * Logical C[i][n] lives at different places per shape (width = cols*S):
+  *     p = n / width,  s = (n % width) / cols,  c = n % cols
+  *     C[i][n] = acc(bank s)(row p*M + i)(col c)
+  *
+  * `sab = 1` shifts one shape's B by one column, which must produce a mismatch.
+  */
+class ShapeshiftExecXTop(rows: Int = 16, cols: Int = 16, maxSeg: Int = 4,
+                         M: Int = 4, K: Int = 4, N: Int = 64, sab: Int = 0,
+                         rowFloor: Int = 4, accMode: Int = 0, spKBOv: Int = 0,
+                         chkAt: Int = 600, t0Pad: Int = 0, issueOrder: Int = 0) extends Module {
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val io = IO(new Bundle {
+    val xmismatch = Output(UInt(segs.size.W))   // shape j 가 shape 0 과 어긋나는가
+    val checked   = Output(UInt(16.W))
+    val nonzero   = Output(Bool())
+    /** shape 0 이 Scala golden 과 어긋나는가. E462 의 검사기 표에 남아 있던
+      * "모든 shape 가 같이 틀리는 오류" 칸을 닫는다 (E463). */
+    val gbad      = Output(Bool())
+    val gchecked  = Output(UInt(16.W))
+    /** 규약 후보별 일치 여부 (E463). golden 이 안 맞을 때 어느 규약인지 가른다. */
+    val gconv     = Output(UInt(4.W))
+    /** shape i 가 "첫 chunk 만 계산한 golden" 과 일치하는가 (E477).
+      * 일치하면 chunk >= 1 의 가중치가 **0 으로** 실린 것이고, 아니면 엉뚱한 값이 실린 것이다. */
+    val gpart     = Output(UInt(4.W))
+    /** shape i 가 "chunk t 가 chunk t-1 의 가중치를 쓴" 값과 일치하는가 (E477).
+      * PE 의 double buffer 가 한 chunk 늦게 뒤집히는 경우에 해당한다. */
+    val gstale    = Output(UInt(4.W))
+    val samp      = Output(UInt(128.W))   // 진단: 실제 값 몇 개
+    /** E522: shape 0, row 0 의 논리 n 별 golden 불일치 비트맵 (n < min(N,64)) */
+    val badmap    = Output(UInt(64.W))
+    /** E522: 마지막 16 논리열 (n = N-16 .. N-1) 의 실제 값, 16b 씩 */
+    val samp2     = Output(UInt(128.W))
+    val samp3     = Output(UInt(128.W))
+    val aconf     = Output(UInt(segs.size.W))  // shape 별 공유 adder 충돌 (E508)
+    val wrs0      = Output(UInt(32.W))    // 진단: shape 0 의 bank 별 accumulator 쓰기 횟수
+    val dbg0      = Output(UInt(64.W))    // 진단: shape 0 의 ss_dbg
+  })
+
+  val units = segs.indices.map(i => Module(new SSExecUnit(
+    rows, cols, maxSeg, i, K, 0 until segs(i), M, N, if (sab == 1 && i == 0) 1 else 0, rowFloor, accMode, spKBOv, t0Pad, issueOrder)))
+
+  // 절대 golden. A 와 B 의 정의는 SSExecUnit 의 fill 과 같아야 한다.
+  //   A[i][k] : bank 0, row i, lane k
+  //   B[k][n] : bank 1+s, row p*kStride+k, lane c  (논리 열 n = p*width + s*cols + c)
+  def gA(i: Int, k: Int): Int = if (i < M && k < K) (i + 2 * k) % 7 - 3 else 0
+  def gB(k: Int, n: Int): Int = if (k < K) (3 * k + n) % 5 - 2 else 0
+  def gold(i: Int, n: Int): Int = (0 until K).map(k => gA(i, k) * gB(k, n)).sum
+  /** shape index `si` 가 첫 chunk 만 계산했다면 나올 값 (K 대신 h 까지만 더한다) */
+  def goldFirstChunk(si: Int, i: Int, n: Int): Int = {
+    val h = rows / segs(si)
+    (0 until math.min(K, h)).map(k => gA(i, k) * gB(k, n)).sum
+  }
+  /** chunk t 가 chunk max(t-1,0) 의 가중치를 쓴 경우 */
+  def goldStale(si: Int, i: Int, n: Int): Int = {
+    val h = rows / segs(si)
+    val ch = math.max(1, K / h)
+    (0 until ch).flatMap(tt => (0 until h).map { j =>
+      val kA = tt * h + j
+      val kB = math.max(tt - 1, 0) * h + j
+      if (kA < K && kB < K) gA(i, kA) * gB(kB, n) else 0
+    }).sum
+  }
+
+  /** 규약 후보 넷. accumulator 행 `row` 에 무엇이 들어 있어야 하는가:
+    *   0 = C[row][n]                  (그대로)
+    *   1 = C[M-1-row][n]              (출력 행 역순 — E448 이 본 증상)
+    *   2 = sum_k A[k][row]*B[k][n]    (A 가 전치되어 있다)
+    *   3 = 1 과 2 를 함께
+    */
+  def cand(c: Int, row: Int, n: Int): Int = c match {
+    case 0 => gold(row, n)
+    case 1 => gold(M - 1 - row, n)
+    case 2 => (0 until K).map(k => gA(k, row) * gB(k, n)).sum
+    case _ => (0 until K).map(k => gA(k, M - 1 - row) * gB(k, n)).sum
+  }
+
+  /** where shape index `i` keeps logical C[row][n] */
+  def at(i: Int, row: Int, n: Int) = {
+    val S = segs(i); val width = cols * S
+    val p = n / width; val s = (n % width) / cols; val c = n % cols
+    units(i).io.acc(s)(p * M + row)(c)
+  }
+
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val bad = RegInit(VecInit(Seq.fill(segs.size)(false.B)))
+  val cnt = RegInit(0.U(16.W)); val nz = RegInit(false.B)
+  val gb = RegInit(false.B); val gcnt = RegInit(0.U(16.W))
+  val convBad = RegInit(VecInit(Seq.fill(4)(false.B)))
+  when (cyc === chkAt.U) {
+    cnt := (segs.size * M * N).U
+    gcnt := (M * N).U
+    for (i <- segs.indices; row <- 0 until M; n <- 0 until N) {
+      when (at(i, row, n) =/= at(0, row, n)) { bad(i) := true.B }
+      when (at(0, row, n) =/= 0.S) { nz := true.B }
+    }
+    for (row <- 0 until M; n <- 0 until N) {
+      val g = (if (sab == 2) gold(row, n) + 1 else gold(row, n))
+      when (at(0, row, n) =/= g.S(32.W)) { gb := true.B }
+      for (cix <- 0 until 4)
+        when (at(0, row, n) =/= cand(cix, row, n).S(32.W)) { convBad(cix) := true.B }
+    }
+  }
+  io.xmismatch := Cat(bad.reverse); io.checked := cnt; io.nonzero := nz
+  val partBad = RegInit(VecInit(Seq.fill(4)(true.B)))
+  when (cyc === chkAt.U) {
+    for (si <- segs.indices) {
+      val anyBad = (0 until M).flatMap(row => (0 until N).map(n =>
+        at(si, row, n) =/= goldFirstChunk(si, row, n).S(32.W))).reduce(_ || _)
+      partBad(si) := anyBad
+    }
+  }
+  io.gpart := Cat(partBad.reverse.map(!_))   // 1 = 첫 chunk 만 계산한 값과 같다
+  val staleBad = RegInit(VecInit(Seq.fill(4)(true.B)))
+  when (cyc === chkAt.U) {
+    for (si <- segs.indices) {
+      val anyBad = (0 until M).flatMap(row => (0 until N).map(n =>
+        at(si, row, n) =/= goldStale(si, row, n).S(32.W))).reduce(_ || _)
+      staleBad(si) := anyBad
+    }
+  }
+  io.gstale := Cat(staleBad.reverse.map(!_))
+  io.gbad := gb; io.gchecked := gcnt
+  io.gconv := Cat(convBad.reverse.map(!_))   // 1 = 그 규약이 맞다
+  // 실제 accumulator 값 8개 (16비트씩). row/n = (0,0) (0,1) (0,2) (1,0) (2,0) (3,0) (0,16) (0,17)
+  io.dbg0 := units(0).io.dbgL
+  // maxSeg 가 4 미만이면 wrs 가 그만큼 짧다 (E471)
+  io.wrs0 := Cat((0 until 4).reverse.map(i =>
+    if (i < units(0).io.wrs.length) units(0).io.wrs(i) else 0.U(8.W)))
+  io.samp := Cat(at(0,0,17)(15,0), at(0,0,16)(15,0), at(0,3,0)(15,0), at(0,2,0)(15,0),
+                 at(0,1,0)(15,0), at(0,0,2)(15,0),  at(0,0,1)(15,0), at(0,0,0)(15,0))
+  io.aconf := Cat(units.map(_.io.aconf).reverse)
+  // E523: 창을 마지막 64 열로 — 손상이 스트림 끝에 붙으므로 (N < 64 면 처음부터)
+  io.badmap := Cat((0 until 64).reverse.map(j => {
+    val n = if (N >= 64) N - 64 + j else j
+    if (n < N) at(0, 0, n) =/= gold(0, n).S(32.W) else false.B
+  }))
+  io.samp2 := Cat((0 until 8).reverse.map(j => at(0, 0, N - 16 + j)(15, 0)))
+  io.samp3 := Cat((0 until 8).reverse.map(j => at(0, 0, N - 8 + j)(15, 0)))
+}
+
+object ShapeshiftExecXMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-x"
+  val r  = if (args.length > 1) args(1).toInt else 16
+  val c  = if (args.length > 2) args(2).toInt else 16
+  val ms = if (args.length > 3) args(3).toInt else 4
+  val mm = if (args.length > 4) args(4).toInt else 4
+  val kk = if (args.length > 5) args(5).toInt else 4
+  val nn = if (args.length > 6) args(6).toInt else 64
+  val sb = if (args.length > 7) args(7).toInt else 0
+  val rf = if (args.length > 8) args(8).toInt else 4
+  val ra = if (args.length > 9) args(9).toInt else 0   // 0=fake acc, 1=real+shared(stock), 2=real+per-bank(수정)
+  val sk = if (args.length > 10) args(10).toInt else 0  // scratchpad KB override (0=자동)
+  val ck = if (args.length > 11) args(11).toInt else 600 // 검사 발화 시각 (E520: 고정 600 이 대형 칸에서 마감 아티팩트)
+  val tp = if (args.length > 12) args(12).toInt else 0   // T0 지연 (E525)
+  val io_ = if (args.length > 13) args(13).toInt else 0  // 0=tile-major, 1=chunk-major (E528)
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftExecXTop(r, c, ms, mm, kk, nn, sb, rf, ra, sk, ck, tp, io_),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftExecXTop(M=$mm K=$kk N=$nn sab=$sb) into $dir")
+}
+
+/**
+  * RUNTIME SHAPE SWITCHING — the feature this whole track exists for.
+  *
+  * Every test up to E481 elaborated one instance per shape. That verifies each
+  * shape in isolation but says nothing about the thing the design is named after:
+  * changing shape **between matmuls on one accelerator**.
+  *
+  * One `ExecuteController`, two phases:
+  *     config_ex(shape A) ; solve (M,K,N) into accumulator rows [0, R)
+  *     config_ex(shape B) ; solve the SAME (M,K,N) into rows [R, R+R')
+  * Both phases are then compared against the same absolute Scala golden. If the
+  * shape latch leaks across the boundary, or if the second phase reuses the first
+  * one's tiling, the second block is wrong.
+  *
+  * The B layout differs per shape (segment `s` of shape `S` owns logical columns
+  * `p*cols*S + s*cols ..`), so each phase gets its own scratchpad row range.
+  */
+class SSExecSwitch(rows: Int = 16, cols: Int = 16, maxSeg: Int = 4,
+                   shapeA: Int = 0, shapeB: Int = 2,
+                   M: Int = 4, K: Int = 4, N: Int = 64, sab: Int = 0,
+                   accMode: Int = 0, readDelayOv: Int = 0) extends Module {
+  import ShapeshiftExecParams.p
+  import GemminiISA._
+
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val SA = segs(shapeA); val SB = segs(shapeB)
+  val hA = rows / SA;    val hB = rows / SB
+  val wA = cols * SA;    val wB = cols * SB
+  val tA = math.max(1, (N + wA - 1) / wA); val tB = math.max(1, (N + wB - 1) / wB)
+  val cA = math.max(1, (K + hA - 1) / hA); val cB = math.max(1, (K + hB - 1) / hB)
+  val ksA = math.max(hA, 4); val ksB = math.max(hB, 4)
+  val bRowsA = tA * cA * ksA          // phase A 가 쓰는 scratchpad 행 수
+  val accA = tA * M                   // phase A 가 쓰는 accumulator 행 수
+
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = false,
+    acc_banks = maxSeg, sp_banks = if (maxSeg >= 8) 16 else 8,
+    sp_capacity = CapacityInKilobytes(32), acc_capacity = CapacityInKilobytes(32))   // 두 phase 의 B 와 C 를 다 담아야 한다 (M=16 이면 96 행)
+
+  val io = IO(new Bundle {
+    val badA = Output(Bool())      // phase A 가 golden 과 어긋나나
+    val badB = Output(Bool())      // phase B 가 golden 과 어긋나나
+    val checked = Output(UInt(16.W))
+    val nonzero = Output(Bool())
+    val cycA    = Output(UInt(16.W))   // 첫 work 명령 -> phase A 의 마지막 쓰기
+    val cycAll  = Output(UInt(16.W))   // 첫 work 명령 -> phase B 의 마지막 쓰기
+  })
+
+  val ex = Module(new ExecuteController(64, 32, cfg)(p, implicitly[Arithmetic[chisel3.SInt]]))
+  val ACCR = 128        // M=16 이면 두 phase 합쳐 96 행 (E489)
+  val maxLanes = cols * segs.max
+
+  def aVal(i: Int, k: Int): Int = if (i < M && k < K) (i + 2 * k) % 7 - 3 else 0
+  def bCol(k: Int, n: Int): Int = if (k < K) (3 * k + n) % 5 - 2 else 0
+  def gold(i: Int, n: Int): Int = (0 until K).map(k => aVal(i, k) * bCol(k, n)).sum
+
+  // ---- scratchpad: 진짜 bank ----
+  val banks = Seq.fill(cfg.sp_banks)(Module(new ScratchpadBank(
+    cfg.sp_bank_entries, cfg.sp_width, cfg.aligned_to, cfg.sp_singleported, false, false)))
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+
+  // A 는 두 phase 가 공유한다 (chunk 조각이 h 마다 다르므로 phase 별로 둔다)
+  val aRowsA = cA * M; val aRowsB = cB * M
+  val TFILL = 4
+  val NFILL = aRowsA + aRowsB + bRowsA + tB * cB * ksB
+  val filling = cyc >= TFILL.U && cyc < (TFILL + NFILL).U
+  val fi = (cyc - TFILL.U)(9, 0)
+
+  for ((bk, bi) <- banks.zipWithIndex) {
+    /** E551: SoC 의 EC 읽기 응답은 Scratchpad 모듈에서 `Pipeline(ex_read_resp,
+      * spad_read_delay=4)` 를 지난다 (Scratchpad.scala:497) — 하네스는 줄곧 뱅크
+      * 직결(지연 0)이었다. readDelayOv > 0 이면 같은 파이프를 답습해 SoC 타이밍을
+      * 재현한다. 기본 0 은 기존 셀과 바이트 동일. */
+    bk.io.read.req <> ex.io.srams.read(bi).req
+    if (readDelayOv > 0) ex.io.srams.read(bi).resp <> Pipeline(bk.io.read.resp, readDelayOv)
+    else ex.io.srams.read(bi).resp <> bk.io.read.resp
+    // bank 0: phase A 의 A (행 0..aRowsA-1), 그 뒤 phase B 의 A
+    // bank 1+s: phase A 의 B (행 0..bRowsA-1), 그 뒤 phase B 의 B
+    val wdata = Wire(UInt(cfg.sp_width.W))
+    val waddr = Wire(UInt(log2Up(cfg.sp_bank_entries).W))
+    val wen   = Wire(Bool())
+    if (bi == 0) {
+      wen := filling && fi < (aRowsA + aRowsB).U
+      waddr := fi
+      wdata := Cat((0 until cols).reverse.map { j =>
+        MuxLookup(fi, 0.S(8.W))((0 until aRowsA + aRowsB).map { a =>
+          val (hh, base) = if (a < aRowsA) (hA, 0) else (hB, aRowsA)
+          val tt = (a - base) / M; val i = (a - base) % M
+          a.U -> (if (j < hh) aVal(i, tt * hh + j) else 0).S(8.W)
+        }).asUInt })
+    } else {
+      val s = bi - 1
+      val off = aRowsA + aRowsB
+      wen := filling && fi >= off.U && fi < NFILL.U
+      waddr := fi - off.U
+      wdata := Cat((0 until cols).reverse.map { c =>
+        MuxLookup(fi - off.U, 0.S(8.W))((0 until bRowsA + tB * cB * ksB).map { a =>
+          val (segN, hh, w, ks, base) = if (a < bRowsA) (SA, hA, wA, ksA, 0) else (SB, hB, wB, ksB, bRowsA)
+          val r = a - base; val blk = r / ks; val k = r % ks
+          val pp = blk / (if (a < bRowsA) cA else cB); val tt = blk % (if (a < bRowsA) cA else cB)
+          a.U -> (if (s < segN && k < hh) bCol(tt * hh + k, pp * w + s * cols + c + (if (sab == 1 && a >= bRowsA) 1 else 0)) else 0).S(8.W)
+        }).asUInt })
+    }
+    bk.io.write.en   := Mux(filling, wen, ex.io.srams.write(bi).en)
+    bk.io.write.addr := Mux(filling, waddr, ex.io.srams.write(bi).addr)
+    bk.io.write.data := Mux(filling, wdata, ex.io.srams.write(bi).data)
+    bk.io.write.mask := Mux(filling, VecInit(Seq.fill(bk.mask_len)(true.B)), ex.io.srams.write(bi).mask)
+  }
+
+  // ---- accumulator capture (accMode: 0 = 가짜 지연0, 2 = 진짜 AccumulatorMem + per-bank adder.
+  //      E508 이후 정확성 최종 판정은 accMode=2 로만 한다. E511 에서 배선.) ----
+  val accMem = Reg(Vec(maxSeg, Vec(ACCR, Vec(cols, SInt(32.W)))))
+  if (accMode == 0) {
+    for (i <- 0 until cfg.acc_banks) {
+      ex.io.acc.read_req(i).ready := true.B
+      ex.io.acc.read_resp(i).valid := false.B
+      ex.io.acc.read_resp(i).bits := DontCare
+      ex.io.acc.write(i).ready := true.B
+      when (ex.io.acc.write(i).fire) {
+        // 뱅크 수가 늘면 뱅크당 행이 줄어 addr 폭도 준다 (maxSeg=8 이면 5 비트).
+        // ACCR 로 고정 슬라이스하면 폭을 넘는다 — 실제 폭과 min 을 취한다 (E494).
+        val ad = ex.io.acc.write(i).bits.addr(
+          math.min(log2Up(ACCR), ex.io.acc.write(i).bits.addr.getWidth) - 1, 0)
+        for (c <- 0 until cols) {
+          val nw = ex.io.acc.write(i).bits.data(c)(0)
+          accMem(i)(ad)(c) := Mux(ex.io.acc.write(i).bits.acc, accMem(i)(ad)(c) + nw, nw)
+        }
+      }
+    }
+  } else {
+    val accRowT = Vec(cols, Vec(1, cfg.accType))
+    val abanks = Seq.fill(cfg.acc_banks) { Module(new AccumulatorMem(
+      cfg.acc_bank_entries, accRowT, cfg.acc_scale_func,
+      cfg.acc_scale_t.asInstanceOf[Float], cfg.acc_singleported, cfg.acc_sub_banks,
+      false, cfg.acc_latency, cfg.accType, false)) }
+    for (i <- 0 until cfg.acc_banks) {
+      val b = abanks(i)
+      b.io.write <> ex.io.acc.write(i)
+      val own = Module(new AccPipeShared(cfg.acc_latency - 1, accRowT, 1))
+      own.io.in_sel(0) := b.io.adder.valid
+      own.io.ina(0) := b.io.adder.op1
+      own.io.inb(0) := b.io.adder.op2
+      b.io.adder.sum := own.io.out
+      ex.io.acc.read_resp(i).valid := false.B
+      ex.io.acc.read_resp(i).bits := DontCare
+      ex.io.acc.read_req(i).ready := false.B
+    }
+    // readback: 두 phase 가 다 끝난 뒤(TRB) 뱅크에서 회수해 기존 검사(cyc===900)를 그대로 쓴다
+    val TRB = 700
+    val rbIssue = RegInit(0.U(log2Up(ACCR + 1).W))
+    val rbGot   = RegInit(0.U(log2Up(ACCR + 1).W))
+    val nBack = ACCR
+    val rbOn = cyc >= TRB.U && rbIssue < nBack.U
+    for (i <- 0 until cfg.acc_banks) {
+      val b = abanks(i)
+      b.io.read.req.valid := rbOn
+      b.io.read.req.bits := DontCare
+      b.io.read.req.bits.addr := rbIssue
+      b.io.read.req.bits.full := true.B
+      b.io.read.req.bits.act := 0.U
+      b.io.read.req.bits.fromDMA := false.B
+      b.io.read.resp.ready := true.B
+      when (b.io.read.resp.valid) {
+        for (c <- 0 until cols) { accMem(i)(rbGot)(c) := b.io.read.resp.bits.data(c)(0) }
+      }
+    }
+    when (rbOn && abanks(0).io.read.req.ready) { rbIssue := rbIssue + 1.U }
+    when (abanks(0).io.read.resp.valid) { rbGot := rbGot + 1.U }
+  }
+  ex.io.im2col.req.ready := true.B
+  ex.io.im2col.resp.valid := false.B
+  ex.io.im2col.resp.bits := DontCare
+  ex.io.counter := DontCare
+
+  // ---- 명령: config_ex(A) + phase A, config_ex(B) + phase B ----
+  def addr(bank: Int, row: Int): BigInt = BigInt(bank) * cfg.sp_bank_entries + row
+  def rc(r: Int, c: Int, a: BigInt): BigInt = (BigInt(r) << 48) | (BigInt(c) << 32) | a
+  def cfgCmd(sh: Int) = (CONFIG_CMD,
+    (BigInt(1) << 2) | (BigInt(sh) << ShapeshiftISA.SHAPE_LO) | (BigInt(1) << 16), BigInt(1) << 48)
+  def phase(sh: Int, S: Int, hh: Int, w: Int, nt: Int, ch: Int, ks: Int,
+            bBase: Int, aBase: Int, accBase: Int) =
+    (0 until nt).flatMap { pp => (0 until ch).flatMap { tt => Seq(
+      (PRELOAD_CMD, rc(math.min(hh, K - tt * hh), cols, addr(1, bBase + (pp * ch + tt) * ks)),
+                    rc(M, cols, (BigInt(1) << 31) | (if (tt > 0) BigInt(1) << 30 else 0) | BigInt(accBase + pp * M))),
+      (COMPUTE_AND_FLIP_CMD, rc(M, math.min(hh, K - tt * hh), addr(0, aBase + tt * M)),
+                             BigInt("ffffffff", 16))) } }
+
+  val issue: Seq[(UInt, BigInt, BigInt)] =
+    Seq(cfgCmd(shapeA)) ++ phase(shapeA, SA, hA, wA, tA, cA, ksA, 0, 0, 0) ++
+    Seq(cfgCmd(if (sab == 2) shapeA else shapeB)) ++
+    phase(shapeB, SB, hB, wB, tB, cB, ksB, bRowsA, aRowsA, accA)
+
+  val T0 = TFILL + NFILL + 4
+  val ci = RegInit(0.U(10.W))
+  ex.io.cmd.valid := cyc >= T0.U && ci < issue.size.U
+  ex.io.cmd.bits := DontCare
+  ex.io.cmd.bits.cmd.inst.funct := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((f,_,_), k) => k.U -> f })
+  ex.io.cmd.bits.cmd.rs1 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_,a,_), k) => k.U -> a.U(64.W) })
+  ex.io.cmd.bits.cmd.rs2 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_,_,b), k) => k.U -> b.U(64.W) })
+  ex.io.cmd.bits.rob_id.valid := false.B
+  ex.io.cmd.bits.rob_id.bits := 0.U
+  ex.io.cmd.bits.from_matmul_fsm := false.B
+  ex.io.cmd.bits.from_conv_fsm := false.B
+  when (ex.io.cmd.fire) { ci := ci + 1.U }
+
+  // ---- 검사: 두 phase 를 각자의 배치로 golden 과 대조 ----
+  def at(S: Int, accBase: Int, row: Int, n: Int) = {
+    val w = cols * S; val pp = n / w; val s = (n % w) / cols; val c = n % cols
+    accMem(s)(accBase + pp * M + row)(c)
+  }
+  val bA = RegInit(false.B); val bB = RegInit(false.B)
+  val cnt = RegInit(0.U(16.W)); val nz = RegInit(false.B)
+  when (cyc === 900.U) {
+    cnt := (2 * M * N).U
+    for (row <- 0 until M; n <- 0 until N) {
+      when (at(SA, 0, row, n) =/= gold(row, n).S(32.W)) { bA := true.B }
+      when (at(SB, accA, row, n) =/= gold(row, n).S(32.W)) { bB := true.B }
+      if (gold(row, n) != 0) { nz := true.B }
+    }
+  }
+  // phase 는 accumulator 주소로 구분된다: A 는 [0, accA), B 는 [accA, ..)
+  val cT0 = RegInit(0.U(16.W)); val cTA = RegInit(0.U(16.W)); val cTB = RegInit(0.U(16.W))
+  when (ex.io.cmd.fire && ci === 1.U) { cT0 := cyc }
+  val anyW = (0 until cfg.acc_banks).map(i => ex.io.acc.write(i).fire).reduce(_ || _)
+  val wAddr = MuxCase(0.U, (0 until cfg.acc_banks).map(i =>
+    ex.io.acc.write(i).fire -> ex.io.acc.write(i).bits.addr(
+      math.min(log2Up(ACCR), ex.io.acc.write(i).bits.addr.getWidth) - 1, 0)))
+  when (anyW && wAddr < accA.U) { cTA := cyc }
+  when (anyW) { cTB := cyc }
+  io.cycA := cTA - cT0; io.cycAll := cTB - cT0
+
+  io.badA := bA; io.badB := bB; io.checked := cnt; io.nonzero := nz
+}
+
+object ShapeshiftSwitchMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-sw"
+  val r  = if (args.length > 1) args(1).toInt else 16
+  val c  = if (args.length > 2) args(2).toInt else 16
+  val ms = if (args.length > 3) args(3).toInt else 4
+  val sA = if (args.length > 4) args(4).toInt else 0
+  val sB = if (args.length > 5) args(5).toInt else 2
+  val sb = if (args.length > 6) args(6).toInt else 0
+  val mm = if (args.length > 7) args(7).toInt else 4
+  val kk = if (args.length > 8) args(8).toInt else 4
+  val nn = if (args.length > 9) args(9).toInt else 64
+  val am = if (args.length > 10) args(10).toInt else 0
+  (new chisel3.stage.ChiselStage).emitVerilog(new SSExecSwitch(r, c, ms, sA, sB, mm, kk, nn, sb, am),
+    Array("--target-dir", dir))
+  println(s"emitted SSExecSwitch(shapeA=$sA shapeB=$sB sab=$sb) into $dir")
+}
+
+/**
+  * A SEQUENCE of shapes on one accelerator — the realistic usage pattern.
+  *
+  * E482/E484 verified a single switch. A network changes shape per layer, so the
+  * MLIR pass emits a `config_ex` per matmul: what matters is that repeated
+  * switching stays correct and that the 1-cycle cost does not accumulate.
+  *
+  * Every phase solves the SAME (M,K,N) into its own accumulator region, with its
+  * own scratchpad region for A and B (both layouts depend on the shape). All are
+  * compared against one absolute Scala golden.
+  */
+class SSExecSeqShapes(rows: Int = 16, cols: Int = 16, maxSeg: Int = 4,
+                      shapeSeq: Seq[Int] = Seq(0, 2, 1, 0),
+                      M: Int = 4, K: Int = 4, N: Int = 64, sab: Int = 0,
+                      rowFloor: Int = 4, spBanksOv: Int = 0,
+                      readDelayOv: Int = 0, accModeOv: Int = 0,
+                      chkAtOv: Int = 3000) extends Module {
+  import ShapeshiftExecParams.p
+  import GemminiISA._
+
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val nPh = shapeSeq.size
+  case class Ph(sh: Int, S: Int, h: Int, w: Int, t: Int, c: Int, ks: Int,
+                aOff: Int, bOff: Int, accOff: Int)
+  val phases: Seq[Ph] = {
+    var aO = 0; var bO = 0; var cO = 0
+    shapeSeq.map { sh =>
+      val S = segs(sh); val h = rows / S; val w = cols * S
+      val t = math.max(1, (N + w - 1) / w); val c = math.max(1, (K + h - 1) / h)
+      val ks = math.max(h, 4)
+      val p = Ph(sh, S, h, w, t, c, ks, aO, bO, cO)
+      aO += c * M; bO += t * c * ks; cO += t * M
+      p
+    }
+  }
+  val aTot = phases.map(p => p.c * M).sum
+  val bTot = phases.map(p => p.t * p.c * p.ks).sum
+
+  /** E543: maxSeg=16 은 B 가 뱅크 1..16 을 쓰므로 (뱅크 0 은 A) 17개가 필요하다 —
+    * 2의 거듭제곱으로 32. sp_capacity 산식과 같이 움직여야 하므로 val 로 묶는다. */
+  private val spBanksN = if (spBanksOv > 0) spBanksOv
+    else if (maxSeg >= 16) 32 else if (maxSeg >= 8) 16 else 8
+  /** E550: SoC(sp_banks=4)에서 S=4 의 B 세그먼트 3 이 `ssBank` wrap 으로 뱅크 0(=A)에
+    * 들어간다 — 보드에서 wedge 를 낸 미검 케이스. spBanksOv 로 뱅크 수를 강제하고,
+    * wrap 이면 뱅크 0 fill 이 A 와 B seg(spBanksN-1) 를 함께 싣는다. B 행은 bRowBase 로
+    * 띄워 A 와 분리한다. 오버라이드가 없으면 bRowBase=0 — 기존 셀은 바이트 동일. */
+  private val ssWrap = spBanksN <= maxSeg
+  private val bRowBase = if (ssWrap) 256 else 0
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = false,
+    shapeshift_row_floor = rowFloor,   // E534: 바닥 2 전환 격자용
+    acc_banks = maxSeg, sp_banks = spBanksN,
+    // E537: acc 뱅크 행수는 rows 의 배수여야 한다 (stock require). 16 KB 는 32x32 ms8 에서
+    // 뱅크당 16행이라 걸린다 — 기하에 맞춰 키우되 기존 실험 기하(16x16/8x8)는 16 KB 유지.
+    // sp 도 같은 함정 (네 번째 — E489/E494/E519): fill 의 waddr 와 issue 의
+    // addr(bank,row) 모두 뱅크당 행수를 전제하므로, bOff 누적(최대 ~192행)이 넘지 않게
+    // 뱅크당 256행을 유지한다. 16x16/8x8 은 기존 32 KB 그대로.
+    // E558(용량 함정 #6): 뱅크당 256행 고정(E537)은 그때 격자(bTot<=192)의 상수였다.
+    // K=64 격자는 bTot=768 — fill 은 mod 256 wrap 으로 앞 phase 의 B 를 덮고, issue 는
+    // 행 256+ 를 다음 뱅크로 보냈다(빈 뱅크 -> 0). 행수를 격자 요구량으로 스케일한다.
+    sp_capacity = CapacityInKilobytes(math.max(32,
+      spBanksN * cols * math.max(256, Integer.highestOneBit(
+        math.max(1, bRowBase + bTot - 1)) * 2) / 1024)),
+    // E539(용량 함정 #5): acc 창(accOff 누적, 최대 ~36행)이 뱅크당 행수를 넘으면 EC 의
+    // bank/row 분할이 다음 뱅크로 굴러 들어간다 (E538 트레이스에서 rows 32..35 -> bank1
+    // rows 0..3 실측). 뱅크당 64행을 유지한다 — 16x16/8x8 ms4 는 기존 16 KB 그대로.
+    acc_capacity = CapacityInKilobytes(math.max(16, maxSeg * 64 * cols * 4 / 1024)))
+
+  val io = IO(new Bundle {
+    val bad     = Output(UInt(8.W))     // phase 별 golden 불일치
+    val checked = Output(UInt(16.W))
+    val nonzero = Output(Bool())
+    val cycles  = Output(UInt(16.W))    // 첫 work 명령 -> 마지막 accumulator 쓰기
+    val phEnd   = Output(UInt(64.W))    // phase 별 끝 사이클 (16비트 x 4, 아래부터)
+  })
+
+  val ex = Module(new ExecuteController(64, 32, cfg)(p, implicitly[Arithmetic[chisel3.SInt]]))
+  val ACCR = 64
+
+  def aVal(i: Int, k: Int): Int = if (i < M && k < K) (i + 2 * k) % 7 - 3 else 0
+  def bCol(k: Int, n: Int): Int = if (k < K) (3 * k + n) % 5 - 2 else 0
+  def gold(i: Int, n: Int): Int = (0 until K).map(k => aVal(i, k) * bCol(k, n)).sum
+
+  val banks = Seq.fill(cfg.sp_banks)(Module(new ScratchpadBank(
+    cfg.sp_bank_entries, cfg.sp_width, cfg.aligned_to, cfg.sp_singleported, false, false)))
+  // E570 FakeLoad 의 bank0 쓰기 배선 (구동은 아래 FakeLoad FSM — 선언은 뱅크 루프보다 앞)
+  val flWrEn = WireInit(false.B)
+  val flWrAddr = Wire(UInt(log2Up(cfg.sp_bank_entries).W)); flWrAddr := DontCare
+  val flWrData = Wire(UInt(cfg.sp_width.W)); flWrData := DontCare
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val TFILL = 4
+  val NFILL = aTot + bTot
+  val filling = cyc >= TFILL.U && cyc < (TFILL + NFILL).U
+  val fi = (cyc - TFILL.U)(11, 0)
+
+  for ((bk, bi) <- banks.zipWithIndex) {
+    /** E551: SoC 의 EC 읽기 응답은 Scratchpad 모듈에서 `Pipeline(ex_read_resp,
+      * spad_read_delay=4)` 를 지난다 (Scratchpad.scala:497) — 하네스는 줄곧 뱅크
+      * 직결(지연 0)이었다. readDelayOv > 0 이면 같은 파이프를 답습해 SoC 타이밍을
+      * 재현한다. 기본 0 은 기존 셀과 바이트 동일. */
+    bk.io.read.req <> ex.io.srams.read(bi).req
+    if (readDelayOv > 0) ex.io.srams.read(bi).resp <> Pipeline(bk.io.read.resp, readDelayOv)
+    else ex.io.srams.read(bi).resp <> bk.io.read.resp
+    val wen = Wire(Bool()); val waddr = Wire(UInt(log2Up(cfg.sp_bank_entries).W))
+    val wdata = Wire(UInt(cfg.sp_width.W))
+    def aFill: UInt = Cat((0 until cols).reverse.map { j =>
+      MuxLookup(fi, 0.S(8.W))((0 until aTot).map { a =>
+        val ph = phases.filter(_.aOff <= a).last
+        val tt = (a - ph.aOff) / M; val i = (a - ph.aOff) % M
+        a.U -> (if (j < ph.h) aVal(i, tt * ph.h + j) else 0).S(8.W)
+      }).asUInt })
+    def bFill(s: Int): UInt = Cat((0 until cols).reverse.map { c =>
+      MuxLookup(fi - aTot.U, 0.S(8.W))((0 until bTot).map { a =>
+        val ph = phases.filter(_.bOff <= a).last
+        val r = a - ph.bOff; val blk = r / ph.ks; val k = r % ph.ks
+        val pp = blk / ph.c; val tt = blk % ph.c
+        val shift = if (sab == 1 && ph == phases.last) 1 else 0
+        a.U -> (if (s < ph.S && k < ph.h) bCol(tt * ph.h + k, pp * ph.w + s * cols + c + shift) else 0).S(8.W)
+      }).asUInt })
+    if (bi == 0) {
+      // E550: wrap 이면 뱅크 0 이 A 와 B seg(spBanksN-1) 를 겸한다 (행 영역 분리)
+      wen := filling && (fi < aTot.U || (ssWrap.B && fi >= aTot.U && fi < NFILL.U))
+      waddr := Mux(fi < aTot.U, fi, bRowBase.U + (fi - aTot.U))
+      wdata := Mux(fi < aTot.U, aFill, if (ssWrap) bFill(spBanksN - 1) else 0.U)
+    } else {
+      val s = bi - 1
+      wen := filling && fi >= aTot.U && fi < NFILL.U
+      waddr := bRowBase.U + (fi - aTot.U)
+      wdata := bFill(s)
+    }
+    bk.io.write.en   := Mux(filling, wen, ex.io.srams.write(bi).en)
+    bk.io.write.addr := Mux(filling, waddr, ex.io.srams.write(bi).addr)
+    bk.io.write.data := Mux(filling, wdata, ex.io.srams.write(bi).data)
+    bk.io.write.mask := Mux(filling, VecInit(Seq.fill(bk.mask_len)(true.B)), ex.io.srams.write(bi).mask)
+  }
+
+  val accMem = Reg(Vec(maxSeg, Vec(ACCR, Vec(cols, SInt(32.W)))))
+  if (accModeOv == 0) {
+  for (i <- 0 until cfg.acc_banks) {
+    ex.io.acc.read_req(i).ready := true.B
+    ex.io.acc.read_resp(i).valid := false.B
+    ex.io.acc.read_resp(i).bits := DontCare
+    ex.io.acc.write(i).ready := true.B
+    when (ex.io.acc.write(i).fire) {
+      // 뱅크 수가 늘면 뱅크당 행이 줄어 addr 폭도 준다 (maxSeg=8 이면 5 비트).
+      // ACCR 로 고정 슬라이스하면 폭을 넘는다 — 실제 폭과 min 을 취한다 (E494).
+      val ad = ex.io.acc.write(i).bits.addr(
+        math.min(log2Up(ACCR), ex.io.acc.write(i).bits.addr.getWidth) - 1, 0)
+      for (c <- 0 until cols) {
+        val nw = ex.io.acc.write(i).bits.data(c)(0)
+        accMem(i)(ad)(c) := Mux(ex.io.acc.write(i).bits.acc, accMem(i)(ad)(c) + nw, nw)
+      }
+    }
+  }
+  } else {
+    /** E559b: SeqShapes 의 fake acc 는 `ready := true` 라 실제 AccumulatorMem 의 WAW
+      * 인터록(ready 강하)을 못 본다 — 보드 t2 가설의 판정대. SSExecUnit accMode=2 의
+      * 패턴(진짜 뱅크 + per-bank AccPipeShared + 검사 전 readback)을 이식. */
+    val accRowT = Vec(cols, Vec(1, cfg.accType))
+    val abanks = Seq.fill(cfg.acc_banks) { Module(new AccumulatorMem(
+      cfg.acc_bank_entries, accRowT, cfg.acc_scale_func,
+      cfg.acc_scale_t.asInstanceOf[Float], cfg.acc_singleported, cfg.acc_sub_banks,
+      false, cfg.acc_latency, cfg.accType, false)) }
+    for (i <- 0 until cfg.acc_banks) {
+      val b = abanks(i)
+      b.io.write <> ex.io.acc.write(i)
+      val own = Module(new AccPipeShared(cfg.acc_latency - 1, accRowT, 1))
+      own.io.in_sel(0) := b.io.adder.valid
+      own.io.ina(0) := b.io.adder.op1
+      own.io.inb(0) := b.io.adder.op2
+      b.io.adder.sum := own.io.out
+      ex.io.acc.read_req(i).ready := false.B
+      ex.io.acc.read_resp(i).valid := false.B
+      ex.io.acc.read_resp(i).bits := DontCare
+    }
+    // readback: 검사(cyc 3000) 전에 진짜 뱅크 -> accMem
+    val nBack = math.min(phases.map(p => p.t * M).sum, ACCR)
+    val TRB = chkAtOv - 400
+    val rbIssue = RegInit(0.U(log2Up(ACCR + 1).W))
+    val rbGot = RegInit(0.U(log2Up(ACCR + 1).W))
+    val rbOn = cyc >= TRB.U && rbIssue < nBack.U
+    for (i <- 0 until cfg.acc_banks) {
+      val b = abanks(i)
+      b.io.read.req.valid := rbOn
+      b.io.read.req.bits := DontCare
+      b.io.read.req.bits.addr := rbIssue
+      b.io.read.req.bits.full := true.B
+      b.io.read.req.bits.act := 0.U
+      b.io.read.req.bits.fromDMA := false.B
+      b.io.read.resp.ready := true.B
+      when (b.io.read.resp.valid) {
+        for (c <- 0 until cols) { accMem(i)(rbGot)(c) := b.io.read.resp.bits.data(c)(0) }
+      }
+    }
+    when (rbOn && abanks(0).io.read.req.ready) { rbIssue := rbIssue + 1.U }
+    when (abanks(0).io.read.resp.valid) { rbGot := rbGot + 1.U }
+  }
+  ex.io.im2col.req.ready := true.B
+  ex.io.im2col.resp.valid := false.B
+  ex.io.im2col.resp.bits := DontCare
+  ex.io.counter := DontCare
+
+  def addr(bank: Int, row: Int): BigInt = BigInt(bank) * cfg.sp_bank_entries + row
+  def rc(r: Int, c: Int, a: BigInt): BigInt = (BigInt(r) << 48) | (BigInt(c) << 32) | a
+  val issue: Seq[(UInt, BigInt, BigInt)] = phases.zipWithIndex.flatMap { case (ph, idx) =>
+    val shSent = if (sab == 2 && idx == nPh - 1) phases(idx - 1).sh else ph.sh
+    Seq((CONFIG_CMD, (BigInt(1) << 2) | (BigInt(shSent) << ShapeshiftISA.SHAPE_LO) | (BigInt(1) << 16),
+         BigInt(1) << 48)) ++
+    (0 until ph.t).flatMap { pp => (0 until ph.c).flatMap { tt => Seq(
+      (PRELOAD_CMD, rc(math.min(ph.h, K - tt * ph.h), cols, addr(1, bRowBase + ph.bOff + (pp * ph.c + tt) * ph.ks)),
+                    rc(M, cols, (BigInt(1) << 31) | (if (tt > 0) BigInt(1) << 30 else 0) | BigInt(ph.accOff + pp * M))),
+      (COMPUTE_AND_FLIP_CMD, rc(M, math.min(ph.h, K - tt * ph.h), addr(0, ph.aOff + tt * M)),
+                             BigInt("ffffffff", 16))) } }
+  }
+
+  val T0 = TFILL + NFILL + 4
+  val ci = RegInit(0.U(12.W))
+  ex.io.cmd.valid := cyc >= T0.U && ci < issue.size.U
+  ex.io.cmd.bits := DontCare
+  ex.io.cmd.bits.cmd.inst.funct := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((f,_,_), k) => k.U -> f })
+  ex.io.cmd.bits.cmd.rs1 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_,a,_), k) => k.U -> a.U(64.W) })
+  ex.io.cmd.bits.cmd.rs2 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_,_,b), k) => k.U -> b.U(64.W) })
+  ex.io.cmd.bits.rob_id.valid := false.B
+  ex.io.cmd.bits.rob_id.bits := 0.U
+  ex.io.cmd.bits.from_matmul_fsm := false.B
+  ex.io.cmd.bits.from_conv_fsm := false.B
+  when (ex.io.cmd.fire) { ci := ci + 1.U }
+
+  def at(ph: Ph, row: Int, n: Int) = {
+    val pp = n / ph.w; val s = (n % ph.w) / cols; val c = n % cols
+    accMem(s)(ph.accOff + pp * M + row)(c)
+  }
+  val bad = RegInit(VecInit(Seq.fill(8)(false.B)))
+  val cnt = RegInit(0.U(16.W)); val nz = RegInit(false.B)
+  /** E539: `n < N` 은 N < w 인 접힌 shape 의 상부 세그먼트를 **한 번도 검사하지 않는**
+    * 사각지대였고 (E538), 안 읽힌 accMem 뱅크가 FIRRTL DCE 로 EC 포트째 지워져 트레이스도
+    * 막았다. B 는 fill 이 전 세그먼트에 써 두므로 golden 은 w*t 열 전부에서 유효하다 —
+    * phase 의 전체 폭을 검사한다. */
+  /** E558: 고정 1400 은 K=4 격자용이었다 — K=64 셀은 그 시점에 아직 쓰는 중이라
+    * "미완료" 가 "불일치" 로 읽혔다 (검사기 자신이 네 번째로 잘못 가리킨 사례).
+    * 3000 이면 오늘 격자 전부의 완료 뒤다. tb 는 3200+ 사이클을 돌아야 한다. */
+  when (cyc === chkAtOv.U) {
+    cnt := phases.map(ph => ph.w * ph.t * M).sum.U
+    for ((ph, idx) <- phases.zipWithIndex; row <- 0 until M; n <- 0 until ph.w * ph.t) {
+      when (at(ph, row, n) =/= gold(row, n).S(32.W)) { bad(idx) := true.B }
+      if (gold(row, n) != 0) { nz := true.B }
+    }
+  }
+  // phase 별 끝 사이클: accumulator 주소 구간으로 가른다
+  val cT0 = RegInit(0.U(16.W)); val ends = RegInit(VecInit(Seq.fill(4)(0.U(16.W))))
+  when (ex.io.cmd.fire && ci === 1.U) { cT0 := cyc }
+  val anyW = (0 until cfg.acc_banks).map(i => ex.io.acc.write(i).fire).reduce(_ || _)
+  val wAddr = MuxCase(0.U, (0 until cfg.acc_banks).map(i =>
+    ex.io.acc.write(i).fire -> ex.io.acc.write(i).bits.addr(
+      math.min(log2Up(ACCR), ex.io.acc.write(i).bits.addr.getWidth) - 1, 0)))
+  for ((ph, idx) <- phases.zipWithIndex) {
+    val hi = ph.accOff + ph.t * M
+    when (anyW && wAddr >= ph.accOff.U && wAddr < hi.U) { ends(idx) := cyc - cT0 }
+  }
+  io.bad := Cat(bad.reverse); io.checked := cnt; io.nonzero := nz
+  io.cycles := ends(nPh - 1)
+  io.phEnd := Cat(ends.reverse)
+}
+
+object ShapeshiftSeqShapesMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-seq"
+  val sab = if (args.length > 1) args(1).toInt else 0
+  // E534: 시퀀스·기하·바닥을 인자로 — 바닥 2 전환 격자의 동일 문맥(가운데 phase) 측정용
+  val r   = if (args.length > 2) args(2).toInt else 16
+  val c   = if (args.length > 3) args(3).toInt else 16
+  val ms  = if (args.length > 4) args(4).toInt else 4
+  val sq  = if (args.length > 5) args(5).split(",").map(_.toInt).toSeq else Seq(0, 2, 1, 0)
+  val mm  = if (args.length > 6) args(6).toInt else 4
+  val kk  = if (args.length > 7) args(7).toInt else 4
+  val nn  = if (args.length > 8) args(8).toInt else 64
+  val rf  = if (args.length > 9) args(9).toInt else 4
+  val sbv = if (args.length > 10) args(10).toInt else 0
+  val rdv = if (args.length > 11) args(11).toInt else 0
+  val amv = if (args.length > 12) args(12).toInt else 0
+  val cka = if (args.length > 13) args(13).toInt else 3000
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new SSExecSeqShapes(r, c, ms, sq, mm, kk, nn, sab, rf, sbv, rdv, amv, cka), Array("--target-dir", dir))
+  println(s"emitted SSExecSeqShapes(seq=$sq, floor=$rf, sab=$sab) into $dir")
+}
+/**
+  * E564: ReservationStation-in-the-loop — 보드와 검증된 EC 하네스 사이의 마지막 미모델 층.
+  *
+  * 보드 규칙(E563): "mvout 뒤 연속 matmul 은 16개까지만 acc 착지, 17번째부터 소실.
+  * fence 는 리셋 안 함, mvout 이 리셋." 16 = reservation_station_entries_ex. 그런데
+  * SeqShapes 는 줄곧 rob_id.valid=false 로 EC 에 명령을 넣었으므로 **EC 의 completion
+  * 경로(pending_completed_rob_ids, mesh resp tag)와 RS 의 의존 추적·엔트리 해제는 시뮬에서
+  * 한 번도 돌지 않았다**. 이 하네스가 그 층을 연다:
+  *
+  *     cmd ROM ─ alloc ─▶ RS ─ issue.ex ─▶ EC(+rob_id) ─ completed ─┐
+  *                        ▲  └ issue.st ─▶ FakeStore ── completed ──┴▶ RS.completed
+  *                        └──────────── (fence: busy 소진 대기) ─────────┘
+  *
+  * FakeStore 는 mvout 을 "발행 stDelay 사이클 뒤 진짜 AccumulatorMem 읽기"로 모델한다 —
+  * 보드의 StoreController acc 읽기의 자리. 캡처값(capT)과 chkAt 시점의 acc 실체(accT)를
+  * 따로 내므로, 보드가 구분 못 한 "소실"(영원히 안 씀)과 "경주"(mvout 이 이르게 읽음)를
+  * 여기서는 가른다. 사전등록: experiments/model/PREREG_E564.txt.
+  *
+  * 미모델 잔여층 (여기까지 깨끗하면 거기가 용의선): Scratchpad glue(acc read/write 중재,
+  * AccumulatorScale), DMA/TLB, frontend 큐(raw_cmd_q/unrolled), LoopMatmul.
+  */
+class SSExecRS(rows: Int = 16, cols: Int = 16, maxSeg: Int = 4,
+               shapeIdx: Int = 2, T: Int = 17, M: Int = 1,
+               preSt: Int = 1, fenceEvery: Int = 0, freshLast: Int = 0,
+               stDelay: Int = 50, sab: Int = 0,
+               spBanksOv: Int = 4, readDelayOv: Int = 4, strideLogRS: Int = 0,
+               strideIsaOv: Int = -1,   /* E624d: 음성 대조용 — ISA stride 를 채움과 다르게 */
+               chkAt: Int = 3000, spGlue: Int = 0, stAt: Int = -1,
+               ldN: Int = 0, ldDelay: Int = 60, reps: Int = 1) extends Module {
+  import ShapeshiftExecParams.p
+  import GemminiISA._
+
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val S = segs(shapeIdx); val h = rows / S; val ks = math.max(h, 4)
+  val K = T * h; val w = cols * S           // N = w — N 타일 하나 (보드 Q 프로브와 동일)
+  private val spBanksN = if (spBanksOv > 0) spBanksOv else if (maxSeg >= 8) 16 else 8
+  private val ssWrap = spBanksN <= maxSeg   // 보드(sp_banks=4)와 같이 seg S-1 이 뱅크 0 으로 감긴다
+  private val bRowBase = if (ssWrap) 256 else 0
+  val aTot = T * M; val bTot = T * ks
+
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = false,
+    acc_banks = maxSeg, sp_banks = spBanksN,
+    sp_capacity = CapacityInKilobytes(math.max(32,
+      spBanksN * cols * math.max(256, Integer.highestOneBit(
+        math.max(1, bRowBase + bTot - 1)) * 2) / 1024)),
+    acc_capacity = CapacityInKilobytes(math.max(16, maxSeg * 64 * cols * 4 / 1024)))
+
+  val io = IO(new Bundle {
+    val capT    = Output(UInt(8.W))    // FakeStore 캡처가 prefix(t) 와 일치하는 t (255=none)
+    val accT    = Output(UInt(8.W))    // chkAt 의 acc 실체(뱅크0 행0)가 prefix(t) 와 일치
+    val accBad  = Output(Bool())       // acc(전 세그먼트, w 열) != full golden
+    val capZero = Output(Bool())       // 캡처가 전부 0 (보드 Q2 의 증상)
+    val capOkF  = Output(Bool())       // freshLast: 캡처 == 마지막 chunk 단독 golden
+    val capD    = Output(UInt(128.W))  // 캡처 lane 0..3 (32b 씩)
+    val stIssueCyc = Output(UInt(16.W))
+    val stRespCyc  = Output(UInt(16.W))
+    val lastWrCyc  = Output(UInt(16.W))  // 마지막 acc 쓰기 — stRespCyc 보다 뒤면 경주 존재
+    val exCompN    = Output(UInt(12.W))
+    val allocN     = Output(UInt(12.W))
+    val doneCyc    = Output(UInt(16.W))  // 전 큐 소진 시각 (0 = 미소진, 즉 wedge)
