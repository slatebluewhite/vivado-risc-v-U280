+  // sp 읽기 트레이스: EC 의 처음 16 개 읽기 요청 {bank[3:0], addr[11:0]}
+  val rdTrace = Reg(Vec(16, UInt(16.W))); val rdTraceN = RegInit(0.U(5.W))
+  for (bi <- 0 until cfg.sp_banks) {
+    when (ex.io.srams.read(bi).req.fire && rdTraceN < 16.U) {
+      rdTrace(rdTraceN(3, 0)) := Cat(bi.U(4.W), ex.io.srams.read(bi).req.bits.addr.asUInt.pad(13)(11, 0))
+      rdTraceN := rdTraceN + 1.U
+    }
+  }
+  // sp 읽기 응답 데이터 트레이스 (뱅크 0/1, lane 0 하위 16비트, EC 가 소비하는 지점)
+  val rsp1 = Reg(Vec(8, UInt(16.W))); val rsp1N = RegInit(0.U(4.W))
+  when (ex.io.srams.read(1).resp.fire && rsp1N < 8.U) {
+    rsp1(rsp1N(2, 0)) := ex.io.srams.read(1).resp.bits.data(15, 0); rsp1N := rsp1N + 1.U }
+  val rsp0 = Reg(Vec(8, UInt(16.W))); val rsp0N = RegInit(0.U(4.W))
+  when (ex.io.srams.read(0).resp.fire && rsp0N < 8.U) {
+    rsp0(rsp0N(2, 0)) := ex.io.srams.read(0).resp.bits.data(15, 0); rsp0N := rsp0N + 1.U }
+  io.dbgC := Cat(rsp1.reverse)
+  io.dbgD := Cat(rsp0.reverse)
+  io.glue := Cat(dropN, minGap)
+  io.dbgA := Cat((0 until 4).reverse.map(j => wrTrace(j)))
+  io.dbgB := Cat((0 until 8).reverse.map(j => rdTrace(j)))
+  io.wrsN := Cat(wrsPerBank.reverse)
+  io.rb00 := rb00R
+  when (ex.io.completed.valid) { exCompN := exCompN + 1.U }
+  when (rs.io.alloc.fire) { allocN := allocN + 1.U }
+  when (cyc > T0.U && ci === prog.size.U && quiet && doneCycR === 0.U) { doneCycR := cyc }
+
+  // ---- 판정 ----
+  val capTR = RegInit(255.U(8.W)); val accTR = RegInit(255.U(8.W))
+  val accBadR = RegInit(false.B); val capZeroR = RegInit(false.B); val capOkFR = RegInit(false.B)
+  when (cyc === chkAt.U) {
+    for (t <- 0 to T) {   // 큰 t 의 when 이 나중에 생성되어 우선하도록 오름차순
+      when ((0 until cols).map(c => stCap(c) === prefix(t, 0, capBank * cols + c).S(32.W)).reduce(_ && _)) { capTR := t.U }
+      when ((0 until cols).map(c => accMem(0)(chainRow)(c) === prefix(t, 0, c).S(32.W)).reduce(_ && _)) { accTR := t.U }
+    }
+    when ((0 until cols).map(c => stCap(c) === 0.S).reduce(_ && _)) { capZeroR := true.B }
+    if (freshLast > 0) {
+      when ((0 until cols).map(c => stCap(c) === chunkAlone(T - 1, 0, c).S(32.W)).reduce(_ && _)) { capOkFR := true.B }
+    }
+    // acc 전체 (모든 세그먼트, 논리 w 열, 체인 행): full golden 과 대조.
+    // freshLast 면 마지막 chunk 는 fresh 행으로 갔으므로 체인 행 기대값은 prefix(T-1).
+    val tExp = if (freshLast > 0) T - 1 else T
+    for (s <- 0 until S; c <- 0 until cols; i <- 0 until M) {
+      when (accMem(s)(chainRow + i)(c) =/= prefix(tExp, i, s * cols + c).S(32.W)) { accBadR := true.B }
+    }
+  }
+  io.capT := capTR; io.accT := accTR; io.accBad := accBadR
+  io.capZero := capZeroR; io.capOkF := capOkFR
+  io.capD := Cat((0 until 4).reverse.map(c => stCap(c).asUInt(31, 0)))
+  io.stIssueCyc := stIssueCycR; io.stRespCyc := stRespCycR; io.lastWrCyc := lastWrCycR
+  io.exCompN := exCompN; io.allocN := allocN; io.doneCyc := doneCycR
+}
+
