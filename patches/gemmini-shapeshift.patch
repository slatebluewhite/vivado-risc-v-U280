+
+/** E512: E508 수정(per-bank adder)의 면적 델타를 격리해 잰다. Scratchpad 전체를 합성하지
+  * 않고 바뀐 부분(adder 복합체)만 두 판으로 합성한다 — SSExecArea 는 Scratchpad 를 포함하지
+  * 않으므로 기존 면적표에 이 비용이 안 잡혀 있다 (E508 의 명시 한계). */
+class SSAdderArea(banksN: Int, colsN: Int, latency: Int, shared: Boolean) extends Module {
+  val t = Vec(colsN, Vec(1, SInt(32.W)))
+  val io = IO(new Bundle {
+    val sel = Input(Vec(banksN, Bool()))
+    val a   = Input(Vec(banksN, t))
+    val b   = Input(Vec(banksN, t))
+    val o   = Output(Vec(banksN, t))
+  })
+  if (shared) {
+    val m = Module(new AccPipeShared(latency, t, banksN))
+    m.io.in_sel := io.sel; m.io.ina := io.a; m.io.inb := io.b
+    for (i <- 0 until banksN) io.o(i) := m.io.out
+  } else {
+    for (i <- 0 until banksN) {
+      val m = Module(new AccPipeShared(latency, t, 1))
+      m.io.in_sel(0) := io.sel(i); m.io.ina(0) := io.a(i); m.io.inb(0) := io.b(i)
+      io.o(i) := m.io.out
+    }
+  }
+}
+
+object SSAdderAreaMain extends App {
+  val dir = if (args.length > 0) args(0) else "workspace/ss-adder"
+  val bk  = if (args.length > 1) args(1).toInt else 4
+  val cl  = if (args.length > 2) args(2).toInt else 16
+  val lat = if (args.length > 3) args(3).toInt else 1     // acc_latency(2) - 1
+  val sh  = if (args.length > 4) args(4).toInt != 0 else true
+  (new chisel3.stage.ChiselStage).emitVerilog(new SSAdderArea(bk, cl, lat, sh), Array("--target-dir", dir))
+  println(s"emitted SSAdderArea(banks=$bk, cols=$cl, lat=$lat, shared=$sh) into $dir")
+}
+
+/**
+  * E572: SSExecSP — 진짜 Scratchpad(LazyModule, StreamReader/Writer DMA·glue·큐 포함)를
+  * TLRAM 과 diplomacy 로 묶은 "섬" 안에서 RS+EC+Load/StoreController 전체 사슬을 돌린다.
+  * 목적은 보드 V4(mvin ∥ 접힌 pl/cp ∥ mvout, S=4)의 **wedge 재현** — 값이 아니라 제어
+  * 흐름이 대상이므로 DRAM(TLRAM)은 랜덤 초기화로 충분하고 검사는 완료 계수와 busy
+  * 벡터로 한다 (정확성은 기존 하네스 관할). TLB 는 항등 번역 가짜.
+  */
+/** `M` (E589): compute 의 a_rows / preload 의 c_rows. 보드에서 A 행 하나가 2.11 사이클을
+  * 먹는 것이 관측됐는데(bit8, FSM 경로) ROM 이 M=1 고정이라 시뮬에서 재현할 수 없었다. */
+class SSExecSP(rows: Int = 16, cols: Int = 16, maxSeg: Int = 4,
+               shapeIdx: Int = 2, T: Int = 32, reps: Int = 3,
+               chkAt: Int = 12000, M: Int = 1, spBanks: Int = 4, bOff: Int = 2048,
+               strideLog: Int = 0)(implicit p: Parameters) extends freechips.rocketchip.diplomacy.LazyModule {
+  import GemminiISA._
+  import freechips.rocketchip.diplomacy._
+  import freechips.rocketchip.tilelink._
+
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = false,
+    acc_banks = maxSeg, sp_banks = spBanks,
+    sp_capacity = CapacityInKilobytes(256), acc_capacity = CapacityInKilobytes(64))
+
+  // paddrBits(CoreBundle)가 TileVisibilityNodeKey 의 TL edge 에서 유도되므로,
+  // DMA 경로에 identity node 를 끼워 그 키로 공급한다 (BaseTile 의 tlMasterXbar 역할).
+  val visNode = freechips.rocketchip.tilelink.TLIdentityNode()
+  val q: Parameters = p.alterPartial {
+    case freechips.rocketchip.tile.TileVisibilityNodeKey => visNode }
+  val spad = LazyModule(new Scratchpad(cfg)(q, implicitly[Arithmetic[chisel3.SInt]]))
+  val ram = LazyModule(new TLRAM(AddressSet(0x80000000L, 0xFFFFFL), beatBytes = cfg.dma_buswidth / 8))
+  visNode := spad.id_node
+  ram.node := TLFragmenter(cfg.dma_buswidth / 8, cfg.dma_maxbytes) := TLBuffer() := visNode
+
+  lazy val module = new freechips.rocketchip.diplomacy.LazyModuleImp(this) {
+    import ShapeshiftExecParams.{p => _}   // 바깥 p 사용
+    val io = IO(new Bundle {
+      val doneCyc  = Output(UInt(16.W))   // 전 사슬 소진 시각 (0 = 미소진 = wedge)
+      val busyVec  = Output(UInt(8.W))    // chkAt 시점 {rs, ex, ld, st, spad} busy
+      val ldCompN  = Output(UInt(12.W))
+      val stCompN  = Output(UInt(12.W))
+      val exCompN  = Output(UInt(12.W))
+      val allocN   = Output(UInt(12.W))
+      val lastCompCyc = Output(UInt(16.W))
+      val b0reqA  = Output(UInt(10.W))   // bank0 발행: addr<2048 (A 스트림)
+      val b0reqBD = Output(UInt(10.W))   // bank0 발행: addr>=2048 (접힌 B/D seg3)
+      val b0pop   = Output(UInt(10.W))   // bank0 응답 소비 (EC측 fire)
+    })
+
+    val S = (1 to maxSeg).filter(rows % _ == 0)(shapeIdx)
+    val h = rows / S; val ks = math.max(h, 4)
+
+    val rs = Module(new ReservationStation(cfg, new GemminiCmd(cfg.reservation_station_entries)(q)))
+    val ex = Module(new ExecuteController(64, 32, cfg)(q, implicitly[Arithmetic[chisel3.SInt]]))
+    val ld = Module(new LoadController(cfg, 40, cfg.local_addr_t)(q))
+    val st = Module(new StoreController(cfg, 40, cfg.local_addr_t)(implicitly[Arithmetic[chisel3.SInt]], q))
+    rs.io.counter := DontCare; ex.io.counter := DontCare
+    ld.io.counter := DontCare; st.io.counter := DontCare
+    spad.module.io.counter := DontCare
+
+    // spad 배선 (Controller.scala 258-264 답습)
+    spad.module.io.dma.read <> ld.io.dma
+    spad.module.io.dma.write <> st.io.dma
+    ex.io.srams.read <> spad.module.io.srams.read
+    ex.io.srams.write <> spad.module.io.srams.write
+    spad.module.io.acc.read_req <> ex.io.acc.read_req
+    ex.io.acc.read_resp <> spad.module.io.acc.read_resp
+    ex.io.acc.write <> spad.module.io.acc.write
+    spad.module.io.flush := false.B
+    ex.io.im2col.req.ready := true.B
+    ex.io.im2col.resp.valid := false.B
+    ex.io.im2col.resp.bits := DontCare
+
+    // 가짜 TLB: 항등 번역, 예외 없음
+    for (t <- spad.module.io.tlb) {
+      t.resp := 0.U.asTypeOf(t.resp)
+      t.resp.paddr := t.req.bits.tlb_req.vaddr
+      t.resp.miss := false.B
+    }
+
+    // RS <-> 컨트롤러 (Controller.scala 242-255)
+    ld.io.cmd.valid := rs.io.issue.ld.valid
+    rs.io.issue.ld.ready := ld.io.cmd.ready
+    ld.io.cmd.bits := rs.io.issue.ld.cmd
+    ld.io.cmd.bits.rob_id.push(rs.io.issue.ld.rob_id)
+    st.io.cmd.valid := rs.io.issue.st.valid
+    rs.io.issue.st.ready := st.io.cmd.ready
+    st.io.cmd.bits := rs.io.issue.st.cmd
+    st.io.cmd.bits.rob_id.push(rs.io.issue.st.rob_id)
+    ex.io.cmd.valid := rs.io.issue.ex.valid
+    rs.io.issue.ex.ready := ex.io.cmd.ready
+    ex.io.cmd.bits := rs.io.issue.ex.cmd
+    ex.io.cmd.bits.rob_id.push(rs.io.issue.ex.rob_id)
+    val arb = Module(new Arbiter(UInt(cfg.ROB_ID_WIDTH.W), 3))
+    arb.io.in(0).valid := ex.io.completed.valid
+    arb.io.in(0).bits := ex.io.completed.bits
+    arb.io.in(1) <> ld.io.completed
+    arb.io.in(2) <> st.io.completed
+    rs.io.completed.valid := arb.io.out.valid
+    rs.io.completed.bits := arb.io.out.bits
+    arb.io.out.ready := true.B
+
+    // ---- 명령 ROM: V4 (W fill 256 mvin + reps x [x mvin 2 + T pl/cp + 4 mvout]) ----
+    def rc(r: Int, c: Int, a: BigInt): BigInt = (BigInt(r) << 48) | (BigInt(c) << 32) | a
+    val DRAM = BigInt("80000000", 16)
+    val cfgEx = (CONFIG_CMD, (BigInt(1) << 2) | (BigInt(shapeIdx) << ShapeshiftISA.SHAPE_LO)
+                 | (BigInt(strideLog) << ShapeshiftISA.STRIDE_LO) | (BigInt(1) << 16),
+                 BigInt(1) << 48)
+    val cfgSt = (CONFIG_CMD, BigInt(2), BigInt(cols))
+    // scale=1.0f(0x3f800000) — 0 이면 mvin 이 전부 0 이 되는 corpus 함정. stride 는 rs2.
+    def cfgLd(strideBytes: Int) = (CONFIG_CMD,
+      (BigInt("3f800000", 16) << 32) | (BigInt(16) << 16) | BigInt(1), BigInt(strideBytes))
+    def ldW(pp: Int, tt: Int, s: Int) = (LOAD_CMD,
+      DRAM + 0x1000 + (tt * h * 128 + pp * cols * S + s * cols),
+      rc(h, cols, BigInt(((1 + s * (1 << strideLog)) % cfg.sp_banks) * cfg.sp_bank_entries + bOff + (pp * (T) + tt) * ks)))
+    def ldX(i: Int) = (LOAD_CMD, DRAM + i * 16 * h, rc(16, h, BigInt(i * 16)))
+    def preC(tt: Int) = (PRELOAD_CMD, rc(h, cols, BigInt(cfg.sp_bank_entries + bOff + tt * ks)),
+      rc(M, cols, (BigInt(1) << 31) | (if (tt > 0) BigInt(1) << 30 else BigInt(0))))
+    def cmpC(tt: Int) = (COMPUTE_AND_FLIP_CMD, rc(M, h, BigInt(tt * M)), BigInt("ffffffff", 16))
+    def stC(s: Int) = (STORE_CMD, DRAM + 0xF0000 + s * cols,
+      rc(M, cols, (BigInt(1) << 31) | BigInt(s * cfg.acc_bank_entries)))
+
+    val prog: Seq[(UInt, BigInt, BigInt)] =
+      Seq(cfgEx, cfgSt, cfgLd(128)) ++
+      (0 until T).flatMap(tt => (0 until S).map(s => ldW(0, tt, s))) ++
+      Seq(cfgLd(h)) ++
+      (0 until reps).flatMap { rep =>
+        (0 until ((T * M + 15) / 16)).map(ldX) ++
+        (0 until T).flatMap(tt => Seq(preC(tt), cmpC(tt))) ++
+        (0 until S).map(stC)
+      }
+
+    val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+    val ci = RegInit(0.U(12.W))
+    rs.io.alloc.valid := cyc >= 8.U && ci < prog.size.U
+    rs.io.alloc.bits := DontCare
+    rs.io.alloc.bits.cmd.inst.funct := MuxLookup(ci, 0.U)(prog.zipWithIndex.map { case ((f,_,_), k) => k.U -> f })
+    rs.io.alloc.bits.cmd.rs1 := MuxLookup(ci, 0.U)(prog.zipWithIndex.map { case ((_,a,_), k) => k.U -> a.U(64.W) })
+    rs.io.alloc.bits.cmd.rs2 := MuxLookup(ci, 0.U)(prog.zipWithIndex.map { case ((_,_,b), k) => k.U -> b.U(64.W) })
+    rs.io.alloc.bits.rob_id.valid := false.B
+    rs.io.alloc.bits.rob_id.bits := 0.U
+    rs.io.alloc.bits.from_matmul_fsm := false.B
+    rs.io.alloc.bits.from_conv_fsm := false.B
+    when (rs.io.alloc.fire) { ci := ci + 1.U }
+
+    // E574 계측: bank0 장부 — 동결 시점의 (발행 - 소비) 와 출처
+    val b0reqA = RegInit(0.U(10.W)); val b0reqBD = RegInit(0.U(10.W)); val b0pop = RegInit(0.U(10.W))
+    val b0 = ex.io.srams.read(0)
+    when (b0.req.valid && b0.req.ready) {
+      when (b0.req.bits.addr < 2048.U) { b0reqA := b0reqA + 1.U }
+        .otherwise { b0reqBD := b0reqBD + 1.U }
+    }
+    when (b0.resp.valid && b0.resp.ready) { b0pop := b0pop + 1.U }
+    io.b0reqA := b0reqA; io.b0reqBD := b0reqBD; io.b0pop := b0pop
+    val ldN = RegInit(0.U(12.W)); val stN = RegInit(0.U(12.W)); val exN = RegInit(0.U(12.W))
+    val allocN = RegInit(0.U(12.W)); val lastComp = RegInit(0.U(16.W))
+    when (ld.io.completed.fire) { ldN := ldN + 1.U }
+    when (st.io.completed.fire) { stN := stN + 1.U }
+    when (ex.io.completed.valid) { exN := exN + 1.U }
+    when (rs.io.alloc.fire) { allocN := allocN + 1.U }
+    when (arb.io.out.fire) { lastComp := cyc }
+    val allDone = ci === prog.size.U && !rs.io.busy && !ex.io.busy && !ld.io.busy && !st.io.busy && !spad.module.io.busy
+    val doneCycR = RegInit(0.U(16.W))
+    when (cyc > 8.U && allDone && doneCycR === 0.U) { doneCycR := cyc }
+    io.doneCyc := doneCycR
+    io.busyVec := Cat(0.U(3.W), rs.io.busy, ex.io.busy, ld.io.busy, st.io.busy, spad.module.io.busy)
+    io.ldCompN := ldN; io.stCompN := stN; io.exCompN := exN; io.allocN := allocN
+    io.lastCompCyc := lastComp
+  }
+}
+
+object ShapeshiftSPMain extends App {
+  import ShapeshiftExecParams.p
+  val dir = if (args.length > 0) args(0) else "workspace/ss-sp"
+  val r   = if (args.length > 1) args(1).toInt else 16
+  val c   = if (args.length > 2) args(2).toInt else 16
+  val ms  = if (args.length > 3) args(3).toInt else 4
+  val sh  = if (args.length > 4) args(4).toInt else 2
+  val tt  = if (args.length > 5) args(5).toInt else 32
+  val rp  = if (args.length > 6) args(6).toInt else 3
+  val cka = if (args.length > 7) args(7).toInt else 12000
+  val mm  = if (args.length > 8) args(8).toInt else 1
+  val spb = if (args.length > 9) args(9).toInt else 4
+  val bof = if (args.length > 10) args(10).toInt else 2048
+  val stl = if (args.length > 11) args(11).toInt else 0
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    freechips.rocketchip.diplomacy.LazyModule(new SSExecSP(r, c, ms, sh, tt, rp, cka, mm, spb, bof, stl)).module,
+    Array("--target-dir", dir))
+  println(s"emitted SSExecSP(sh=$sh T=$tt reps=$rp) into $dir")
+}
