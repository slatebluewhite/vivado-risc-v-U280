diff --git a/src/main/scala/gemmini/ShapeshiftAccWrite.scala b/src/main/scala/gemmini/ShapeshiftAccWrite.scala
new file mode 100644
index 0000000..2326830
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftAccWrite.scala
@@ -0,0 +1,70 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * A model of the accumulator write path, parameterised by LANE COUNT, used to
+  * price widening the accumulator port from `C` to `C*S_max`.
+  *
+  * Why this is the remaining cost: E428 showed the output rate of a folded array
+  * rises exactly in proportion to the speedup it buys (`C*S` values per cycle for
+  * an `R/h` speedup), and E432 built the gather that presents them as one
+  * contiguous logical row. The accumulator must then absorb `C*S` per cycle.
+  * Throttling would hand the width back and the speedup with it.
+  *
+  * This is a MODEL, not a drop-in for `AccumulatorMem` (which also has banking,
+  * scaling units, a read-out path and tag tracking). It isolates the one question
+  * that matters here: at FIXED CAPACITY, what does a wider port cost?
+  *
+  *   lanes 16 x 2048 rows  ==  lanes 64 x 512 rows  ==  32768 accumulator words
+  *
+  * On an FPGA the SRAM side may be nearly free, because BRAM36 is width- and
+  * depth-configurable (up to 72 bits per port), so a wide-shallow array uses the
+  * same total bits as a narrow-deep one. What is NOT free is the accumulate
+  * datapath: read-modify-write needs `lanes` adders of `accType`.
+  */
+class ShapeshiftAccWrite[T <: Data](accType: T, val lanes: Int, val entries: Int)
+                                   (implicit ev: Arithmetic[T]) extends Module {
+  import ev._
+
+  val io = IO(new Bundle {
+    val wen   = Input(Bool())
+    val waddr = Input(UInt(log2Up(entries).W))
+    val wdata = Input(Vec(lanes, accType))
+    val acc   = Input(Bool())            // accumulate into the row vs overwrite it
+    val ren   = Input(Bool())
+    val raddr = Input(UInt(log2Up(entries).W))
+    val rdata = Output(Vec(lanes, accType))
+  })
+
+  val mem = SyncReadMem(entries, Vec(lanes, accType))
+
+  // ONE read port, shared between the read-modify-write and the external read.
+  // A first version gave the RMW its own port; three ports forced the array out
+  // of BRAM into distributed RAM (RAMB36 = 0, ~50k LUT) and made the width sweep
+  // meaningless. Gemmini's real accumulator is 1R1W per bank for the same reason.
+  val rd_addr = Mux(io.wen, io.waddr, io.raddr)
+  val rd_en   = io.wen || io.ren
+  val rd      = mem.read(rd_addr, rd_en)
+
+  val wen_d   = RegNext(io.wen, false.B)
+  val acc_d   = RegNext(io.acc, false.B)
+  val waddr_d = RegNext(io.waddr)
+  val wdata_d = RegNext(io.wdata)
+
+  val sum = VecInit((wdata_d zip rd).map { case (n, o) => Mux(acc_d, n + o, n) })
+  when (wen_d) { mem.write(waddr_d, sum) }
+
+  io.rdata := rd
+}
+
+object ShapeshiftAccWriteMain extends App {
+  val dir     = if (args.length > 0) args(0) else "workspace/ss-acc"
+  val lanes   = if (args.length > 1) args(1).toInt else 16
+  val words   = if (args.length > 2) args(2).toInt else 32768
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftAccWrite(SInt(32.W), lanes, words / lanes), Array("--target-dir", dir))
+  println(s"emitted ShapeshiftAccWrite(lanes=$lanes, entries=${words / lanes}) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftDatapath.scala b/src/main/scala/gemmini/ShapeshiftDatapath.scala
new file mode 100644
index 0000000..ca9e89c
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftDatapath.scala
@@ -0,0 +1,237 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * The complete shapeshift datapath, end to end:
+  *
+  *   weight SRAM -> scatter -> [skew -> ShapeshiftMesh] -> gather -> accumulator SRAM
+  *                                   ^ shape from config_ex
+  *
+  * Everything the array needs to run a folded matmul is here. What is deliberately
+  * NOT here is sequencing: the addresses, the preload/compute phases and the
+  * accumulator write index are driven from outside, because that is
+  * `ExecuteController`'s job and it is the one remaining piece.
+  *
+  * Concrete (not generic) on purpose — this is a demonstrator to verify and to
+  * price, and the type gymnastics buy nothing here.
+  */
+class ShapeshiftDatapath(val rows: Int, val cols: Int, val maxSegments: Int,
+                         val wEntries: Int, val accEntries: Int) extends Module {
+
+  val inputType  = SInt(8.W)
+  val outputType = SInt(20.W)
+  val accType    = SInt(32.W)
+
+  val segsSupported: Seq[Int] = (1 to maxSegments).filter(rows % _ == 0)
+  val maxLanes: Int = cols * segsSupported.max
+
+  val io = IO(new Bundle {
+    // shape ISA
+    val cmd_valid = Input(Bool())
+    val cmd_funct = Input(UInt(7.W))
+    val cmd_rs1   = Input(UInt(64.W))
+
+    // weight SRAM (a DMA would fill this; the harness does it here)
+    val wmem_wen   = Input(Bool())
+    val wmem_waddr = Input(UInt(log2Up(wEntries).W))
+    val wmem_wdata = Input(Vec(maxLanes, inputType))
+    val wmem_ren   = Input(Bool())
+    val wmem_raddr = Input(UInt(log2Up(wEntries).W))
+
+    // activations
+    val in_a     = Input(Vec(rows, inputType))
+    val in_prop  = Input(Bool())
+    val in_valid = Input(Bool())
+
+    // accumulator
+    val acc_wen   = Input(Bool())
+    val acc_waddr = Input(UInt(log2Up(accEntries).W))
+    val acc_acc   = Input(Bool())
+    val acc_ren   = Input(Bool())
+    val acc_raddr = Input(UInt(log2Up(accEntries).W))
+    val acc_rdata = Output(Vec(maxLanes, accType))
+
+    val shape     = Output(UInt(8.W))
+    val n_valid   = Output(UInt(log2Up(maxLanes + 1).W))
+    val bad_shape = Output(Bool())
+    val dbg_wide0 = Output(SInt(20.W))    // 진단: gather 레인 0
+  })
+
+  // ---- weight SRAM (one wide logical row = C*S elements) ----
+  val wmem = SyncReadMem(wEntries, Vec(maxLanes, inputType))
+  when (io.wmem_wen) { wmem.write(io.wmem_waddr, io.wmem_wdata) }
+  val wrow = wmem.read(io.wmem_raddr, io.wmem_ren)   // 1-cycle latency
+
+  // ---- unit (skew + mesh + config_ex decoder + gather) ----
+  val unit = Module(new ShapeshiftUnit(inputType, outputType, accType, rows, cols, maxSegments))
+  unit.io.cmd_valid := io.cmd_valid
+  unit.io.cmd_funct := io.cmd_funct
+  unit.io.cmd_rs1   := io.cmd_rs1
+
+  // ---- scatter: wide weight row -> per-segment-top d inputs ----
+  val scatter = Module(new ShapeshiftScatter(inputType, rows, cols, maxSegments))
+  scatter.io.shape := unit.io.shape
+  scatter.io.in    := wrow
+  unit.io.in_d     := scatter.io.out
+
+  unit.io.in_a     := io.in_a
+  unit.io.in_prop  := io.in_prop
+  unit.io.in_valid := io.in_valid
+  for (r <- 0 until rows; c <- 0 until cols) unit.io.in_b(r)(c) := 0.S(20.W)
+
+  // ---- accumulator (gather output is 20-bit; `:=` sign-extends into 32) ----
+  val acc = Module(new ShapeshiftAccWrite(accType, maxLanes, accEntries))
+  acc.io.wen   := io.acc_wen
+  acc.io.waddr := io.acc_waddr
+  acc.io.acc   := io.acc_acc
+  acc.io.ren   := io.acc_ren
+  acc.io.raddr := io.acc_raddr
+  for (n <- 0 until maxLanes) acc.io.wdata(n) := unit.io.wide(n)
+  io.acc_rdata := acc.io.rdata
+
+  io.shape     := unit.io.shape
+  io.n_valid   := unit.io.n_valid
+  io.bad_shape := unit.io.bad_shape
+  io.dbg_wide0 := unit.io.wide(0)
+}
+
+/**
+  * End-to-end test: weights come out of the weight SRAM, results land in the
+  * accumulator SRAM, and the accumulator is READ BACK and compared to the Scala
+  * golden. Everything before this checked the mesh output directly.
+  *
+  * mode 0 = normal, 1 = no shape config (negative control),
+  * mode 2 = out-of-range shape (negative control).
+  */
+class ShapeshiftE2ESeg(shapeIdx: Int, rows: Int = 4, cols: Int = 4, M: Int = 6, mode: Int = 0)
+  extends Module {
+
+  val segsSupported: Seq[Int] = (1 to rows).filter(rows % _ == 0)
+  val S = segsSupported(shapeIdx); val h = rows / S
+  val maxLanes = cols * segsSupported.max
+
+  val TW = 2                    // weight-SRAM fill starts
+  val TC = TW + rows + 2        // config_ex
+  val T0 = TC + 4               // preload starts
+  val L  = h + cols             // measured in E429: output row i at T0+h+i+L
+  val TA = T0 + h + L           // first accumulator write
+  val TR = TA + M + 8           // read-back starts
+
+  def aVal(s: Int, i: Int, j: Int): Int = (i + 2 * j + 3 * s) % 7 - 3
+  def bVal(s: Int, k: Int, c: Int): Int = (3 * k + c + s) % 5 - 2
+  def gold(s: Int, i: Int, c: Int): Int = (0 until h).map(j => aVal(s, i, j) * bVal(s, j, c)).sum
+
+  val io = IO(new Bundle {
+    val ok        = Output(Bool())
+    val checked   = Output(UInt(8.W))    // how many rows were actually compared
+    val shape     = Output(UInt(8.W))
+    val bad_shape = Output(Bool())
+  })
+
+  val dp = Module(new ShapeshiftDatapath(rows, cols, rows, wEntries = 16, accEntries = 16))
+  val cycle = RegInit(0.U(16.W)); cycle := cycle + 1.U
+
+  // ---- fill the weight SRAM: address k holds logical row k of B (C*S wide) ----
+  val wt = (cycle - TW.U)(log2Up(rows + 1) - 1, 0)
+  dp.io.wmem_wen   := cycle >= TW.U && cycle < (TW + h).U
+  dp.io.wmem_waddr := wt
+  for (n <- 0 until maxLanes) {
+    val s = n / cols; val c = n % cols
+    dp.io.wmem_wdata(n) := (if (s < S)
+      MuxLookup(wt, 0.S(8.W))((0 until h).map(k => k.U -> bVal(s, k, c).S(8.W))) else 0.S(8.W))
+  }
+
+  // ---- shape config ----
+  val sent = if (mode == 2) segsSupported.size + 1 else shapeIdx
+  dp.io.cmd_valid := (mode != 1).B && cycle === TC.U
+  dp.io.cmd_funct := GemminiISA.CONFIG_CMD
+  dp.io.cmd_rs1   := (if (mode == 1) BigInt(0) else ShapeshiftISA.rs1(sent)).U(64.W)
+
+  // ---- preload: read B rows in REVERSE, one cycle early (SyncReadMem latency) ----
+  val pre_rd = cycle >= (T0 - 1).U && cycle < (T0 + h - 1).U
+  val pt     = (cycle - (T0 - 1).U)(log2Up(rows + 1) - 1, 0)
+  dp.io.wmem_ren   := pre_rd
+  dp.io.wmem_raddr := MuxLookup(pt, 0.U)((0 until h).map(t => t.U -> (h - 1 - t).U))
+
+  val preload = cycle >= T0.U && cycle < (T0 + h).U
+  val compute = cycle >= (T0 + h).U && cycle < (T0 + h + M).U
+  dp.io.in_prop  := preload
+  dp.io.in_valid := cycle >= T0.U
+
+  val ai = (cycle - (T0 + h).U)(log2Up(M + 1) - 1, 0)
+  for (r <- 0 until rows) {
+    val s = r / h; val j = r % h
+    dp.io.in_a(r) := Mux(compute,
+      MuxLookup(ai, 0.S(8.W))((0 until M).map(i => i.U -> aVal(s, i, j).S(8.W))), 0.S(8.W))
+  }
+
+  // ---- accumulator writes: output row i lands at TA + i ----
+  val wi = (cycle - TA.U)(log2Up(M + 1) - 1, 0)
+  dp.io.acc_wen   := cycle >= TA.U && cycle < (TA + M).U
+  dp.io.acc_waddr := wi
+  dp.io.acc_acc   := false.B          // overwrite (single pass, no bias)
+
+  // ---- read back and compare ----
+  val ri = (cycle - TR.U)(log2Up(M + 1) - 1, 0)
+  dp.io.acc_ren   := cycle >= TR.U && cycle < (TR + M).U
+  dp.io.acc_raddr := ri
+
+  val ok  = RegInit(true.B)
+  val cnt = RegInit(0.U(8.W))
+  for (i <- 0 until M) {
+    when (cycle === (TR + i + 1).U) {          // SyncReadMem: data one cycle later
+      cnt := cnt + 1.U
+      val bad = (0 until maxLanes).map { n =>
+        val s = n / cols; val c = n % cols
+        dp.io.acc_rdata(n) =/= (if (s < S) gold(s, i, c) else 0).S(32.W)
+      }.reduce(_ || _)
+      when (bad) { ok := false.B }
+    }
+  }
+  io.ok        := ok
+  io.checked   := cnt
+  io.shape     := dp.io.shape
+  io.bad_shape := dp.io.bad_shape
+}
+
+class ShapeshiftE2ETop(mode: Int = 0) extends Module {
+  val io = IO(new Bundle {
+    val ok      = Output(UInt(3.W))
+    val checked = Output(UInt(24.W))
+    val shapes  = Output(UInt(24.W))
+    val bad     = Output(UInt(3.W))
+  })
+  val duts = (0 to 2).map(i => Module(new ShapeshiftE2ESeg(i, 4, 4, 6, mode)))
+  io.ok      := Cat(duts.map(_.io.ok).reverse)
+  io.checked := Cat(duts.map(_.io.checked).reverse)
+  io.shapes  := Cat(duts.map(_.io.shape).reverse)
+  io.bad     := Cat(duts.map(_.io.bad_shape).reverse)
+}
+
+object ShapeshiftE2EMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-e2e"
+  val mode = if (args.length > 1) args(1).toInt else 0
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftE2ETop(mode), Array("--target-dir", dir))
+  println(s"emitted ShapeshiftE2ETop(mode=$mode) into $dir")
+}
+
+object ShapeshiftDatapathMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/ss-dp"
+  val rows = if (args.length > 1) args(1).toInt else 16
+  val cols = if (args.length > 2) args(2).toInt else 16
+  val ms   = if (args.length > 3) args(3).toInt else 4
+  val lanes = cols * (1 to ms).filter(rows % _ == 0).max
+  // Capacity is held fixed so the sweep prices PORT WIDTH, not size.
+  // Sizes are arguments because they matter: a wide port at fixed capacity makes
+  // the array SHALLOW, and below roughly 512 rows Vivado abandons BRAM for
+  // distributed RAM, which shows up as a large LUT jump (see E434).
+  val wWords = if (args.length > 4) args(4).toInt else 262144   // 256 KB of int8 weights
+  val aWords = if (args.length > 5) args(5).toInt else 32768    // 128 KB of int32 acc
+  (new chisel3.stage.ChiselStage).emitVerilog(
+    new ShapeshiftDatapath(rows, cols, ms, wEntries = wWords / lanes, accEntries = aWords / lanes),
+    Array("--target-dir", dir))
+  println(s"emitted ShapeshiftDatapath($rows x $cols, maxSeg=$ms, lanes=$lanes) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftEquiv.scala b/src/main/scala/gemmini/ShapeshiftEquiv.scala
new file mode 100644
index 0000000..8770703
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftEquiv.scala
@@ -0,0 +1,183 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+import chisel3.util.random.LFSR
+
+/**
+  * Self-checking equivalence harness for `ShapeshiftMesh`.
+  *
+  * For `S` segments it drives ONE `ShapeshiftMesh(R, C)` cut into `S` pieces
+  * and `S` reference `Mesh(R/S, C)` instances with bit-identical stimulus, and
+  * asserts that segment `s`'s bottom row matches reference `s` every cycle.
+  *
+  * Comparing against the *unmodified* `Mesh` is what makes this rigorous: no
+  * knowledge of the correct systolic skew is needed, because both sides are
+  * fed the same (arbitrary) stimulus and must agree cycle for cycle.
+  *
+  * The rows that are NOT segment tops are deliberately driven with *different*
+  * random data, so the test also proves the cut mux really ignores them.
+  */
+class ShapeshiftEquivSeg(segments: Int, rows: Int = 4, cols: Int = 4, seed: Int = 1,
+                         sabotage: Boolean = false)
+  extends Module {
+
+  val inputType  = SInt(8.W)
+  val outputType = SInt(20.W)
+  val accType    = SInt(32.W)
+  val df         = Dataflow.WS
+  val tile_latency = 0
+  val output_delay = 1
+  val max_sim    = 4
+
+  require(rows % segments == 0)
+  val h = rows / segments
+
+  val io = IO(new Bundle {
+    val mismatch = Output(Bool())
+    val sig      = Output(UInt(32.W))   // running XOR of compared data (liveness)
+    val nonzero  = Output(Bool())       // did we ever compare a non-zero value?
+  })
+
+  // ---- stimulus ----------------------------------------------------------
+  val cycle = RegInit(0.U(16.W)); cycle := cycle + 1.U
+  val warm  = cycle < 64.U        // hold valid high to define every PE register
+
+  private var lfsrIdx = 0
+  def rnd(n: Int): UInt = {       // n random bits, fresh per call
+    lfsrIdx += 1
+    LFSR(64, true.B, Some(BigInt(seed * 977 + lfsrIdx * 31 + 1)))(n - 1, 0)
+  }
+
+  def rndCtrl(): PEControl[SInt] = {
+    val c = Wire(new PEControl(accType))
+    c.dataflow  := Dataflow.WS.id.U(1.W)
+    c.propagate := Mux(warm, cycle(0), rnd(1))   // toggling during warm-up
+    c.shift     := rnd(log2Up(accType.getWidth))
+    c
+  }
+
+  // per segment: h activation streams, and C columns of b/d/control/id/last/valid
+  val a_s     = Seq.fill(segments, h)(rnd(8).asTypeOf(inputType))
+  val b_s     = Seq.fill(segments, cols)(rnd(8).asTypeOf(inputType))
+  val d_s     = Seq.fill(segments, cols)(rnd(8).asTypeOf(inputType))
+  val ctrl_s  = Seq.fill(segments, cols)(rndCtrl())
+  val id_s    = Seq.fill(segments, cols)(rnd(log2Up(max_sim)))
+  val last_s  = Seq.fill(segments, cols)(rnd(1).asBool)
+  val vld_s   = Seq.fill(segments, cols)(Mux(warm, true.B, rnd(1).asBool))
+
+  // ---- device under test -------------------------------------------------
+  val ss = Module(new ShapeshiftMesh(inputType, outputType, accType, df,
+    tree_reduction = false, tile_latency = tile_latency,
+    max_simultaneous_matmuls = max_sim, output_delay = output_delay,
+    tileRows = 1, tileColumns = 1, meshRows = rows, meshColumns = cols,
+    maxSegments = segments))
+
+  // `sabotage` deliberately programs the WRONG cut mask (never cut) so that the
+  // negative control can show this checker is able to fail at all — a checker
+  // that cannot fail proves nothing.
+  ss.io.cut := VecInit(ShapeshiftMesh.cutMask(rows, if (sabotage) 1 else segments).map(_.B))
+
+  for (r <- 0 until rows) {
+    val s = r / h; val j = r % h
+    ss.io.in_a(r)(0) := a_s(s)(j)
+    for (c <- 0 until cols) {
+      val top = (j == 0)   // only segment tops actually consume these
+      ss.io.in_b(r)(c)(0)       := (if (top) b_s(s)(c)    else rnd(8).asTypeOf(inputType))
+      ss.io.in_d(r)(c)(0)       := (if (top) d_s(s)(c)    else rnd(8).asTypeOf(inputType))
+      ss.io.in_control(r)(c)(0) := (if (top) ctrl_s(s)(c) else rndCtrl())
+      ss.io.in_id(r)(c)(0)      := (if (top) id_s(s)(c)   else rnd(log2Up(max_sim)))
+      ss.io.in_last(r)(c)(0)    := (if (top) last_s(s)(c) else rnd(1).asBool)
+      ss.io.in_valid(r)(c)(0)   := (if (top) vld_s(s)(c)  else rnd(1).asBool)
+    }
+  }
+
+  // ---- references --------------------------------------------------------
+  val refs = Seq.fill(segments)(Module(new Mesh(inputType, outputType, accType, df,
+    tree_reduction = false, tile_latency = tile_latency,
+    max_simultaneous_matmuls = max_sim, output_delay = output_delay,
+    tileRows = 1, tileColumns = 1, meshRows = h, meshColumns = cols)))
+
+  for (s <- 0 until segments) {
+    for (j <- 0 until h) refs(s).io.in_a(j)(0) := a_s(s)(j)
+    for (c <- 0 until cols) {
+      refs(s).io.in_b(c)(0)       := b_s(s)(c)
+      refs(s).io.in_d(c)(0)       := d_s(s)(c)
+      refs(s).io.in_control(c)(0) := ctrl_s(s)(c)
+      refs(s).io.in_id(c)(0)      := id_s(s)(c)
+      refs(s).io.in_last(c)(0)    := last_s(s)(c)
+      refs(s).io.in_valid(c)(0)   := vld_s(s)(c)
+    }
+  }
+
+  // ---- compare -----------------------------------------------------------
+  val armed = cycle > 100.U   // PE weight registers are X until first written
+  val diffs = for (s <- 0 until segments; c <- 0 until cols) yield {
+    val r = s * h + h - 1     // bottom row of segment s
+    val a = Cat(ss.io.out_b(r)(c).asUInt, ss.io.out_c(r)(c).asUInt,
+                ss.io.out_valid(r)(c).asUInt, ss.io.out_id(r)(c).asUInt,
+                ss.io.out_last(r)(c).asUInt, ss.io.out_control(r)(c).asUInt)
+    val b = Cat(refs(s).io.out_b(c).asUInt, refs(s).io.out_c(c).asUInt,
+                refs(s).io.out_valid(c).asUInt, refs(s).io.out_id(c).asUInt,
+                refs(s).io.out_last(c).asUInt, refs(s).io.out_control(c).asUInt)
+    (a =/= b, a)
+  }
+
+  val mism = RegInit(false.B)
+  when (armed && diffs.map(_._1).reduce(_ || _)) { mism := true.B }
+  io.mismatch := mism
+
+  val sig = RegInit(0.U(32.W))
+  when (armed) { sig := sig ^ diffs.map(_._2.pad(32)(31, 0)).reduce(_ ^ _) }
+  io.sig := sig
+
+  val nz = RegInit(false.B)
+  when (armed && diffs.map(_._2.orR).reduce(_ || _)) { nz := true.B }
+  io.nonzero := nz
+}
+
+/** Top: checks S = 1, 2 and 4 concurrently, each with its own stimulus. */
+class ShapeshiftEquivTop(sabotage: Boolean = false) extends Module {
+  val io = IO(new Bundle {
+    val mismatch = Output(UInt(3.W))   // one bit per S
+    val nonzero  = Output(UInt(3.W))
+    val sig      = Output(UInt(32.W))
+  })
+  val segs = Seq(1, 2, 4)
+  val duts = segs.zipWithIndex.map { case (s, i) => Module(new ShapeshiftEquivSeg(s, 4, 4, seed = 7 + i, sabotage)) }
+  io.mismatch := Cat(duts.map(_.io.mismatch).reverse)
+  io.nonzero  := Cat(duts.map(_.io.nonzero).reverse)
+  io.sig      := duts.map(_.io.sig).reduce(_ ^ _)
+}
+
+/** Negative control: wrong cut mask must make S=2 and S=4 mismatch (S=1 unaffected). */
+object ShapeshiftEquivNegMain extends App {
+  val dir = if (args.nonEmpty) args(0) else "workspace/shapeshift-neg"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftEquivTop(sabotage = true), Array("--target-dir", dir))
+  println(s"emitted sabotaged ShapeshiftEquivTop.v into $dir")
+}
+
+object ShapeshiftEquivMain extends App {
+  val dir = if (args.nonEmpty) args(0) else "workspace/shapeshift"
+  (new chisel3.stage.ChiselStage).emitVerilog(new ShapeshiftEquivTop, Array("--target-dir", dir))
+  println(s"emitted ShapeshiftEquivTop.v into $dir")
+}
+
+/** Standalone emission of just the mesh, for area/timing comparison. */
+object ShapeshiftMeshMain extends App {
+  val dir  = if (args.length > 0) args(0) else "workspace/shapeshift"
+  val rows = if (args.length > 1) args(1).toInt else 4
+  val cols = if (args.length > 2) args(2).toInt else 4
+  val plain = args.length > 3 && args(3) == "plain"
+  val maxSeg = if (args.length > 4) args(4).toInt else 0
+  val it = SInt(8.W); val ot = SInt(20.W); val at = SInt(32.W)
+  val stage = new chisel3.stage.ChiselStage
+  if (plain)
+    stage.emitVerilog(new Mesh(it, ot, at, Dataflow.WS, false, 0, 4, 1, 1, 1, rows, cols),
+      Array("--target-dir", dir))
+  else
+    stage.emitVerilog(new ShapeshiftMesh(it, ot, at, Dataflow.WS, false, 0, 4, 1, 1, 1, rows, cols, maxSeg),
+      Array("--target-dir", dir))
+  println(s"emitted ${if (plain) "Mesh" else "ShapeshiftMesh"}($rows x $cols) into $dir")
+}
diff --git a/src/main/scala/gemmini/ShapeshiftExec.scala b/src/main/scala/gemmini/ShapeshiftExec.scala
new file mode 100644
index 0000000..cb24b46
--- /dev/null
+++ b/src/main/scala/gemmini/ShapeshiftExec.scala
@@ -0,0 +1,1894 @@
+
+package gemmini
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config.{Config, Parameters}
+import freechips.rocketchip.tile.{TileKey, RocketTileParams}
+import freechips.rocketchip.rocket.RocketCoreParams
+
+/**
+  * ExecuteController-level verification of the folded path.
+  *
+  * This closes the last gap after E447: the folded datapath is verified at MODULE
+  * level (E444) and on a standalone sequencer (E437/E438/E440), but nothing had
+  * shown that the STOCK COMMAND STREAM drives a folded shape — which is exactly
+  * what E446/E447 added (config_ex shape decode, per-segment scratchpad bank
+  * fetch, per-segment accumulator bank write).
+  *
+  * THE COMPARISON IS DIFFERENTIAL, NOT ABSOLUTE. E448 first tried a hand-written
+  * Scala golden and spent the whole run debugging the harness's own idea of what
+  * the commands mean. The question here is "does folding preserve meaning", not
+  * "can I re-derive the Gemmini ISA", so the reference is borrowed rather than
+  * built — the same instrument that worked in E429 (bare mesh) and E444
+  * (MeshWithDelays).
+  *
+  * THE REFERENCE IS THE SAME MODULE AT SHAPE 0. A folded shape has K = h = rows/S.
+  * Running the identical configuration at shape 0 with A's columns and B's rows
+  * beyond `h` held at zero computes exactly one segment's result, so no second
+  * configuration (and no second set of command-field widths) is needed.
+  *
+  *     DUT  : shape S, B tiles 0..S-1 in scratchpad banks 1..S
+  *     ref s: shape 0, B tile s      in scratchpad bank 1
+  *     check: DUT accumulator bank s  ==  ref s accumulator bank 0
+  */
+object ShapeshiftExecParams {
+  // `RoCCCommand` is a `CoreBundle`, so it reads its width from `p(TileKey)` —
+  // normally supplied by the diplomacy machinery around a tile, which is why a
+  // standalone Gemmini module is awkward to elaborate. Supplying it directly is
+  // enough: nothing else in `ExecuteController` looks anything up in `Parameters`.
+  implicit val p: Parameters = new Config((site, here, up) => {
+    case TileKey => RocketTileParams(core = RocketCoreParams())
+  })
+}
+
+/** One execute controller with a real scratchpad, an accumulator capture, and a
+  * three-command stream. `kDepth` is the reduction depth the commands ask for —
+  * the DUT's `h` — and it is the same for the DUT and for every reference, which
+  * is what makes them comparable. */
+class SSExecUnit(rows: Int, cols: Int, maxSeg: Int, shapeIdx: Int,
+                 kDepth: Int, tileSlots: Seq[Int], mDepth: Int, nTotal: Int,
+                 bOff: Int = 0, rowFloor: Int = 4, accMode: Int = 0, spKBOv: Int = 0,
+                 t0Pad: Int = 0, issueOrder: Int = 0, readDelayOv: Int = 0) extends Module {
+  import ShapeshiftExecParams.p
+  import GemminiISA._
+
+  val cfg = GemminiConfigs.defaultConfig.copy(
+    meshRows = rows, meshColumns = cols, allow_nonsquare = true,
+    shapeshift_max_segments = maxSeg, shapeshift_debug = true,
+    shapeshift_row_floor = rowFloor,   // E506 의 개입 변수. 기본 4 = stock.
+    // sp_banks 는 2 의 거듭제곱이면서 maxSeg 보다 커야 한다: bank 0 = A, banks 1..maxSeg = B.
+    // maxSeg=8 이면 9 개가 필요하므로 16 으로 올린다 (E494).
+    acc_banks = maxSeg, sp_banks = if (maxSeg >= 8) 16 else 8,
+    // 4 KB: bank rows must be a multiple of DIM, so at 16x16 the 1 KB setting gives
+    // 8 rows per bank and fails the check.
+    // 용량은 뱅크 수에 비례해 키운다 — 안 그러면 뱅크당 행이 반토막 나서 S=1 의 B(64 행)가
+    // 넘치고, **모든 shape 가 같이 틀린다**. maxSeg 와 무관하게 뱅크당 행 수를 유지한다 (E494).
+    // 배열 크기에도 비례한다: B 가 쓰는 행은 nt*ch*max(h,4) 이라 rows 와 cols 양쪽으로 큰다.
+    // rows=16 에서 배수가 1 이므로 기존 측정값은 안 바뀐다 (E496).
+    // spKBOv > 0 이면 자동 산정 대신 그 값(KB). E519 의 큰 passes 칸이 자동값을 넘쳐
+    // S=1 까지 오염됐던 것의 해결 — 용량은 하네스의 것이지 RTL 제약이 아니다.
+    sp_capacity = CapacityInKilobytes(if (spKBOv > 0) spKBOv else
+      (if (maxSeg >= 8) 16 else 8) * math.max(1, rows * cols / 256)),
+    acc_capacity = CapacityInKilobytes(
+      (if (maxSeg >= 8) 32 else 16) * math.max(1, rows * cols / 256)))
+
+  val S = (1 to maxSeg).filter(rows % _ == 0)(shapeIdx)
+  val width = cols * S                    // logical columns this shape covers per pass
+  // ceil: N 이 width 의 배수가 아니면 마지막 타일이 넘치게 계산한다. 남는 열은
+  // 검사 범위 밖이고 accumulator 영역이 타일별로 분리돼 있어 해가 없다 (E479).
+  val nTiles = math.max(1, (nTotal + width - 1) / width)
+  /** K SPLITTING (E466). The array holds `h` rows of weights, so a K deeper than h
+    * must be walked in `chunks` passes that accumulate into the same C region.
+    * With this, pass count = nTiles*chunks = N*K/(rows*cols) — INDEPENDENT of the
+    * shape, which removes E465's mechanism (i) entirely.
+    *
+    * A is stored PRE-SLICED: chunk t's slice A[i][t*h .. t*h+h-1] lives in its own
+    * scratchpad row (t*M + i), lanes 0..h-1. Stock Gemmini never needs this because
+    * its chunks are whole tiles = whole rows; a folded shape needs a sub-row slice,
+    * and pre-slicing gets it without touching the hardware. A real library already
+    * tiles A, so this is a layout choice, not a new requirement. */
+  val hh = rows / S
+  val chunks = math.max(1, (kDepth + hh - 1) / hh)   // ceil: 마지막 chunk 는 부분적으로 찬다 (E478)
+  val kStride = math.max(hh, 4)           // scratchpad rows per (N tile, K chunk)
+
+  val io = IO(new Bundle {
+    val acc  = Output(Vec(maxSeg, Vec(64, Vec(cols, SInt(32.W)))))
+    val wrs  = Output(Vec(maxSeg, UInt(8.W)))    // accumulator writes seen per bank
+    val rds  = Output(Vec(8, UInt(8.W)))         // scratchpad read requests per bank
+    val rvs  = Output(Vec(8, UInt(8.W)))
+    val dbg  = Output(UInt(64.W))
+    val dbgL = Output(UInt(64.W))                // 진단: 프리로드 중 마지막 값
+    val dbg2 = Output(UInt(64.W))
+    val busy = Output(Bool())
+    val aconf = Output(Bool())        // realAcc: 공유 adder 를 두 뱅크가 같은 사이클에 요구했나 (E508)
+    val cycles = Output(UInt(16.W))   // 첫 preload 발행부터 마지막 누산기 쓰기까지
+  })
+
+  val ex = Module(new ExecuteController(64, 32, cfg)(p, implicitly[Arithmetic[chisel3.SInt]]))
+
+  // data: A is kDepth x kDepth, B tile t is kDepth x cols; everything past kDepth is 0
+  def aVal(i: Int, k: Int): Int = if (i < mDepth && k < kDepth) (i + 2 * k) % 7 - 3 else 0
+  /** logical column n of B, row k. Tile (p, s) holds columns p*width + s*cols + c. */
+  def bCol(k: Int, n: Int): Int = if (k < kDepth) (3 * k + n) % 5 - 2 else 0
+
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val TFILL = 4; val AFILL = chunks * mDepth
+  val NFILL = AFILL + nTiles * chunks * kStride
+  val filling = cyc >= TFILL.U && cyc < (TFILL + NFILL).U
+  // E526: 8비트 슬라이스가 NFILL > 256 에서 wrap 해 B 의 꼬리가 안 써지던 원인 코드.
+  // E517~E525 의 mode-1/mode-2 전부가 이것이었다. 12비트로 (NFILL 최대 ~4096 커버).
+  val fi = (cyc - TFILL.U)(11, 0)
+
+  // ---- real ScratchpadBanks: read timing is correct BY CONSTRUCTION rather than
+  // by my re-implementing it, which is how a harness ends up testing itself ----
+  val banks = Seq.fill(cfg.sp_banks)(Module(new ScratchpadBank(
+    cfg.sp_bank_entries, cfg.sp_width, cfg.aligned_to, cfg.sp_singleported, false, false)))
+  for ((bk, bi) <- banks.zipWithIndex) {
+    /** E551: SoC 의 EC 읽기 응답은 Scratchpad 모듈에서 `Pipeline(ex_read_resp,
+      * spad_read_delay=4)` 를 지난다 (Scratchpad.scala:497) — 하네스는 줄곧 뱅크
+      * 직결(지연 0)이었다. readDelayOv > 0 이면 같은 파이프를 답습해 SoC 타이밍을
+      * 재현한다. 기본 0 은 기존 셀과 바이트 동일. */
+    bk.io.read.req <> ex.io.srams.read(bi).req
+    if (readDelayOv > 0) ex.io.srams.read(bi).resp <> Pipeline(bk.io.read.resp, readDelayOv)
+    else ex.io.srams.read(bi).resp <> bk.io.read.resp
+    val isA = bi == 0
+    val holdsTile = bi >= 1 && tileSlots.contains(bi - 1)
+    val hw_en = filling && (if (isA) fi < AFILL.U else holdsTile.B && fi >= AFILL.U)
+    val hw_addr = Mux(fi < AFILL.U, fi, fi - AFILL.U)
+    // row t*M + i, lane j  ->  A[i][t*hh + j]   (chunk t 의 조각)
+    val aRow = Cat((0 until cols).reverse.map(j =>
+      MuxLookup(fi, 0.S(8.W))((0 until chunks * mDepth).map { a =>
+        val tt = a / mDepth; val i = a % mDepth
+        a.U -> (if (j < hh) aVal(i, tt * hh + j) else 0).S(8.W)
+      }).asUInt))
+    // bank 1+s, row p*kStride + k  ->  B[k][p*width + s*cols + c]
+    val sIdx = bi - 1
+    val bRow = Cat((0 until cols).reverse.map(c =>
+      MuxLookup(hw_addr, 0.S(8.W))((0 until nTiles * chunks * kStride).map { a =>
+        val blk = a / kStride; val k = a % kStride
+        val pp = blk / chunks; val tt = blk % chunks
+        a.U -> (if (holdsTile && k < hh) bCol(tt * hh + k, pp * width + sIdx * cols + c + bOff) else 0).S(8.W)
+      }).asUInt))
+    bk.io.write.en   := Mux(filling, hw_en, ex.io.srams.write(bi).en)
+    bk.io.write.addr := Mux(filling, hw_addr, ex.io.srams.write(bi).addr)
+    bk.io.write.data := Mux(filling, Mux(fi < AFILL.U, aRow, bRow), ex.io.srams.write(bi).data)
+    bk.io.write.mask := Mux(filling, VecInit(Seq.fill(bk.mask_len)(true.B)), ex.io.srams.write(bi).mask)
+  }
+
+  // ---- accumulator capture (addr/data/acc is simple enough to own; this avoids
+  // dragging in AccumulatorScale, which plays no part in what is being tested) ----
+  val ACCR = 64          // nTiles*M 이 rows 를 넘을 수 있다 (E465, E470 에서 64 로)
+  val accMem = Reg(Vec(maxSeg, Vec(ACCR, Vec(cols, SInt(32.W)))))
+  val wrs = RegInit(VecInit(Seq.fill(maxSeg)(0.U(8.W))))
+  private def accAddr(i: Int) = ex.io.acc.write(i).bits.addr(
+    math.min(log2Up(ACCR), ex.io.acc.write(i).bits.addr.getWidth) - 1, 0)
+
+  val accConflict = RegInit(false.B)   // realAcc 에서만 오를 수 있다
+  if (accMode == 0) {
+    // 지연 0 의 레지스터 파일. 빠르고 읽기 프로토콜이 필요 없지만, 진짜 AccumulatorMem 의
+    // `pipelined_writes` 가 없으므로 **누산기 WAW 해저드를 구조적으로 못 본다** (E506).
+    for (i <- 0 until cfg.acc_banks) {
+      ex.io.acc.read_req(i).ready := true.B
+      ex.io.acc.read_resp(i).valid := false.B
+      ex.io.acc.read_resp(i).bits := DontCare
+      ex.io.acc.write(i).ready := true.B
+      when (ex.io.acc.write(i).fire) {
+        wrs(i) := wrs(i) + 1.U
+        // 뱅크 수가 늘면 뱅크당 행이 줄어 addr 폭도 준다 (maxSeg=8 이면 5 비트).
+        // ACCR 로 고정 슬라이스하면 폭을 넘는다 — 실제 폭과 min 을 취한다 (E494).
+        val ad = accAddr(i)
+        for (c <- 0 until cols) {
+          val nw = ex.io.acc.write(i).bits.data(c)(0)
+          accMem(i)(ad)(c) := Mux(ex.io.acc.write(i).bits.acc, accMem(i)(ad)(c) + nw, nw)
+        }
+      }
+    }
+  } else {
+    // 진짜 `AccumulatorMem` 을 물린다 (E507). 쓰기 파이프라인과 RMW adder 경로가 그대로
+    // 들어오므로 바닥 4 가 막는 해저드가 모형 안에 실재하게 된다. adder 는 모듈 밖에
+    // 있으므로 (Scratchpad.scala:637 과 같은 패턴) 여기서 더해 준다.
+    val accRowT = Vec(cols, Vec(1, cfg.accType))
+    val banks = Seq.fill(cfg.acc_banks) { Module(new AccumulatorMem(
+      cfg.acc_bank_entries, accRowT, cfg.acc_scale_func,
+      cfg.acc_scale_t.asInstanceOf[Float], cfg.acc_singleported, cfg.acc_sub_banks,
+      false, cfg.acc_latency, cfg.accType, false)) }
+    // accMode=1: stock Scratchpad 재현 — **뱅크 전체가 AccPipeShared 하나를 공유**하고
+    //            `Mux1H(in_sel)` 로 고른다 (Scratchpad.scala:634,654-657). 접힌 shape 는
+    //            여러 뱅크에 같은 사이클에 accumulate 를 넣으므로 여기서 깨진다 (E508).
+    // accMode=2: 수정 — 뱅크마다 자기 adder 파이프. Scratchpad 의 guarded 수정과 같은 구조.
+    val accAddersShared = if (accMode == 1) Some(Module(new AccPipeShared(cfg.acc_latency - 1, accRowT, cfg.acc_banks))) else None
+    for (i <- 0 until cfg.acc_banks) {
+      val b = banks(i)
+      b.io.write <> ex.io.acc.write(i)
+      if (accMode == 1) {
+        accAddersShared.get.io.in_sel(i) := b.io.adder.valid
+        accAddersShared.get.io.ina(i) := b.io.adder.op1
+        accAddersShared.get.io.inb(i) := b.io.adder.op2
+        b.io.adder.sum := accAddersShared.get.io.out
+      } else {
+        val own = Module(new AccPipeShared(cfg.acc_latency - 1, accRowT, 1))
+        own.io.in_sel(0) := b.io.adder.valid
+        own.io.ina(0) := b.io.adder.op1
+        own.io.inb(0) := b.io.adder.op2
+        b.io.adder.sum := own.io.out
+      }
+      ex.io.acc.read_resp(i).valid := false.B
+      ex.io.acc.read_resp(i).bits := DontCare
+      when (ex.io.acc.write(i).fire) { wrs(i) := wrs(i) + 1.U }
+    }
+    /** 진단: 한 사이클에 두 뱅크 이상이 adder 를 요구하면 `Mux1H` 가 깨진다.
+      * 접힌 shape 는 세그먼트마다 뱅크가 다르므로 chunk>1 일 때 동시에 요구할 수 있다. */
+    when (PopCount(VecInit(banks.map(_.io.adder.valid))) > 1.U) { accConflict := true.B }
+    for (i <- 0 until cfg.acc_banks) {
+      ex.io.acc.read_req(i).ready := false.B
+    }
+
+    // ---- readback: 검사 코드가 `accMem` 을 읽으므로, 진짜 뱅크에서 읽어 채워 준다.
+    // 뱅크마다 포트가 따로라 전부 동시에, 한 사이클에 한 행씩. 응답은 순서대로 오므로
+    // 카운터 하나로 잡는다. matmul 이 끝난 뒤(TRB)부터 시작한다.
+    val nBack = math.min(nTiles * mDepth, ACCR)
+    val TRB = 380
+    val rbIssue = RegInit(0.U(log2Up(ACCR + 1).W))
+    val rbGot   = RegInit(0.U(log2Up(ACCR + 1).W))
+    val rbOn = cyc >= TRB.U && rbIssue < nBack.U
+    for (i <- 0 until cfg.acc_banks) {
+      val b = banks(i)
+      b.io.read.req.valid := rbOn
+      b.io.read.req.bits := DontCare
+      b.io.read.req.bits.addr := rbIssue
+      b.io.read.req.bits.full := true.B      // 원값 (스케일 경로를 타지 않는다)
+      b.io.read.req.bits.act := 0.U
+      b.io.read.req.bits.fromDMA := false.B
+      b.io.read.resp.ready := true.B
+      when (b.io.read.resp.fire && i.U === 0.U) { }
+      when (b.io.read.resp.valid) {
+        for (c <- 0 until cols) { accMem(i)(rbGot)(c) := b.io.read.resp.bits.data(c)(0) }
+      }
+    }
+    when (rbOn && banks(0).io.read.req.ready) { rbIssue := rbIssue + 1.U }
+    when (banks(0).io.read.resp.valid) { rbGot := rbGot + 1.U }
+  }
+  ex.io.im2col.req.ready := true.B
+  ex.io.im2col.resp.valid := false.B
+  ex.io.im2col.resp.bits := DontCare
+  ex.io.counter := DontCare
+
+  // ---- commands: config_ex -> preload -> compute_preloaded ----
+  def addr(bank: Int, row: Int): BigInt = BigInt(bank) * cfg.sp_bank_entries + row
+  def rc(r: Int, c: Int, a: BigInt): BigInt = (BigInt(r) << 48) | (BigInt(c) << 32) | a
+  val T0 = TFILL + NFILL + 4 + t0Pad   // t0Pad: E525 의 절대 시각 절단용
+  // config_ex, then (preload, compute) once per N tile. Every shape solves the SAME
+  // (M, K, N); a narrow shape simply needs more passes to cover N.
+  //   rs1: cmd_type=CONFIG_EX(0)[1:0], dataflow=WS(1)[2], shape[12:10], a_stride[31:16]
+  //   rs2: c_stride[15:0].  BOTH STRIDES MUST BE 1 (E448).
+  val issue: Seq[(UInt, BigInt, BigInt)] =
+    // rs2 의 c_stride 는 [63:48] 이다. `ConfigExRs2` 의 필드는 MSB 부터 선언되므로
+    // (c_stride, relu6_shift, in_shift) 가 각각 [63:48], [47:32], [31:0] 이다.
+    // E448 에서 이것을 [15:0] 에 넣어 c_stride 가 0 이었고, 그 결과 한 pass 의 출력 M 행이
+    // 전부 같은 주소를 덮어써서 마지막 행 C[M-1] 만 남았다 (E463/E464).
+    Seq((CONFIG_CMD, (BigInt(1) << 2) | (BigInt(shapeIdx) << ShapeshiftISA.SHAPE_LO)
+         | (BigInt(1) << 16),
+                     BigInt(1) << 48)) ++
+    {
+      /** issueOrder 0 = tile-major (stock: pp 바깥, tt 안쪽), 1 = chunk-major (tt 바깥).
+        * chunk-major 는 같은 누산기 행의 재방문 간격을 tr 에서 nt*tr 로 벌린다 — 바닥 2 의
+        * WAW 유량 한계(E527: 도착 2 < 서비스 3, 큐 무한 적체)를 스케줄만으로 피하는 수. */
+      val order = if (issueOrder == 1)
+        for (tt <- 0 until chunks; pp <- 0 until nTiles) yield (pp, tt)
+      else
+        for (pp <- 0 until nTiles; tt <- 0 until chunks) yield (pp, tt)
+      order.flatMap { case (pp, tt) => Seq(
+        // D: hh rows of this chunk.  C: same region every chunk, accumulate when t > 0
+        //    (LocalAddr 의 accumulate 는 is_acc_addr 바로 아래 비트 = [30])
+        (PRELOAD_CMD, rc(hh, cols, addr(1, (pp * chunks + tt) * kStride)),
+                      rc(mDepth, cols, (BigInt(1) << 31) | (if (tt > 0) BigInt(1) << 30 else 0) | BigInt(pp * mDepth))),
+        (COMPUTE_AND_FLIP_CMD, rc(mDepth, hh, addr(0, tt * mDepth)), BigInt("ffffffff", 16))) }
+    }
+
+  // E526 의 fi 와 같은 부류의 폭 함정을 예방: 8 -> 12비트 (issue 수 최대 ~2000 커버)
+  val ci = RegInit(0.U(12.W))
+  ex.io.cmd.valid := cyc >= T0.U && ci < issue.size.U
+  ex.io.cmd.bits := DontCare
+  ex.io.cmd.bits.cmd.inst.funct := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((f, _, _), k) => k.U -> f })
+  ex.io.cmd.bits.cmd.rs1 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_, a, _), k) => k.U -> a.U(64.W) })
+  ex.io.cmd.bits.cmd.rs2 := MuxLookup(ci, 0.U)(issue.zipWithIndex.map { case ((_, _, b), k) => k.U -> b.U(64.W) })
+  ex.io.cmd.bits.rob_id.valid := false.B
+  ex.io.cmd.bits.rob_id.bits := 0.U
+  ex.io.cmd.bits.from_matmul_fsm := false.B
+  ex.io.cmd.bits.from_conv_fsm := false.B
+  when (ex.io.cmd.fire) { ci := ci + 1.U }
+
+  val rds = RegInit(VecInit(Seq.fill(8)(0.U(8.W))))
+  val rvs = RegInit(VecInit(Seq.fill(8)(0.U(8.W))))   // req.valid, 별개로
+  // 진단 카운터는 뱅크 8 개까지만 센다 (io.rds/rvs 의 폭이 8x4bit). maxSeg=8 이면
+  // sp_banks 가 16 이라 B 는 뱅크 1..8 에 있고 뱅크 8 은 안 세어진다 — 진단의 사각지대이지
+  // 정확성 검사(golden 대조)는 영향 없다. (E494)
+  for (i <- 0 until math.min(cfg.sp_banks, 8)) {
+    when (ex.io.srams.read(i).req.fire)  { rds(i) := rds(i) + 1.U }
+    when (ex.io.srams.read(i).req.valid) { rvs(i) := rvs(i) + 1.U }
+  }
+  io.rds := rds
+  io.rvs := rvs
+  io.dbg := ex.io.ss_dbg.get
+  val dbgL = RegInit(0.U(64.W))
+  dbgL := ex.io.ss_dbg.get
+  io.dbgL := dbgL
+  io.dbg2 := ex.io.ss_dbg2.get
+  // cycles: from the first work-bearing command (the preload, ci == 1) to the last
+  // accumulator write. config_ex is excluded because it is not part of the matmul.
+  val t0 = RegInit(0.U(16.W)); val t1 = RegInit(0.U(16.W))
+  when (ex.io.cmd.fire && ci === 1.U) { t0 := cyc }
+  when ((0 until cfg.acc_banks).map(i => ex.io.acc.write(i).fire).reduce(_ || _)) { t1 := cyc }
+  io.cycles := t1 - t0
+
+  io.acc := accMem; io.wrs := wrs; io.busy := ex.io.busy; io.aconf := accConflict
+}
+
+/** One folded execute controller against `S` shape-0 references. */
+class ShapeshiftExecSeg(shapeIdx: Int, rows: Int = 8, cols: Int = 8, maxSeg: Int = 4,
+                        sabMode: Int = 0, M: Int = 4, K: Int = 4, N: Int = 64,
+                        accMode: Int = 0, rowFloor: Int = 4, issueOrder: Int = 0) extends Module {
+  val segs: Seq[Int] = (1 to maxSeg).filter(rows % _ == 0)
+  val S = segs(shapeIdx); val h = rows / S
+
+  val io = IO(new Bundle {
+    val mismatch = Output(Bool())
+    val checked  = Output(UInt(16.W))
+    val nonzero  = Output(Bool())
+    val wrDut    = Output(UInt(32.W))
+    val wrRef    = Output(UInt(32.W))
+    // 참조 자체가 h-깊이 곱을 계산하고 있는지: 이것이 틀리면 DUT가 아니라 참조가 문제다
+    val perSegBad = Output(UInt(8.W))   // 진단: 세그먼트별 불일치
+    val perSegNz  = Output(UInt(8.W))   // 진단: 세그먼트별 참조 non-zero
+    val perSegNzD = Output(UInt(8.W))   // 진단: 세그먼트별 DUT non-zero
+    val rdDut     = Output(UInt(48.W))  // 진단: DUT 뱅크별 스크래치패드 읽기 횟수
+    val dbgOut    = Output(UInt(64.W))
+    val rvDut     = Output(UInt(48.W))
+    val dbgRef    = Output(UInt(64.W))
+    val cyc       = Output(UInt(16.W))
+    val dbg2Dut   = Output(UInt(64.W))
+    val dbg2Ref   = Output(UInt(64.W))
+  })
+
+  // `sabotage` runs the DUT unfolded while the references stay segmented, which
+  // must FAIL for S > 1 and legitimately passes at S = 1.
+  // THE REFERENCE IS THE SAME FOLDED RUN WITH ONLY ONE TILE POPULATED.
+  //
+  // E448 tried a hand-written golden and E449's first attempt tried a shape-0 run
+  // masked down to K = h; both failed, and the second failed for a reason worth
+  // keeping: the masked shape-0 run does not compute the h-deep product either, so
+  // it was never a valid reference. Rather than keep guessing at the ISA's exact
+  // semantics, this checks a property that needs no golden at all:
+  //
+  //     segment s's output must not depend on the other segments' tiles.
+  //
+  // It catches MISROUTING as well as cross-talk: if segment s read the wrong bank,
+  // the isolated run would hand it zeros while the full run hands it another tile,
+  // so the two disagree. Together with E444 — which already proves a folded mesh
+  // computes S correct independent matmuls — independence plus routing is exactly
+  // what the execute controller adds.
+  // Two negative controls, because "it passed" means nothing until the checker has
+  // been shown able to fail:
+  //   1 = run the DUT UNFOLDED while the references stay folded -> segments 1..S-1
+  //       never get written, so they must disagree (and S = 1 legitimately passes)
+  //   2 = put each reference's tile in the WRONG BANK -> segment s reads zeros in
+  //       the reference and a real tile in the DUT, which is precisely the
+  //       misrouting this test claims to detect
+  // THE SAME PROBLEM FOR EVERY SHAPE (E460). M, K and N are all fixed; a narrow
+  // shape covers N in more passes. This is what makes a head-to-head cycle
+  // comparison meaningful — E455/E456 still had K or N moving with the shape.
+  val nTiles = math.max(1, (N + cols * S - 1) / (cols * S))
+  // accMode 는 dut 에만 — refs 는 사이클 측정에 무관하고 시뮬 무게만 는다 (E509)
+  val dut = Module(new SSExecUnit(rows, cols, maxSeg, if (sabMode == 1) 0 else shapeIdx, K, 0 until S, M, N,
+    0, rowFloor, accMode, 0, 0, issueOrder))
+  val refs = (0 until S).map(s => Module(new SSExecUnit(rows, cols, maxSeg, shapeIdx, K,
+    Seq(if (sabMode == 2) (s + 1) % S else s), M, N)))
+
+  val cyc = RegInit(0.U(16.W)); cyc := cyc + 1.U
+  val bad = RegInit(false.B); val cnt = RegInit(0.U(16.W)); val nz = RegInit(false.B)
+  val TCHK = 500
+  when (cyc === TCHK.U) {
+    cnt := (S * nTiles * M * cols).U
+    for (s <- 0 until S; i <- 0 until nTiles * M; c <- 0 until cols) {
+      when (dut.io.acc(s)(i)(c) =/= refs(s).io.acc(s)(i)(c)) { bad := true.B }
+      when (refs(s).io.acc(s)(i)(c) =/= 0.S) { nz := true.B }
+    }
+  }
+  val segBad = RegInit(VecInit(Seq.fill(maxSeg)(false.B)))
+  val segNz  = RegInit(VecInit(Seq.fill(maxSeg)(false.B)))
+  val segNzD = RegInit(VecInit(Seq.fill(maxSeg)(false.B)))
+  when (cyc === TCHK.U) {
+    for (s <- 0 until S; i <- 0 until nTiles * M; c <- 0 until cols) {
+      when (dut.io.acc(s)(i)(c) =/= refs(s).io.acc(s)(i)(c)) { segBad(s) := true.B }
+      when (refs(s).io.acc(s)(i)(c) =/= 0.S) { segNz(s) := true.B }
+      when (dut.io.acc(s)(i)(c) =/= 0.S) { segNzD(s) := true.B }
+    }
+  }
+  io.perSegBad := Cat(segBad.reverse); io.perSegNz := Cat(segNz.reverse)
+  io.perSegNzD := Cat(segNzD.reverse)
+  io.mismatch := bad; io.checked := cnt; io.nonzero := nz
+  io.wrDut := Cat(dut.io.wrs.reverse.take(4))
+  io.wrRef := Cat(refs.last.io.wrs.reverse.take(4))
+  io.rdDut := Cat((0 until 6).reverse.map(i => dut.io.rds(i)))
+  io.rvDut := Cat((0 until 6).reverse.map(i => dut.io.rvs(i)))
+  io.dbgOut := dut.io.dbgL
+  io.cyc := dut.io.cycles
+  io.dbg2Dut := dut.io.dbg2
+  io.dbg2Ref := refs.head.io.dbg2
+  io.dbgRef := refs.head.io.dbgL   // 타일 0 만 채운 실행: 그 데이터가 어느 세그먼트 레인에 실리나
+}
+
+class ShapeshiftExecTop(rows: Int = 8, cols: Int = 8, maxSeg: Int = 4,
+                        sabMode: Int = 0, M: Int = 4, K: Int = 4, N: Int = 64, accMode: Int = 0, rowFloor: Int = 4, issueOrder: Int = 0) extends Module {
+  val n = (1 to maxSeg).filter(rows % _ == 0).size
+  val io = IO(new Bundle {
+    val mismatch = Output(UInt(n.W)); val nonzero = Output(UInt(n.W))
+    // shape 당 16 비트씩 Cat 한다. 48 로 고정하면 shape 가 넷일 때(maxSeg=8) 잘려서
+    // 첫 shape 만 맞고 나머지가 쓰레기로 나온다 — 정확성은 통과하는데 사이클만 틀린다 (E494).
+    val checked  = Output(UInt((n * 16).W)); val wr = Output(UInt(64.W))
+    val pb = Output(UInt(24.W)); val pn = Output(UInt(24.W)); val pd = Output(UInt(24.W))
+    val rd = Output(UInt(48.W)); val dbg = Output(UInt(64.W)); val rv = Output(UInt(48.W)); val dbgR = Output(UInt(64.W)); val d2 = Output(UInt(64.W)); val d2r = Output(UInt(64.W)); val cycles = Output(UInt((n * 16).W))
+  })
+  val d = (0 until n).map(i => Module(new ShapeshiftExecSeg(i, rows, cols, maxSeg, sabMode, M, K, N, accMode, rowFloor, issueOrder)))
+  io.mismatch := Cat(d.map(_.io.mismatch).reverse)
+  io.nonzero  := Cat(d.map(_.io.nonzero).reverse)
+  io.checked  := Cat(d.map(_.io.checked).reverse)
+  io.wr := Cat(d.last.io.wrDut, d.last.io.wrRef)
+  io.pb := Cat(d.map(_.io.perSegBad).reverse)
+  io.pn := Cat(d.map(_.io.perSegNz).reverse)
+  io.pd := Cat(d.map(_.io.perSegNzD).reverse)
+  io.rd := d.last.io.rdDut
+  io.dbg := d.last.io.dbgOut
+  io.rv := d.last.io.rvDut
+  io.dbgR := d.last.io.dbgRef
+  io.cycles := Cat(d.map(_.io.cyc).reverse)
+  io.d2 := d.last.io.dbg2Dut
+  io.d2r := d.last.io.dbg2Ref
+}
